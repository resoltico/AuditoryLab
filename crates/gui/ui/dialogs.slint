import { DateInput } from "models.slint";
import { ControlOption } from "models.slint";
import { ViewCaptions } from "view-captions.slint";
import { Actions } from "actions.slint";
import { Button } from "button.slint";
import { Terms } from "vocabulary.slint";
import {
    Palette,
    ComboBox,
    TextEdit,
    LineEdit,
    VerticalBox,
    HorizontalBox,
    ScrollView,
} from "std-widgets.slint";
import { Section } from "editor.slint";

export component Dialogs inherits Rectangle {
    in-out property <string> added-from;
    in-out property <string> added-through;
    in-out property <int> analysis-choice;
    in property <[string]> analysis-labels;
    in-out property <int> band-choice;
    in property <string> calendar-context;
    in property <bool> can-import;
    in property <bool> can-manage-library;
    callback clear-library-filters();
    in-out property <int> collection-choice;
    callback collection-filter(int, int);
    in-out property <bool> compact;
    in-out property <string> created-from;
    in-out property <string> created-through;
    in-out property <int> direction-choice;
    in property <[string]> direction-labels;
    in-out property <int> group-choice;
    in property <[string]> group-labels;
    in property <string> library-alert;
    in property <string> library-count;
    in-out property <int> method-choice;
    in property <[string]> method-labels;
    in-out property <string> modified-from;
    in-out property <string> modified-through;
    callback more-filters(string, int, int, int, int, int, DateInput, DateInput, DateInput);
    in-out property <int> population-choice;
    in property <[string]> population-labels;
    in-out property <string> query;
    callback rhythm-filter(int, int);
    in-out property <int> role-choice;
    in property <[string]> role-labels;
    in-out property <string> study-query;
    in property <length> ui-size;
    in property <length> window-width;
    in property <length> window-height;
    in property <length> toolbar-height;
    out property <bool> library-tools-open: filters-popup.is-open;
    out property <bool> library-query-open: query-popup.is-open;
    public function open-query-details() { query-popup.show(); }
    public function close-query-details() { query-popup.close(); }
    public function open-library-filters() { filters-popup.show(); }
    public function close-library-filters() { filters-popup.close(); }

    public function clear-applied-filters() {
        root.clear-library-filters();
    }
    function apply-filters() {
        root.more-filters(root.study-query, root.population-choice,
            root.role-choice, root.analysis-choice, root.direction-choice, root.group-choice,
            { from-text: root.created-from, through-text: root.created-through },
            { from-text: root.modified-from, through-text: root.modified-through },
            { from-text: root.added-from, through-text: root.added-through });
    }
    query-popup := PopupWindow {
        x: max(8px,root.window-width - self.width - 12px);
        y: root.toolbar-height + 8px;
        width: min(520px,root.window-width - 24px);
        height: min(480px,root.window-height - root.toolbar-height - 24px);
        close-policy: close-on-click-outside;
        forward-focus: query-focus;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
        }

        query-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    query-popup.close();
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Text {
                        text: ViewCaptions.applied-library-filters;
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: Terms.action-close;
                        triggered => { query-popup.close(); }
                    }
                }

                TextEdit {
                    text: root.library-count;
                    read-only: true;
                    wrap: word-wrap;
                    min-width: 0px;
                    accessible-label: ViewCaptions.committed-library-query;
                }
            }
        }
    }

    filters-popup := PopupWindow {
        x: max(8px,root.window-width - self.width - 12px);
        y: root.toolbar-height + 8px;
        width: min(500px,root.window-width - 24px);
        height: min(620px,root.window-height - root.toolbar-height - 24px);
        close-policy: close-on-click-outside;
        forward-focus: filter-focus;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
        }

        filter-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    filters-popup.close();
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Text {
                        text: Terms.caption-library-filters;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: Terms.action-close;
                        accessible-label: Terms.action-close-filters;
                        triggered => { filters-popup.close(); }
                    }
                }

                filter-scroll := ScrollView {
                    accessible-role: groupbox;
                    accessible-label: Terms.caption-library-filters;
                    VerticalBox {
                        width: filter-scroll.visible-width;
                        Text {
                            text: Terms.caption-find-by-purpose;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                        }

                        if root.compact: Text {
                            text: ViewCaptions.structural-method;
                            vertical-stretch: 0;
                        }
                        if root.compact: ComboBox {
                            model: root.method-labels;
                            current-index <=> root.method-choice;
                            accessible-label: ViewCaptions.structural-method;
                            selected(value) => {
                                root.rhythm-filter(root.band-choice,
                                root.method-choice);
                            }
                        }

                        LineEdit {
                            text <=> root.study-query;
                            placeholder-text: ViewCaptions.study-doi-or-key-source;
                            accessible-label: ViewCaptions.study-evidence-filter;
                        }

                        ComboBox {
                            model: root.population-labels;
                            current-index <=> root.population-choice;
                            accessible-label: ViewCaptions.population-evidence-filter;
                        }

                        ComboBox {
                            model: root.role-labels;
                            current-index <=> root.role-choice;
                            accessible-label: ViewCaptions.condition-role-evidence-filter;
                        }

                        ComboBox {
                            model: root.analysis-labels;
                            current-index <=> root.analysis-choice;
                            accessible-label: ViewCaptions.nominal-analysis-coverage;
                        }

                        ComboBox {
                            model: root.direction-labels;
                            current-index <=> root.direction-choice;
                            accessible-label: ViewCaptions.sort-direction;
                        }

                        ComboBox {
                            model: root.group-labels;
                            current-index <=> root.group-choice;
                            accessible-label: ViewCaptions.library-result-grouping;
                        }

                        Text {
                            text: root.calendar-context;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                        }

                        LineEdit {
                            text <=> root.created-from;
                            placeholder-text: ViewCaptions.created-from-yyyy-mm-dd;
                            accessible-label: ViewCaptions.created-from-local-calendar-date;
                        }

                        LineEdit {
                            text <=> root.created-through;
                            placeholder-text: ViewCaptions.created-through-yyyy-mm-dd;
                            accessible-label: ViewCaptions.created-through-date;
                        }

                        LineEdit {
                            text <=> root.modified-from;
                            placeholder-text: ViewCaptions.modified-from-yyyy-mm-dd;
                            accessible-label: ViewCaptions.modified-from-local-calendar-date;
                        }

                        LineEdit {
                            text <=> root.modified-through;
                            placeholder-text: ViewCaptions.modified-through-yyyy-mm-dd;
                            accessible-label: ViewCaptions.modified-through-date;
                        }

                        LineEdit {
                            text <=> root.added-from;
                            placeholder-text: ViewCaptions.added-here-from-yyyy-mm-dd;
                            accessible-label: ViewCaptions.added-from-date;
                        }

                        LineEdit {
                            text <=> root.added-through;
                            placeholder-text: ViewCaptions.added-here-through-yyyy-mm-dd;
                            accessible-label: ViewCaptions.added-through-date;
                        }

                        if root.library-alert != "": Text {
                            text: root.library-alert;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                            accessible-live-region: polite;
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Button {
                        text: Terms.action-clear-all-filters;
                        triggered => { root.clear-applied-filters(); }
                    }

                    Button {
                        text: Terms.action-apply-filters;
                        primary: true;
                        triggered => { root.apply-filters(); }
                    }
                }
            }
        }
    }
}
