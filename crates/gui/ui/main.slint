import {
    Palette, AboutSlint, Button, ComboBox, TextEdit, LineEdit, Slider, VerticalBox, HorizontalBox, CheckBox, StandardListView, ScrollView, TabWidget, ProgressIndicator
}
from "std-widgets.slint";
export struct ModelRow { label: string, trace: string }
export struct Row {
    id: string,

    ears: int,
    source: int,
    modulation: int,
    error: string,
    heading: string,
    context: string,
    text0: string,
    pos0: float,
    text1: string,
    pos1: float,
    text2: string,
    pos2: float,
    text3: string,
    pos3: float,
    text4: string,
    pos4: float,
    text5: string,
    pos5: float,
    text6: string,
    pos6: float,
    text7: string,
    staged0:bool,
    staged1:bool,
    staged2:bool,
    staged3:bool,
    staged4:bool,
    staged5:bool,
    staged6:bool,
    staged7:bool,

    pos7: float,
}
// Keep uncommitted text and focus local; model refreshes only replace unfocused text.
component NumericField inherits LineEdit {
    in property <string> display-text;
    in property <bool> edits-suspended:false;
    in property <bool> staged:false;
    private property <bool> dirty: false;
    in property <int> reset-key;
    changed reset-key => {
        self.text = root.display-text;
        root.dirty = root.staged;
    }
    changed staged => {root.dirty=root.staged;}
    callback stage(string);
    callback commit(string);
    callback restore()->string;
    init => {self.text=root.display-text;root.dirty=root.staged;}
    changed display-text => {
        if !self.has-focus {
            self.text = root.display-text;
            root.dirty=root.staged;
        }
    }
    edited(value) => {
        root.dirty = true;
        root.stage(value);
    }
    key-pressed(event) => {
        if event.text == Key.Escape {
            self.text=root.restore();
            root.dirty=false;
            return accept;
        }
        return reject;
    }
    accepted(value) => {
        root.dirty = false;
        root.commit(value);
    }
    changed has-focus => {
        if !self.has-focus && root.dirty && !root.edits-suspended {
            root.dirty = false;
            root.commit(self.text);
        }
    }
}
component NumericControl inherits HorizontalBox {
    in property <string> context;
    in property <bool> compact:false;
    in property <length> ui-size:13px;
    padding: 0px;
    in property <string> label;
    in property <string> display-text;
    in property <bool> edits-suspended:false;
    in property <bool> staged:false;
    in property <float> position;
    in property <string> diagnostic;
    in property <bool> edit-enabled: true;
    callback stage(string);
    callback commit(string);
    callback restore()->string;
    callback slide(float);
    vertical-stretch: 0;
    Text {
        text: root.label;
        min-width:root.ui-size*(root.compact ? 4 : 12.5);
        max-width:root.ui-size*(root.compact ? 7 : 16);
        wrap: word-wrap;
    }
    if !root.compact: Slider {
        enabled: root.edit-enabled;
        minimum: 0;
        maximum: 1;
        step: 0.001;
        value: root.position;
        accessible-label: root.context+": "+root.label + " slider";
        changed(value) => {
            root.slide(value);
        }
    }
    NumericField {
        enabled: root.edit-enabled;
        display-text: root.display-text;
        edits-suspended:root.edits-suspended;
        staged:root.staged;
        restore=>{return root.restore();}
        preferred-width:root.ui-size*(root.compact ? 7 : 12);
        max-width:root.ui-size*(root.compact ? 7 : 12);
        horizontal-stretch: 0;
        accessible-label: root.context+": "+root.label;
        accessible-description: root.diagnostic;
        stage(value) => {
            root.stage(value);
        }
        commit(value) => {
            root.commit(value);
        }
    }
}
component ExportRate inherits HorizontalBox {
    padding: 0px;
    vertical-stretch: 0;
    in-out property <int> selected;
    in property <[string]> choices;
    in property <bool> edit-enabled;
    callback changed(int);
    Text {
        text:"Export sample rate";
    }
    ComboBox {
        model:root.choices;
        current-index <=> root.selected;
        enabled:root.edit-enabled;
        selected(v)=> {
            root.changed(self.current-index);
        }
    }
}
export component AboutWindow inherits Window {
    title: "About Auditory Lab";
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 560px;
    preferred-height: 560px;
    min-width:360px;min-height:360px;
    in property <string> identity;
    callback open-source();
    callback dismiss();
    callback focus-close();
    focus-close => {close.focus();}
    forward-focus: about-focus;
    about-focus := FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape {root.dismiss();return accept;}return reject;}
        VerticalBox {
            ScrollView {min-height:0px;
                VerticalBox {
                    Text {text:"Auditory Lab";font-size:root.ui-size*1.85;vertical-stretch:0;}
                    TextEdit {text:root.identity;read-only:true;min-height:root.ui-size*12;preferred-height:root.ui-size*14;accessible-label:"Version and licenses";}
                    Button {text:"Source and issue tracker";vertical-stretch:0;clicked=>{root.open-source();}}
                    AboutSlint {min-height:root.ui-size*7;max-height:root.ui-size*10;}
                }
            }
            close := Button {text:"Close";vertical-stretch:0;clicked=>{root.dismiss();}}
        }
    }
}

component Lane inherits Rectangle {
    in property <string> label;
    in property <string> trace;
    in property <string> limit: "1";
    in property <length> ui-size:13px;
    background: #131d2b;
    height: root.ui-size*5.2;
    accessible-role: image;
    accessible-label: root.label + " samples, common symmetric scale ±" + root.limit;
    Text {
        x: 6px;
        y: 0px;
        text: root.label;
        color: #e1eaf6;
        font-size: root.ui-size*0.93;
    }
    Text {
        x: 6px;
        y: root.ui-size*1.3;
        text: "+"+root.limit;
        color: #c6d0df;
        font-size: root.ui-size*0.85;
    }
    Text {
        x: 6px;
        y:root.ui-size*2.5;
        text: "0";
        color: #c6d0df;
        font-size: root.ui-size*0.85;
    }
    Text {
        x: 6px;
        y:root.ui-size*3.8;
        text: "−"+root.limit;
        color: #c6d0df;
        font-size: root.ui-size*0.85;
    }
    Rectangle {
        x: 42px;
        y: root.ui-size*1.3;
        width: parent.width - 50px;
        height:root.ui-size*3.2;
        clip: true;
        Rectangle {
            y: parent.height / 2;
            height: 1px;
            width: parent.width;
            background: #43536b;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1024;
            viewbox-height: 100;
            fit: fill;
            commands: root.trace;
            stroke: #77d4ef;
            stroke-width: 1px;
        }
    }
}
export component MainWindow inherits Window {
    title: "Auditory Lab";
    in-out property <bool> edits-suspended:false;
    callback restore(string,int)->string;
    callback restore-metadata(string)->string;
    in-out property <bool> show-visualization:true;
    in property <bool> native-mac: false;
    in property <string> draft-brief;
    in property <bool> title-staged;
    in property <bool> summary-staged;
    in property <bool> duration-staged;
    in property <bool> fade-staged;

    in property <string> waveform-caption;
    in property <string> scale-label: "1";
    in property <string> model-caption;
    in property <[ModelRow]> model-rows;
    in property <string> monitor-warning;
    in property <string> typography-origin;
    in-out property <int> view-index: 0;
    in-out property <int> scale-index: 0;
    in-out property <bool> show-audio-details: false;
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 1100px;
    preferred-height: 900px;
    min-width: 680px;
    min-height: 700px;
    in property <[StandardListViewItem]> catalog;
    in-out property <int> selected: 0;
    in property <[Row]> rows;
    in property <string> sound-title;
    in property <string> studied;
    in property <bool> can-open-study;
    callback open-study();
    in property <string> recipe-timing;
    in property <[string]> export-rates;
    in property <string> summary;
    in property <string> structure;
    in property <string> details;
    in property <string> guidance;
    in property <string> status;
    in property <string> operation-reason;
    in property <bool> busy;
    in property <bool> live;
    in property <bool> playback-busy;
    in property <bool> can-cancel;
    in property <string> operation-control;
    in property <bool> can-edit;
    in property <bool> can-export;
    in property <bool> can-play;
    in property <bool> can-save;
    in property <bool> dirty;
    in property <string> based-on;
    in property <string> based-on-title;
    in property <string> retained-warning;
    in property <string> player-title;
    in property <string> player-state;
    in property <string> generated;
    in property <string> generated-details;
    in property <string> monitor-state;
    in property <string> meters;
    in property <string> device;
    in property <string> cycle-hint;
    in property <bool> retained-session;

    in property <string> elapsed;
    in property <float> progress;
    in property <string> left-path;
    in property <string> right-path;
    in property <int> draft-reset;
    in-out property <length> editor-scroll-y;
    in property <string> draft-title;
    in property <string> draft-summary;
    in property <string> duration;
    in property <string> fade;
    in property <string> metadata-error;
    in property <string> peak;
    in-out property <int> tab-index: 0;
    in-out property <int> window-index: 2;
    in-out property <int> rate-index: 1;
    in-out property <bool> research: false;
    in-out property <bool> frozen: false;
    in-out property <bool> notes: false;
    in-out property <bool> saved-audio: false;
    in-out property <bool> show-errors: false;
    in-out property <bool> show-generators: false;
    in-out property <bool> library-detail: false;
    in-out property <bool> export-settings: false;
    in-out property <length> sidebar-width: 330px;
    public function resize-library-pane(pixels:float) {
        root.sidebar-width=max(230px,min(500px,pixels*1px));
    }
    in-out property <string> query;
    in property <bool> has-results;
    in-out property <bool> compact: false;
    changed ui-size => {root.compact = root.width < root.ui-size*70;}
    changed width => {
        root.compact = self.width < root.ui-size*70;
    }
    callback select(int);
    callback search(string);
    callback open-recipe();
    callback play-stop();
    callback stop-audio();
    callback play-recipe();
    callback preview-selected();
    callback export-wav();
    callback about();
    callback based-on-source();
    callback quit();
    callback rate-changed(int);
    callback window-changed();
    callback tab-changed(int);
    callback open-workbench();
    callback new-draft();
    callback add-component(int);
    callback remove-component(string);
    callback choice(string, int, int);
    callback edit(string, int, string);
    callback slide(string, int, float);
    callback metadata(string, string);
    callback stage-metadata(string, string);
    callback stage(string, int, string);
    callback save-recipe();
    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New Sound";
                activated => {
                    root.new-draft();
                }
            }
            MenuItem {
                title: "Open Recipe…";
                enabled: !root.busy;
                activated => {
                    root.open-recipe();
                }
            }
            MenuItem {
                title: "Save Recipe…";
                enabled: !root.busy && root.can-save && root.tab-index == 1;
                activated => {
                    root.save-recipe();
                }
            }
            MenuItem {
                title: "Export WAV…";
                enabled: !root.busy && root.can-export;
                activated => {
                    root.export-wav();
                }
            }
            MenuItem {title:"Stop audio";enabled:root.playback-busy;activated=>{root.stop-audio();}}
            MenuItem {
                title: "Quit";
                activated => {
                    root.quit();
                }
            }
        }
        if !root.native-mac: Menu {
            title: "Help";
            MenuItem {
                title: "About Auditory Lab";

                activated => {
                    root.about();
                }
            }
        }
    }
    VerticalBox {
        spacing: 6px;
        TabWidget {
            min-height:0px;
            current-index <=> root.tab-index;
            changed current-index => {
                root.tab-changed(self.current-index);
            }
            Tab {
                title: "Library";
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 1;
                    if !root.compact || !root.library-detail: VerticalBox {
                        preferred-width: !root.compact ? root.sidebar-width : 600px;
                        max-width: !root.compact ? root.sidebar-width : 3000px;
                        Text {
                            text: "Find a recipe";
                            vertical-stretch: 0;
                        }
                        LineEdit {
                            text <=> root.query;
                            placeholder-text: "Title, ID, sound or study topic";
                            accessible-label: "Find a recipe";
                            edited(value) => {
                                root.search(value);
                            }
                        }
                        if !root.has-results: Text {
                            text: "No matching recipes";
                        }
                        if root.query != "": Button {
                            text: "Clear search";
                            clicked => {
                                root.query="";
                                root.search("");
                            }
                        }
                        catalog-scroll := ScrollView {
                            VerticalBox {
                                spacing: 4px;
                                for item[index] in root.catalog: Rectangle {
                                    property <bool> selected-row: root.selected==index;
                                    function reveal() {
                                        if self.selected-row {
                                            if self.y + catalog-scroll.content-y < 0px {catalog-scroll.content-y=-self.y;}
                                            else if self.y+self.height+catalog-scroll.content-y > catalog-scroll.visible-height {catalog-scroll.content-y=catalog-scroll.visible-height - self.y - self.height;}
                                        }
                                    }
                                    changed selected-row => {self.reveal();}
                                    changed y => {self.reveal();}
                                    changed height => {self.reveal();}

                                    height: max(root.ui-size*4.5, label.preferred-height + 16px);
                                    background: root.selected == index ? Palette.selection-background : Palette.control-background;
                                    border-width: focus.has-focus ? 2px : 0px;
                                    border-color: root.selected == index ? Palette.accent-background : Palette.border;
                                    accessible-role: button;
                                    accessible-label: item.text;
                                    accessible-action-default => {
                                        touch.clicked();
                                    }
                                    label := Text {
                                        x: 10px;
                                        y: 10px;
                                        width: parent.width - 20px;
                                        text: item.text;
                                        wrap: word-wrap;
                                        color: root.selected == index ? Palette.selection-foreground : Palette.control-foreground;
                                    }
                                    touch := TouchArea {
                                        clicked => {
                                            focus.focus();
                                            root.select(index);
                                            root.library-detail=true;
                                        }
                                    }
                                    focus := FocusScope {
                                        key-pressed(event) => {
                                            if event.text == "\n" || event.text == " " {
                                                root.select(index);
                                                root.library-detail=true;
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }
                            }
                        }
                        Button {
                            text: "Open Recipe…";
                            enabled: !root.busy;
                            clicked => {
                                root.open-recipe();
                            }
                        }
                    }
                    if !root.compact: Rectangle {
                        width: 6px;
                        background: resize-touch.has-hover || resize-focus.has-focus ? Palette.accent-background : Palette.border;
                        accessible-role: slider;
                        accessible-label: "Library pane width";
                        accessible-value: root.sidebar-width / 1px;
                        accessible-value-minimum: 230;
                        accessible-value-maximum: 500;
                        accessible-value-step: 16;
                        accessible-action-set-value(v) => {
                            if v.is-float() {
                                root.resize-library-pane(v.to-float());
                            }
                        }
                        accessible-action-increment => {
                            root.resize-library-pane(root.sidebar-width/1px + 16);
                        }
                        accessible-action-decrement => {
                            root.resize-library-pane(root.sidebar-width/1px - 16);
                        }
                        forward-focus: resize-focus;
                        resize-touch := TouchArea {
                            mouse-cursor:col-resize;
                            clicked=> {
                                resize-focus.focus();
                            }
                            moved=> {
                                if self.pressed {
                                    root.resize-library-pane((root.sidebar-width + self.mouse-x - self.pressed-x)/1px);
                                }
                            }
                        }
                        resize-focus := FocusScope {
                            key-pressed(event)=> {
                                if event.text==Key.LeftArrow {
                                    root.resize-library-pane(root.sidebar-width/1px - 16);
                                    return accept;
                                }
                                if event.text==Key.RightArrow {
                                    root.resize-library-pane(root.sidebar-width/1px + 16);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                    if !root.compact || root.library-detail: ScrollView {
                        VerticalBox {
                            spacing: 10px;
                            if root.compact: Button {
                                text:"Back to recipes";
                                clicked => {
                                    root.library-detail=false;
                                }
                            }
                            if root.has-results: VerticalBox {
                                vertical-stretch: 0;
                                Text {
                                    text:root.sound-title;
                                    font-size:root.ui-size*1.85;
                                    font-weight:600;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }

                                Text {
                                    text:root.structure;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                Text {text:root.studied;wrap:word-wrap;vertical-stretch:0;}
                                Text {
                                    text:root.recipe-timing;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                Text {
                                    text:root.summary;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    vertical-stretch: 0;
                                    Button {
                                        text:root.playback-busy ? "Stop current & play recipe" : "Listen";
                                        enabled:root.can-play && (!root.busy || root.playback-busy);
                                        clicked=> {
                                            root.play-recipe();
                                        }
                                    }
                                    Button {
                                        text:"Edit a copy";
                                        enabled:!root.busy;
                                        clicked=> {
                                            root.open-workbench();
                                        }
                                    }
                                    Button {
                                        text:"Export WAV…";
                                        enabled:!root.busy && root.can-export;
                                        clicked=> {
                                            root.export-wav();
                                        }
                                    }
                                }
                                CheckBox {
                                    text:"Research, citation and recipe adaptations";
                                    checked <=> root.research;
                                }
                                if root.research && root.can-open-study: Button {text:"Open study source";clicked=>{root.open-study();}}
                                if root.research: TextEdit {
                                    text:root.details;
                                    read-only:true;
                                    min-height:240px;
                                    accessible-label:"Selectable research, citation and adaptations";
                                }
                                CheckBox {
                                    text:"Export settings";
                                    checked <=> root.export-settings;
                                }
                                if root.export-settings: ExportRate {
                                    choices:root.export-rates;
                                    selected <=> root.rate-index;
                                    edit-enabled:!root.busy;
                                    changed(i)=> {
                                        root.rate-changed(i);
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch:1;
                            }
                        }
                    }
                }
            }
            Tab {
                title:"Workbench";
                VerticalBox {
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        Text {
                            text:"Sound";
                        }
                        NumericField {
                            reset-key:root.draft-reset;
                            enabled:root.can-edit;
                            display-text:root.draft-title;
                            staged:root.title-staged;
                            edits-suspended:root.edits-suspended;
                            restore=>{return root.restore-metadata("title");}
                            accessible-label:"Sound title";
                            stage(v)=> {
                                root.stage-metadata("title",v);
                            }
                            commit(v)=> {
                                root.metadata("title",v);
                            }
                        }
                    }
                    HorizontalBox {vertical-stretch:0;
                        Text {
                            text:root.dirty ? "Unsaved changes" : "Unmodified draft";
                            wrap:word-wrap;max-width:root.compact ? root.ui-size*6 : 300px;
                        }
                        Button {
                            text:"New";
                            enabled:root.can-edit;
                            clicked=> {
                                root.new-draft();
                            }
                        }
Button {
                            text:root.compact ? "Save…" : "Save Recipe…";
                            enabled:!root.busy && root.can-save;
                            clicked=> {
                                root.save-recipe();
                            }
                        }

                    }
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;



                        Button {
                            text:"Add Tone";
                            enabled:root.can-edit && root.rows.length<16;
                            clicked=> {
                                root.add-component(0);
                            }
                        }
                        Button {
                            text:"Add Clicks";
                            enabled:root.can-edit && root.rows.length<16;
                            clicked=> {
                                root.add-component(1);
                            }
                        }
                    }
                    if root.retained-warning != "": Text {
                        text:root.retained-warning;
                        color:Palette.foreground;
                        font-weight:700;
                        wrap:word-wrap;
                        vertical-stretch:0;
                        accessible-label:root.retained-warning;
                        accessible-live-region:polite;
                    }
                    ScrollView {
                        content-y <=> root.editor-scroll-y;
                        VerticalBox {
                    Text {text:root.draft-brief; font-size:root.ui-size*1.5; font-weight:600; wrap:word-wrap; vertical-stretch:0;}
                    if root.based-on-title != "": Text {
                        text:root.based-on-title;
                        wrap:word-wrap;
                        font-size:root.ui-size*0.93;
                        vertical-stretch:0;
                    }
                            for row in root.rows: VerticalBox {
                                spacing: 4px;
                                Rectangle {
                                    height:1px;
                                    background:Palette.border;
                                }
                                vertical-stretch: 0;
                                HorizontalBox {
                                    padding: 0px;
                                    vertical-stretch: 0;
                                    Text {
                                        text: row.heading + " · Component " + row.id;
                                        font-weight: 700;
                                    }
                                }
                                Text {text:row.context; wrap:word-wrap; vertical-stretch:0;}
                                component-options := CheckBox {text:"Routing, modulation and component options";}
                                if component-options.checked: VerticalBox {
                                    padding: 0px;
                                    vertical-stretch: 0;
                                    Text {
                                        text: "Ears";
                                    }
                                    ComboBox {
                                        enabled: root.can-edit;
                                        model: ["Both ears", "Left", "Right"];
                                        current-index: row.ears;
                                        accessible-label: "ears";
                                        selected(value) => {
                                            root.choice(row.id, 0, self.current-index);
                                        }
                                    }
                                    Text {
                                        text: "Source";
                                    }
                                    ComboBox {
                                        enabled: root.can-edit;
                                        model: ["Tone", "Clicks"];
                                        current-index: row.source;
                                        accessible-label: "source";
                                        selected(value) => {
                                            root.choice(row.id, 1, self.current-index);
                                        }
                                    }
                                    Text {
                                        text: "Modulation";
                                    }
                                    ComboBox {
                                        enabled: root.can-edit;
                                        model: ["None", "Sinusoidal", "Gate"];
                                        current-index: row.modulation;
                                        accessible-label: "modulation";
                                        selected(value) => {
                                            root.choice(row.id, 2, self.current-index);
                                        }
                                    }
                                    Button {
                                        text: "Remove";
                                        enabled: root.can-edit;
                                        accessible-label: "Remove component " + row.id;
                                        clicked => {
                                            root.remove-component(row.id);
                                        }
                                    }
                                }
                                if row.source == 0: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Tone frequency (Hz)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text0;
                                    staged:row.staged0;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos0;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,0);}
                                    stage(value) => {
                                        root.stage(row.id, 0, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 0, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 0, value);
                                    }
                                }
                                if row.source == 1: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Click rate (Hz)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text1;
                                    staged:row.staged1;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos1;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,1);}
                                    stage(value) => {
                                        root.stage(row.id, 1, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 1, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 1, value);
                                    }
                                }
                                if row.source == 1: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Click width (ms)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text2;
                                    staged:row.staged2;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos2;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,2);}
                                    stage(value) => {
                                        root.stage(row.id, 2, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 2, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 2, value);
                                    }
                                }
                                NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Peak level (dBFS)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text3;
                                    staged:row.staged3;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos3;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,3);}
                                    stage(value) => {
                                        root.stage(row.id, 3, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 3, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 3, value);
                                    }
                                }
                                if row.modulation == 1: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Modulation rate (Hz)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text4;
                                    staged:row.staged4;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos4;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,4);}
                                    stage(value) => {
                                        root.stage(row.id, 4, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 4, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 4, value);
                                    }
                                }
                                if row.modulation == 1: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Depth (%)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text5;
                                    staged:row.staged5;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos5;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,5);}
                                    stage(value) => {
                                        root.stage(row.id, 5, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 5, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 5, value);
                                    }
                                }
                                if row.modulation == 2: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Gate rate (Hz)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text6;
                                    staged:row.staged6;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos6;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,6);}
                                    stage(value) => {
                                        root.stage(row.id, 6, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 6, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 6, value);
                                    }
                                }
                                if row.modulation == 2: NumericControl {
                                    compact:root.compact;
                                    ui-size:root.ui-size;
                                    label: "Gate width (ms)";
                                    edit-enabled: root.can-edit;
                                    diagnostic: row.error;
                                    display-text: row.text7;
                                    staged:row.staged7;
                                    context:row.heading+" · Component "+row.id;
                                    position: row.pos7;
                                    edits-suspended:root.edits-suspended;
                                    restore=>{return root.restore(row.id,7);}
                                    stage(value) => {
                                        root.stage(row.id, 7, value);
                                    }
                                    commit(value) => {
                                        root.edit(row.id, 7, value);
                                    }
                                    slide(value) => {
                                        root.slide(row.id, 7, value);
                                    }
                                }
                                if row.error != "": Text {
                                    text: row.error;
                                    color: Palette.foreground;
                                    accessible-live-region: polite;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                            }
                            Text {
                                text:root.peak;
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            settings := CheckBox {text:"Recipe settings · notes and saved/exported audio";}
                            if settings.checked: VerticalBox {
                        Button {
                            text:"Export WAV…";
                            enabled:!root.busy && root.can-export;
                            clicked=> {
                                root.export-wav();
                            }
                        }
                            CheckBox {
                                text:"Recipe notes";
                                checked <=> root.notes;
                            }
                            if root.notes: VerticalBox {
                                if root.based-on != "": Text {
                                    text:root.based-on;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                if root.based-on != "": Button {
                                    text:"Show source recipe in Library";
                                    clicked=> {
                                        root.based-on-source();
                                    }
                                }
                                Text {
                                    text:"Your notes about this sound";
                                    vertical-stretch:0;
                                }
                                NumericField {
                                    reset-key:root.draft-reset;
                                    enabled:root.can-edit;
                                    display-text:root.draft-summary;
                            staged:root.summary-staged;
                            edits-suspended:root.edits-suspended;
                            restore=>{return root.restore-metadata("summary");}
                                    accessible-label:"Custom recipe notes";
                                    stage(v)=> {
                                        root.stage-metadata("summary",v);
                                    }
                                    commit(v)=> {
                                        root.metadata("summary",v);
                                    }
                                }
                            }
                            CheckBox {
                                text:"Saved audio · duration, fades and export rate";
                                checked <=> root.saved-audio;
                            }
                            if root.saved-audio: VerticalBox {
                                Text {
                                    text:"Live playback continues until Stop. These settings affect saved recipes and WAV export.";
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    vertical-stretch: 0;
                                    Text {
                                        text:"Duration (s)";
                                    }
                                    NumericField {
                                        reset-key:root.draft-reset;
                                        enabled:root.can-edit;
                                        display-text:root.duration;
                            staged:root.duration-staged;
                            edits-suspended:root.edits-suspended;
                            restore=>{return root.restore-metadata("duration");}
                                        accessible-label:"Saved duration seconds";
                                        stage(v)=> {
                                            root.stage-metadata("duration",v);
                                        }
                                        commit(v)=> {
                                            root.metadata("duration",v);
                                        }
                                    }
                                    Text {
                                        text:"Fade (s)";
                                    }
                                    NumericField {
                                        reset-key:root.draft-reset;
                                        enabled:root.can-edit;
                                        display-text:root.fade;
                            staged:root.fade-staged;
                            edits-suspended:root.edits-suspended;
                            restore=>{return root.restore-metadata("fade");}
                                        accessible-label:"Saved fade seconds";
                                        stage(v)=> {
                                            root.stage-metadata("fade",v);
                                        }
                                        commit(v)=> {
                                            root.metadata("fade",v);
                                        }
                                    }
                                }
                                ExportRate {
                                    choices:root.export-rates;
                                    selected <=> root.rate-index;
                                    edit-enabled:!root.busy;
                                    changed(i)=> {
                                        root.rate-changed(i);
                                    }
                                }
                                if root.metadata-error != "": Text {
                                    text:root.metadata-error;
                                    color:Palette.foreground;
                                    accessible-live-region:polite;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                            }
                            }
                            Rectangle {
                                vertical-stretch:1;
                            }
                        }
                    }
                }
            }

        }
        if root.operation-reason != "": Text {
            text:root.operation-reason;
            wrap:word-wrap;
            vertical-stretch:0;
        }
        if root.monitor-warning!="": Text {text:root.monitor-warning;wrap:word-wrap;vertical-stretch:0;accessible-live-region:polite;}
        HorizontalBox {
            padding: 0px;
            vertical-stretch: 0;
            Button {
                text:root.operation-control;primary:true;vertical-stretch:0;max-height:root.ui-size*3;
                enabled:root.can-cancel;
                accessible-label:root.operation-control;
                clicked=> {
                    root.play-stop();
                }
            }
            Text {
                text:root.player-title;
                wrap:word-wrap;max-height:root.ui-size*3;overflow:elide;
                horizontal-stretch:1;
            }
            Text {
                text:root.elapsed;
            }
            if root.retained-session && !root.busy: Button {
                text:"Preview selected sound";
                clicked=> {
                    root.preview-selected();
                }
            }
        }
        if root.generated != "": Text {
            text:root.generated;
            wrap:word-wrap;max-height:root.ui-size*3;overflow:elide;
            vertical-stretch:0;
        }
        CheckBox {text:"Visualization and audio details";checked <=> root.show-visualization;}
        if root.show-visualization: ScrollView {
            min-height:0px;preferred-height:root.compact ? 180px : 270px;max-height:root.compact ? 220px : 380px;
            VerticalBox {
        HorizontalBox {vertical-stretch:0;
            Button {vertical-stretch:0;max-height:root.ui-size*2.5;text:"Timing model";primary:root.view-index==0;clicked=>{root.view-index=0;root.window-changed();}}
            Button {vertical-stretch:0;max-height:root.ui-size*2.5;text:"Audio waveform";primary:root.view-index==1;clicked=>{root.view-index=1;root.window-changed();}}
        }
        if root.view-index==1: HorizontalBox {vertical-stretch:0;
            Button {text:"Fixed ±1";primary:root.scale-index==0;enabled:!root.frozen;clicked=>{root.scale-index=0;root.window-changed();}}
            Button {text:"Fit signal";primary:root.scale-index==1;enabled:!root.frozen;clicked=>{root.scale-index=1;root.window-changed();}}
            Button {text:root.frozen ? "Resume waveform" : "Freeze waveform";clicked=>{root.frozen=!root.frozen;root.window-changed();}}
        }
        if root.view-index==1: HorizontalBox {vertical-stretch:0;
            Button {text:"2 ms";enabled:!root.frozen;clicked=>{root.window-index=0;root.window-changed();}}
            Button {text:"10 ms";enabled:!root.frozen;clicked=>{root.window-index=1;root.window-changed();}}
            Button {text:"40 ms";enabled:!root.frozen;clicked=>{root.window-index=2;root.window-changed();}}
            Button {text:"100 ms";enabled:!root.frozen;clicked=>{root.window-index=3;root.window-changed();}}
        }
        if root.view-index==0: VerticalBox {
            vertical-stretch:0;
            Text {text:root.model-caption;wrap:word-wrap;}
            ScrollView {min-height:90px;max-height:140px;
                VerticalBox {for lane in root.model-rows: HorizontalBox {
                    vertical-stretch:0;
                    Text {text:lane.label;max-width:240px;wrap:word-wrap;}
                    Rectangle {min-width:150px;horizontal-stretch:1;height:24px;background:Palette.control-background;
                        accessible-role:image;accessible-label:lane.label+" model occupancy/envelope";
                        Path {width:parent.width;height:parent.height;viewbox-width:1024;viewbox-height:100;fit:fill;commands:lane.trace;stroke:Palette.accent-background;stroke-width:2px;}
                    }
                }}
            }
        }
        if root.view-index==1: VerticalBox {
            vertical-stretch:0;
            Text {text:root.waveform-caption;wrap:word-wrap;}
            Lane {label:"Left";trace:root.left-path;limit:root.scale-label;ui-size:root.ui-size;}
            Lane {label:"Right";trace:root.right-path;limit:root.scale-label;ui-size:root.ui-size;}
            Text {text:root.meters;wrap:word-wrap;}
        }
        CheckBox {text:"Audio details and diagnostics";checked <=> root.show-audio-details;}
        if root.show-audio-details: TextEdit {
            text:root.generated-details+"\n"+root.monitor-state+"\n"+root.device+"\nTypography: "+root.typography-origin;
            read-only:true;min-height:100px;max-height:140px;
            accessible-label:"Generated components, exact capture provenance, output device and monitoring diagnostics";
        }
            }
        }
        if root.busy && root.can-cancel && !root.playback-busy: ProgressIndicator {
            progress:root.progress;
            accessible-label:"Operation progress";
        }
        if root.status != "": CheckBox {
            text:"Operation details";
            checked <=> root.show-errors;
        }
        if root.status != "": Text {
            min-width:0px;
            accessible-live-region:polite;
            text:root.status;
            wrap:word-wrap;
            max-height:root.ui-size*3;
            vertical-stretch:0;
        }
        if root.show-errors && root.status != "": TextEdit {
            text:root.status;
            read-only:true;
            min-height:80px;
            max-height:120px;
            accessible-label:"Full selectable operation errors and paths";
        }
        Text {
            text:root.guidance;
            wrap:word-wrap;
            vertical-stretch:0;
        }
    }
}
