import { BoundButton, BoundTitleEdit } from "library-controls.slint";
export { Terms } from "vocabulary.slint";
import { Terms } from "vocabulary.slint";
import {
    Palette, Button, ComboBox, TextEdit, LineEdit, Slider, VerticalBox, HorizontalBox, CheckBox, StandardListView, ScrollView, TabWidget, ProgressIndicator
}
from "std-widgets.slint";
export { CatalogRow, ParameterKey, MetadataKey, ParameterRow, ComponentRow, MetadataRow, ModelLane } from "models.slint";
import { CatalogRow, ParameterKey, MetadataKey, ParameterRow, ComponentRow, MetadataRow, ModelLane } from "models.slint";
import { Disclosure, NumericField, ParameterControl, MetadataField, NotesField, StableButton, ExportRate } from "editor.slint";
export { AboutWindow, LicenseWindow } from "about.slint";

export { MonitorWindow, DetailsWindow, AudioControlsWindow, MonitorData } from "monitor.slint";
import { Lane, MonitorPanel, MonitorData } from "monitor.slint";

export component MainWindow inherits Window {
    icon: @image-url("../../../artwork/auditorylab-icon/assets/runtime/window-icon.png");
    title: Terms.caption-product-name;
    in-out property <bool> edits-suspended:false;
    in-out property <bool> monitor-open:true;
    in property <bool> native-mac: false;
    in property <string> draft-brief;
    in property <string> draft-location;
    in property <string> draft-location-details;
    // The open document's binding; field callbacks carry the binding they rendered with.
    in property <int> document;
    in property <int> document-reset;
    in property <MetadataRow> title-field;
    in property <MetadataRow> summary-field;
    in property <MetadataRow> duration-field;
    in property <MetadataRow> fade-field;
    in property <[ComponentRow]> components;
    in property <[ModelLane]> model-lanes;
    in property <[string]> ears-choices;
    in property <[string]> carrier-choices;
    in property <[string]> add-choices;
    in property <[string]> modulation-choices;
    in property <[string]> span-choices;
    in property <[string]> scale-choices;
    callback stage-parameter(int, ParameterKey, string);
    callback commit-parameter(int, ParameterKey, string);
    callback restore-parameter(int, ParameterKey);
    callback slide(int, ParameterKey, float);
    callback stage-metadata(int, MetadataKey, string);
    callback commit-metadata(int, MetadataKey, string);
    callback restore-metadata(int, MetadataKey);
    callback set-ears(int, int);
    callback set-carrier(int, int);
    callback set-modulation(int, int);
    callback remove-component(int);
    callback restore-component(int);
    callback add-component(int, int);

    in property <string> output-state;
    in property <string> receipt-age;
    in property <string> capture-duration;
    in property <string> motion-reason;
    in property <bool> motion-overridden;
    in-out property <length> monitor-height:270px;
    // TabWidget does not expose its tab-strip metrics. Reserve three text rows,
    // the outer layout's padding and 280px of document space beside measured chrome.
    property <length> available-monitor-height:0px;
    property <length> minimum-monitor-height: max(240px, drawer-content.preferred-height);
    property <length> maximum-monitor-height: min(360px, root.available-monitor-height);
    out property <bool> drawer-fits: root.minimum-monitor-height <= root.maximum-monitor-height && drawer-content.min-width <= root.width - workspace-layout.padding-left - workspace-layout.padding-right;
    out property <length> effective-drawer-height: max(root.minimum-monitor-height, min(root.monitor-height, root.maximum-monitor-height));
    function update-monitor-layout(){
        // Snapshot viewport space on layout changes to avoid feeding the window's
        // inferred minimum height back into its own layout constraint binding.
        root.available-monitor-height=max(0px, root.height - toolbar.preferred-height - transport.preferred-height - root.ui-size*3 - 16px - 280px);
        root.window-changed();
    }
    changed drawer-fits=>{root.update-monitor-layout();}
    changed height=>{root.update-monitor-layout();}
    changed monitor-height=>{root.update-monitor-layout();}
    public function resize-monitor(pixels:float){root.monitor-height=max(240px,min(360px,pixels*1px));}
    public function focus-monitor-opener(){monitor-opener.focus-button();}
    out property <MonitorData> monitor-data:{state:root.output-state,age:root.receipt-age,caption:root.waveform-caption,meters:root.meters,warning:root.monitor-warning,warninglive:root.monitor-warning-live,backendwarning:root.backend-warning,motion:root.motion-reason,left:root.left-path,right:root.right-path,limit:root.scale-label,spanlabel:root.capture-duration,spanchoice:root.window-index,scalechoice:root.scale-index,held:root.held,overridden:root.motion-overridden};
    callback show-diagnostics();
    callback show-research();
    callback hold-changed();
    callback follow-motion();
    in property <string> waveform-caption;
    in property <string> scale-label: "1";
    in property <string> model-caption;
    in property <string> monitor-warning;
    in property <bool> monitor-warning-live;
    in property <string> backend-warning;
    in property <string> typography-origin;
    in-out property <int> scale-index;
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 1100px;
    preferred-height: 900px;
    min-width: 680px;
    min-height: 600px;
    in property <[CatalogRow]> catalog;
    in-out property <int> selected: 0;
    in property <string> sound-title;
    in property <string> studied;
    in property <bool> can-open-study;
    callback open-study();
    in property <string> recipe-timing;
    in property <[string]> export-rates;
    in property <string> summary;
    in property <string> structure;
    in property <string> details;
    in property <string> guidance;
    in property <string> status;
    in property <string> operation-summary;
    in property <string> operation-outcome;
    in property <string> auxiliary-error;
    in property <string> copy-reason;
    in property <string> file-activity;
    in property <bool> exporting;
    callback cancel-file();
    in property <bool> playback-busy;
    in property <bool> transport-enabled;
    in property <string> transport-action;
    in property <[string]> transport-labels;
    in property <bool> can-edit;
    in property <bool> can-add-component;
    in property <bool> can-add-pair;
    in property <string> pair-add-reason;
    in property <string> add-reason;
    in property <string> removed-component;
    in property <bool> can-restore-component;
    in property <bool> can-export;
    in property <bool> can-play;
    in property <string> library-play-action;
    in property <[string]> library-play-labels;
    in property <bool> can-import;
    in property <bool> can-new;
    in property <bool> can-copy;
    in property <bool> can-preview;
    in property <bool> can-save;
    in property <bool> dirty;
    in property <string> based-on;
    in property <string> based-on-title;
    in property <string> retained-warning;
    in property <string> player-title;
    in property <string> play-target;
    in property <string> generated;
    in property <string> generated-details;
    in property <string> monitor-state;
    in property <string> meters;
    in property <string> device;

    in property <string> elapsed;
    in property <float> progress;
    in property <string> left-path;
    in property <string> right-path;
    in-out property <length> editor-scroll-y;
    in property <string> metadata-error;
    in property <string> save-reason;
    in property <string> export-reason;
    in property <string> play-reason;
    in property <string> peak;
    in-out property <int> tab-index: 0;
    in-out property <int> window-index;
    in-out property <int> rate-index: 1;
    in-out property <bool> research: false;
    in-out property <bool> held: false;
    in-out property <bool> notes: false;
    in-out property <bool> saved-audio: false;
    in-out property <bool> library-detail: false;
    in-out property <length> library-scroll-y: 0px;
    private property <bool> library-restoring: false;
    private property <bool> library-restore-ready: false;
    in-out property <bool> export-settings: false;
    in-out property <length> sidebar-width: 330px;
    public function resize-library-pane(pixels:float) {
        root.sidebar-width=max(230px,min(500px,pixels*1px));
    }
    in-out property <string> query;
    in property <bool> has-results;
    in-out property <bool> compact: false;
    changed ui-size => {root.compact = root.width < root.ui-size*70;root.update-monitor-layout();}
    changed width => {
        root.compact = self.width < root.ui-size*70;
        root.update-monitor-layout();
    }
    callback select(string);
    callback navigate-library(int);
    in-out property <string> focused-library-key;
    in property <string> library-key;
    in property <string> library-token;
    in property <bool> library-trashed;
    in property <string> library-status;
    in property <string> library-alert;
    in-out property <bool> storage-open:false;
    callback collection-filter(int, int);
    in property <string> library-count;
    in property <string> calendar-context;
    in property <[string]> band-labels;
    in property <[string]> method-labels;
    callback more-filters(string, int, int, int, int, int, string, string, string, string, string, string);
    callback clear-library-filters();
    callback reset-library-sort();
    function clear-applied-filters() {
        root.clear-library-filters();
        root.query="";root.band-choice=0;root.method-choice=0;
        root.study-query="";root.population-choice=0;root.role-choice=0;root.analysis-choice=0;
        root.created-from="";root.created-through="";root.modified-from="";root.modified-through="";root.added-from="";root.added-through="";
    }
    in-out property <string> study-query;
    in-out property <int> population-choice:0;
    in-out property <int> role-choice:0;
    in-out property <int> analysis-choice:0;
    in-out property <int> direction-choice:0;
    in-out property <int> group-choice:0;
    in-out property <string> created-from;
    in-out property <string> created-through;
    in-out property <string> modified-from;
    in-out property <string> modified-through;
    in-out property <string> added-from;
    in-out property <string> added-through;
    function apply-filters() { root.more-filters(root.study-query,root.population-choice,root.role-choice,root.analysis-choice,root.direction-choice,root.group-choice,root.created-from,root.created-through,root.modified-from,root.modified-through,root.added-from,root.added-through); }

    in-out property <int> collection-choice: 0;
    in-out property <int> sort-choice: 0;
    callback refresh-library();
    callback initialize-library();
    callback edit-saved(string, string);
    callback save-copy();
    in property <string> library-dates;
    in property <string> library-dates-utc;
    callback add-to-library(string);
    callback recheck-library();
    callback show-saved();
    callback library-action(string, string, string, string);
    callback search(string);
    callback rhythm-filter(int, int);
    in-out property <int> band-choice: 0;
    in-out property <int> method-choice: 0;
    callback open-recipe();
    callback play-stop();
    callback stop-audio();
    callback play-recipe();
    callback preview-selected();
    callback export-wav();
    callback export-recipe();
    callback close-open-file(string);
    callback about();
    callback based-on-source();
    callback quit();
    callback rate-changed(int);
    callback window-changed();
    callback tab-changed(int);
    callback open-workbench();
    callback new-draft();
    callback save-recipe();
    MenuBar {
        Menu {
            title: Terms.caption-file;
            MenuItem {
                title: Terms.action-new-sound;
                enabled: root.can-new;
                activated => {
                    root.new-draft();
                }
            }
            MenuItem {
                title: Terms.action-open-recipe-dialog;
                enabled: root.can-import;
                activated => {
                    root.open-recipe();
                }
            }
            MenuItem {
                title: Terms.action-save-sound-dialog;
                enabled: root.can-save && root.tab-index == 1;
                activated => {
                    root.save-recipe();
                }
            }
            MenuItem {title:Terms.action-save-independent-copy;enabled:root.can-edit && root.tab-index==1;activated=>{root.save-copy();}}
            MenuItem {title:Terms.action-export-portable-recipe-dialog;enabled:root.tab-index==0 ? root.has-results : root.can-save;activated=>{root.export-recipe();}}
            MenuItem {
                title: Terms.action-export-wav-dialog;
                enabled: root.can-export;
                activated => {
                    root.export-wav();
                }
            }
            MenuItem {title:Terms.action-stop-audio;enabled:root.playback-busy;activated=>{root.stop-audio();}}
            MenuItem {
                title: Terms.action-quit;
                activated => {
                    root.quit();
                }
            }
        }
        if !root.native-mac: Menu {
            title: Terms.caption-help;
            MenuItem {
                title: Terms.caption-about-product;

                activated => {
                    root.about();
                }
            }
        }
    }
    workspace-layout := VerticalBox {
        spacing: 0px;
        toolbar := HorizontalBox {
            changed preferred-height=>{root.update-monitor-layout();}
            vertical-stretch:0;
            min-height:root.ui-size*3;
            padding:4px;
            if !root.compact: Text {text:Terms.caption-product-name;font-weight:600;vertical-alignment:center;}
            Rectangle {horizontal-stretch:1;}
            // Left of the lasting controls, so a late press on Cancel export
            // lands in the space it leaves rather than on another control.
            if root.exporting: ProgressIndicator {progress:root.progress;accessible-label:Terms.caption-wav-export-progress;max-width:120px;}
            if root.exporting: Button {text:Terms.action-cancel-export;clicked=>{root.cancel-file();}}
            if root.status != "" || root.auxiliary-error != "": Button {text:Terms.caption-task-details-dialog;clicked=>{root.show-diagnostics();}}
            if root.tab-index==1: Button {text:Terms.action-save-sound;enabled:root.can-save;accessible-description:root.save-reason;clicked=>{root.save-recipe();}}
            monitor-opener := StableButton {
                text:root.monitor-open ? Terms.action-hide-monitor : Terms.action-show-monitor;
                labels:[Terms.action-hide-monitor,Terms.action-show-monitor];
                accessible-name:(root.monitor-open ? Terms.action-hide-output-monitor : Terms.action-show-output-monitor);expanded:root.monitor-open;
                clicked=>{root.monitor-open=!root.monitor-open;root.window-changed();}
            }
        }
        TabWidget {
            min-height:0px;
            current-index <=> root.tab-index;
            changed current-index => {
                root.tab-changed(self.current-index);
            }
            Tab {
                title: Terms.collection-library;
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 1;
                    if !root.compact || !root.library-detail: VerticalBox {
                        preferred-width: !root.compact ? root.sidebar-width : 600px;
                        max-width: !root.compact ? root.sidebar-width : 3000px;
                        ComboBox {
                            model: [Terms.collection-all-built-in-user, Terms.collection-built-in-read-only, Terms.collection-user, Terms.collection-open-files-temporary, Terms.collection-trash];
                            current-index <=> root.collection-choice;
                            accessible-label: Terms.caption-library-collection;
                            selected(value) => { root.collection-filter(root.collection-choice, root.sort-choice); }
                        }
                        ComboBox {
                            model: [Terms.caption-automatic-order, Terms.caption-nominal-rate, Terms.caption-title, Terms.caption-created, Terms.caption-modified, Terms.facet-added-here, Terms.caption-study, Terms.caption-collection];
                            current-index <=> root.sort-choice;
                            accessible-label: Terms.facet-sort-library;
                            selected(value) => { root.collection-filter(root.collection-choice, root.sort-choice); }
                        }
                        LineEdit {
                            text <=> root.query;
                            placeholder-text: Terms.caption-title-id-sound-or-study-topic;
                            accessible-label: Terms.caption-find-arecipe;
                            edited(value) => {
                                root.search(value);
                            }
                        }
                        ComboBox {
                            model: root.band-labels;
                            current-index <=> root.band-choice;
                            accessible-label: Terms.caption-nominal-rhythm-reference-band;
                            selected(value) => { root.rhythm-filter(root.band-choice, root.method-choice); }
                        }
                        ComboBox {
                            model: root.method-labels;
                            current-index <=> root.method-choice;
                            accessible-label: Terms.caption-structural-method;
                            selected(value) => { root.rhythm-filter(root.band-choice, root.method-choice); }
                        }
                        if root.band-choice != 0 || root.method-choice != 0: Button {
                            text: Terms.action-clear-rhythm-filters;
                            clicked => {
                                root.band-choice = 0;
                                root.method-choice = 0;
                                root.rhythm-filter(0, 0);
                            }
                        }
                        if !root.has-results: Text {
                            text: Terms.status-empty-library;
                            wrap:word-wrap;
                        }
                        if root.query != "": Button {
                            text: Terms.action-clear-search;
                            clicked => {
                                root.query="";
                                root.search("");
                            }
                        }
                        if root.compact: HorizontalBox {
                            vertical-stretch:0;
                            Button {text:Terms.facet-filters-recovery-dialog;clicked=>{root.library-detail=true;}}
                            Button {text:Terms.action-refresh;clicked=>{root.refresh-library();}}
                            Button {text:Terms.action-clear-all-filters;clicked=>{root.clear-applied-filters();}}
                        }
                        catalog-scroll := ScrollView {
                            content-y: root.library-scroll-y;
                            changed content-y => {if !root.library-restoring {root.library-scroll-y=self.content-y;}}
                            accessible-role:list;
                            accessible-label:Terms.caption-library-results;
                            VerticalBox {
                                spacing: 4px;
                                if root.compact: Text {text:root.library-count;wrap:word-wrap;min-width:0px;vertical-stretch:0;accessible-label:Terms.facet-applied-library-filters-prefix + root.library-count;}
                                if root.compact && root.library-alert != "": Text {text:root.library-alert;wrap:word-wrap;min-width:0px;vertical-stretch:0;accessible-live-region:polite;}
                                for item[index] in root.catalog: catalog-row := Rectangle {
                                    property <bool> selected-row: root.selected==index;
                                    // A row created already selected, such as a new import,
                                    // reveals itself once it has been laid out.
                                    initial-reveal := Timer {
                                        interval: 1ms;
                                        running: catalog-row.selected-row;
                                        triggered => {
                                            self.running = false;
                                            if root.library-restoring {root.library-restore-ready=true;}
                                            else {catalog-row.reveal();}
                                        }
                                    }
                                    function reveal() {
                                        if self.selected-row && !root.library-restoring {
                                            if self.y + catalog-scroll.content-y < 0px {catalog-scroll.content-y=-self.y;}
                                            else if self.y+self.height+catalog-scroll.content-y > catalog-scroll.visible-height {catalog-scroll.content-y=catalog-scroll.visible-height - self.y - self.height;}
                                        }
                                    }
                                    changed selected-row => {self.reveal();}
                                    changed y => {self.reveal();}
                                    changed height => {self.reveal();}

                                    height: max(root.ui-size*4.5, label.preferred-height + 16px);
                                    background: root.selected == index ? Palette.selection-background : Palette.control-background;
                                    border-width: focus.has-focus ? 2px : 0px;
                                    border-color: root.selected == index ? Palette.accent-background : Palette.border;
                                    accessible-role: list-item;
                                    accessible-label: item.text;
                                    accessible-item-selectable: item.binding != "";
                                    accessible-item-selected: self.selected-row;
                                    property <bool> wants-focus: self.selected-row && item.binding != "" && root.focused-library-key == item.binding;
                                    changed wants-focus => {if self.wants-focus {focus.focus();}}

                                    accessible-action-default => {
                                        touch.clicked();
                                    }
                                    label := Text {min-width:0px;
                                        x: 10px;
                                        y: 10px;
                                        width: parent.width - 20px;
                                        text: item.text;
                                        wrap: word-wrap;
                                        color: root.selected == index ? Palette.selection-foreground : Palette.control-foreground;
                                    }
                                    focus := FocusScope {
                                        enabled:item.binding != "";
                                        focus-on-tab-navigation:catalog-row.selected-row && item.binding != "";
                                        changed has-focus => { if self.has-focus {root.focused-library-key=item.binding;} else if catalog-row.selected-row && root.focused-library-key==item.binding {root.focused-library-key="";} }
                                        key-pressed(event) => {
                                            if event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End {
                                                root.navigate-library(event.text == Key.DownArrow ? 1 : event.text == Key.UpArrow ? -1 : event.text == Key.Home ? -2 : 2);
                                                root.focused-library-key=root.library-key;
                                                return accept;
                                            }

                                            if event.text == Terms.caption-line-break || event.text == " " {
                                                root.select(item.binding);
                                                root.library-detail=true;
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                    // Above the focus scope, so a pointer press reaches it.
                                    touch := TouchArea {
                                        enabled:item.binding != "";
                                        private property <string> captured;
                                        private property <bool> armed:false;
                                        changed pressed => {if self.pressed {self.captured=item.binding;self.armed=true;}}
                                        clicked => {
                                            focus.focus();
                                            root.select(self.armed ? self.captured : item.binding);
                                            self.armed=false;

                                            root.library-detail=true;
                                        }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }
                            }
                        }
                        // Re-created compact list rows must not replace the saved
                        // scroll position with their initial selection reveal.
                        Timer { interval:1ms;running:root.library-restoring && (root.library-restore-ready || !root.has-results);
                            triggered=>{
                                catalog-scroll.content-y=max(min(0px,root.library-scroll-y),min(0px,catalog-scroll.visible-height - catalog-scroll.content-height));
                                root.library-scroll-y=catalog-scroll.content-y;
                                root.library-restoring=false;
                            }
                        }
                        HorizontalBox { vertical-stretch:0;
                        Button {
                            text: Terms.action-open-recipe-dialog;
                            enabled: root.can-import;
                            clicked => {
                                root.open-recipe();
                            }
                        }
                        if !root.has-results: Button {
                            text:Terms.caption-create-sound;
                            enabled:root.can-new;
                            clicked=>{root.new-draft();}
                        }
                        }
                    }
                    if !root.compact: Rectangle {
                        width: 6px;
                        background: resize-touch.has-hover || resize-focus.has-focus ? Palette.accent-background : Palette.border;
                        accessible-role: slider;
                        accessible-label: Terms.caption-library-pane-width;
                        accessible-value: root.sidebar-width / 1px;
                        accessible-value-minimum: 230;
                        accessible-value-maximum: 500;
                        accessible-value-step: 16;
                        accessible-action-set-value(v) => {
                            if v.is-float() {
                                root.resize-library-pane(v.to-float());
                            }
                        }
                        accessible-action-increment => {
                            root.resize-library-pane(root.sidebar-width/1px + 16);
                        }
                        accessible-action-decrement => {
                            root.resize-library-pane(root.sidebar-width/1px - 16);
                        }
                        forward-focus: resize-focus;
                        resize-focus := FocusScope {
                            key-pressed(event)=> {
                                if event.text==Key.LeftArrow {
                                    root.resize-library-pane(root.sidebar-width/1px - 16);
                                    return accept;
                                }
                                if event.text==Key.RightArrow {
                                    root.resize-library-pane(root.sidebar-width/1px + 16);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        // Above the focus scope, so a pointer press reaches it.
                        resize-touch := TouchArea {
                            mouse-cursor:col-resize;
                            clicked=> {
                                resize-focus.focus();
                            }
                            moved=> {
                                if self.pressed {
                                    root.resize-library-pane((root.sidebar-width + self.mouse-x - self.pressed-x)/1px);
                                }
                            }
                        }
                    }
                    if !root.compact || root.library-detail: detail-scroll := ScrollView {
                        // Follow the visible width so long text wraps rather than widening the page.
                        VerticalBox {
                            width: detail-scroll.visible-width;
                            spacing: 10px;
                            if root.compact: Button {
                                text:Terms.action-back-to-recipes;
                                clicked => {
                                    root.library-restore-ready=false;
                                    root.library-restoring=true;
                                    root.library-detail=false;
                                }
                            }
                        HorizontalBox { padding:0px; vertical-stretch:0;
                            Button {text:Terms.action-refresh;clicked=>{root.refresh-library();}}
                            Button {text:Terms.action-show-saved;clicked=>{root.show-saved();}}
                            Button {text:Terms.action-reset-sort;clicked=>{root.reset-library-sort();root.direction-choice=0;}}
                        }
                        Button {text:Terms.action-clear-all-filters;clicked=>{root.clear-applied-filters();}}
                        Text {text:root.library-count;wrap:word-wrap;min-width:0px;vertical-stretch:0;}
                        more := Disclosure {label:Terms.facet-more-filters-and-grouping;}
                        if more.expanded: VerticalBox {vertical-stretch:0;
                            Text {text:root.calendar-context;wrap:word-wrap;min-width:0px;vertical-stretch:0;}
                            LineEdit {text <=> root.study-query;placeholder-text:Terms.caption-study-doi-or-key-source;accessible-label:Terms.facet-study-evidence-filter;}
                            ComboBox {model:[Terms.facet-any-population,Terms.caption-human,Terms.caption-mouse,Terms.caption-other-animal,Terms.facet-mixed-population,Terms.caption-not-applicable,Terms.facet-unspecified-population];current-index <=> root.population-choice;accessible-label:Terms.facet-population-evidence-filter;}
                            ComboBox {model:[Terms.facet-any-condition-role,Terms.caption-test-condition,Terms.caption-comparison-condition,Terms.caption-mixed-roles,Terms.caption-unspecified-role];current-index <=> root.role-choice;accessible-label:Terms.facet-condition-role-evidence-filter;}
                            ComboBox {model:[Terms.facet-any-analysis-coverage,Terms.status-complete,Terms.status-partial,Terms.status-invalid];current-index <=> root.analysis-choice;accessible-label:Terms.facet-nominal-analysis-coverage;}
                            ComboBox {model:[Terms.caption-automatic-direction,Terms.caption-ascending,Terms.caption-descending];current-index <=> root.direction-choice;accessible-label:Terms.facet-sort-direction;}
                            ComboBox {model:[Terms.facet-no-grouping,Terms.caption-band-groups,Terms.caption-method-groups,Terms.caption-study-groups,Terms.caption-collection-groups];current-index <=> root.group-choice;accessible-label:Terms.facet-library-result-grouping;}
                            LineEdit {text <=> root.created-from;placeholder-text:Terms.caption-created-from-yyyy-mm-dd;accessible-label:Terms.facet-created-from-local-calendar-date;}
                            LineEdit {text <=> root.created-through;placeholder-text:Terms.caption-created-through-yyyy-mm-dd;accessible-label:Terms.facet-created-through-inclusive-local-calendar-date;}
                            LineEdit {text <=> root.modified-from;placeholder-text:Terms.caption-modified-from-yyyy-mm-dd;accessible-label:Terms.facet-modified-from-local-calendar-date;}
                            LineEdit {text <=> root.modified-through;placeholder-text:Terms.caption-modified-through-yyyy-mm-dd;accessible-label:Terms.facet-modified-through-inclusive-local-calendar-date;}
                            LineEdit {text <=> root.added-from;placeholder-text:Terms.facet-added-here-from-yyyy-mm-dd;accessible-label:Terms.facet-added-here-from-local-calendar-date;}
                            LineEdit {text <=> root.added-through;placeholder-text:Terms.facet-added-here-through-yyyy-mm-dd;accessible-label:Terms.facet-added-here-through-inclusive-local-calendar-date;}
                            Button {text:Terms.action-apply-filters;clicked=>{root.apply-filters();}}
                        }
                        Disclosure {label:Terms.caption-library-storage-and-recovery;expanded <=> root.storage-open;}
                        if root.storage-open: VerticalBox { vertical-stretch:0;
                            Text {text:root.library-status;wrap:word-wrap;vertical-stretch:0;min-width:0px;}
                            Button {text:Terms.action-initialize-configured-library;clicked=>{root.initialize-library();}}
                            Button {text:Terms.action-recheck-publication;clicked=>{root.recheck-library();}}
                        }
                            if root.library-alert != "": Text {text:root.library-alert;wrap:word-wrap;min-width:0px;vertical-stretch:0;accessible-live-region:polite;}
                            if root.file-activity != "": Text {min-width:0px;text:root.file-activity;wrap:word-wrap;vertical-stretch:0;}
                        if !root.has-results: Text {min-width:0px;
                                text:Terms.status-empty-filtered-library;
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            if root.has-results: VerticalBox {
                                vertical-stretch: 0;
                                Text {min-width:0px;
                                    text:root.sound-title;
                                    font-size:root.ui-size*1.85;
                                    font-weight:600;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }

                                Text {min-width:0px;
                                    text:root.structure;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                // A custom recipe has no study or summary to show.
                                if root.studied != "": Text {min-width:0px;text:root.studied;wrap:word-wrap;vertical-stretch:0;}
                                Text {min-width:0px;
                                    text:root.recipe-timing;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                if root.summary != "": Text {min-width:0px;
                                    text:root.summary;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    vertical-stretch: 0;
                                    StableButton {
                                        text:root.library-play-action;
                                        labels:root.library-play-labels;
                                        enabled:root.can-play;
                                        clicked=> {
                                            root.play-recipe();
                                        }
                                    }
                                    Button {text:Terms.action-preview-waveform;enabled:root.can-preview;clicked=>{root.preview-selected();}}
                                    Button {
                                        text:Terms.action-edit-acopy;
                                        enabled:root.can-copy;
                                        accessible-description:root.copy-reason;
                                        clicked=> {
                                            root.open-workbench();
                                        }
                                    }
                                    Button {
                                        text:Terms.action-export-wav-dialog;
                                        enabled:root.can-export;
                                        clicked=> {
                                            root.export-wav();
                                        }
                                    }
                                }
                                if root.library-dates != "": Text {text:root.library-dates;wrap:word-wrap;vertical-stretch:0;min-width:0px;}
                                utc-dates := Disclosure {label:Terms.facet-exact-utc-dates;}
                                if utc-dates.expanded: TextEdit {text:root.library-dates-utc;read-only:true;wrap:word-wrap;accessible-label:Terms.facet-exact-utc-recipe-and-membership-dates;min-width:0px;height:root.ui-size*8;vertical-stretch:0;}
                                if root.library-key != "": Text {text:root.library-key;wrap:word-wrap;vertical-stretch:0;min-width:0px;}
                                if root.library-token != "" && !root.library-trashed: BoundButton {text:Terms.action-edit-saved-user-recipe;key:root.library-key;token:root.library-token;activated(k,t)=>{root.edit-saved(k,t);}}
                                Button {text:Terms.action-export-portable-recipe-dialog;enabled:root.has-results;clicked=>{root.export-recipe();}}
                                if root.collection-choice == 3: BoundButton {text:Terms.action-close-open-file;key:root.library-key;token:"";activated(k,t)=>{root.close-open-file(k);}}
                                if root.collection-choice == 3: BoundButton {text:Terms.action-edit-external-file;key:root.library-key;token:"";activated(k,t)=>{root.edit-saved(k,t);}}
                                if root.collection-choice == 3: BoundButton {text:Terms.action-add-to-user-library;key:root.library-key;token:"";activated(k,t)=>{root.add-to-library(k);}}
                                if root.library-token != "": VerticalBox { vertical-stretch:0;
                                    if !root.library-trashed: BoundTitleEdit {key:root.library-key;token:root.library-token;placeholder-text:Terms.caption-new-title;accessible-label:Terms.action-rename-saved-recipe;rename(k,t,value)=>{root.library-action(k,t,Terms.action-rename,value);} }
                                    BoundButton {text:root.library-trashed ? Terms.action-restore-from-trash : Terms.action-move-saved-entry-to-trash;key:root.library-key;token:root.library-token;action:root.library-trashed ? Terms.action-restore : Terms.action-trash;dispatch(k,t,action)=>{root.library-action(k,t,action,"");}}
                                    if root.library-trashed: BoundButton {text:Terms.action-permanently-delete-dialog;key:root.library-key;token:root.library-token;activated(k,t)=>{root.library-action(k,t,Terms.action-purge,"");}}
                                }
                                Disclosure {label:Terms.caption-research-citation-and-sound-adaptations;expanded <=> root.research;}
                                if root.research && root.can-open-study: Button {text:Terms.action-open-study-source;clicked=>{root.open-study();}}
                                if root.research: Button {text:Terms.action-read-selectable-research-and-recipe-details-dialog;clicked=>{root.show-research();}}
                                library-pattern := Disclosure {label:Terms.caption-pattern-explained-static-core-model;}
                                if library-pattern.expanded: VerticalBox {
                                    vertical-stretch:0;
                                    Text {min-width:0px;text:root.model-caption;wrap:word-wrap;vertical-stretch:0;}
                                    for lane in root.model-lanes: VerticalBox {
                                        vertical-stretch:0;
                                        Text {min-width:0px;text:lane.label;wrap:word-wrap;vertical-stretch:0;}
                                        Rectangle {height:30px;background:Palette.control-background;
                                            accessible-role:image;accessible-label:lane.label+Terms.caption-static-model;
                                            Path {width:parent.width;height:parent.height;viewbox-width:1024;viewbox-height:100;fit:fill;commands:lane.trace;stroke:Palette.accent-background;stroke-width:2px;}
                                        }
                                    }
                                }
                                Disclosure {label:Terms.action-export-settings;expanded <=> root.export-settings;}
                                if root.export-settings: ExportRate {
                                    choices:root.export-rates;
                                    selected <=> root.rate-index;
                                    edit-enabled:true;
                                    changed(i)=> {
                                        root.rate-changed(i);
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch:1;
                            }
                        }
                    }
                }
            }
            Tab {
                title:Terms.caption-workbench;
                editor-scroll := ScrollView {
                    content-y <=> root.editor-scroll-y;
                    // Follow the visible width so long text wraps rather than widening the page.
                    VerticalBox {
                    width: editor-scroll.visible-width;
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        Text {
                            text:root.title-field.label;
                            vertical-alignment:center;
                        }
                        MetadataField {
                            key: MetadataKey.title;
                            field: root.title-field;
                            binding: root.document;
                            reset-key:root.document-reset;
                            enabled:root.can-edit;
                            edits-suspended:root.edits-suspended;
                            accessible-label:Terms.caption-sound-title;
                            stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                            commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                            restore-field(owner, key) => { root.restore-metadata(owner, key); }
                        }
                    }
                    HorizontalBox {vertical-stretch:0;
                        Text {min-width:0px;
                            text:root.dirty ? Terms.status-unsaved-changes : Terms.status-unmodified-draft;
                            wrap:word-wrap;vertical-alignment:center;horizontal-stretch:1;
                        }
                        Button {horizontal-stretch:0;text:Terms.action-save-independent-copy;enabled:root.can-edit;clicked=>{root.save-copy();}}
                        Button {
                            horizontal-stretch:0;
                            text:Terms.action-new;
                            enabled:root.can-new;
                            clicked=> {
                                root.new-draft();
                            }
                        }
                    }
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        for label[index] in root.add-choices: Button {
                            text:label;
                            enabled:root.can-add-component;
                            accessible-description:root.add-reason;
                            clicked=> {
                                root.add-component(root.document, index);
                            }
                        }
                    }
                    HorizontalBox {
                        vertical-stretch: 0;
                        Button { text: Terms.action-add-binaural-pair; enabled: root.can-add-pair; accessible-description: root.pair-add-reason; clicked => { root.add-component(root.document, 2); } }
                        Button { text: Terms.action-add-monaural-pair; enabled: root.can-add-pair; accessible-description: root.pair-add-reason; clicked => { root.add-component(root.document, 3); } }
                    }
                    if root.pair-add-reason != "" && root.add-reason == "": Text {min-width:0px;text:root.pair-add-reason;wrap:word-wrap;vertical-stretch:0;}
                    if root.add-reason != "": Text {min-width:0px;text:root.add-reason;wrap:word-wrap;vertical-stretch:0;}
                    if root.removed-component != "": HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        Button {
                            text: Terms.action-undo-remove;
                            horizontal-stretch: 0;
                            enabled: root.can-restore-component;
                            accessible-description: root.removed-component + " " + root.add-reason;
                            clicked => { root.restore-component(root.document); }
                        }
                        Text {min-width:0px;horizontal-stretch:1;text:root.removed-component;wrap:word-wrap;vertical-alignment:center;}
                    }
                    if root.retained-warning != "": Text {min-width:0px;
                        text:root.retained-warning;
                        color:Palette.foreground;
                        font-weight:700;
                        wrap:word-wrap;
                        vertical-stretch:0;
                        accessible-label:root.retained-warning;
                        accessible-live-region:polite;
                    }
                    if root.file-activity != "": Text {min-width:0px;text:root.file-activity;wrap:word-wrap;vertical-stretch:0;}
                    if root.metadata-error != "": Text {min-width:0px;text:root.metadata-error;wrap:word-wrap;vertical-stretch:0;accessible-live-region:polite;}
                    if root.save-reason != "": Text {min-width:0px;text:root.save-reason;wrap:word-wrap;vertical-stretch:0;}
                    Text {min-width:0px;text:root.draft-location;wrap:word-wrap;vertical-stretch:0;}
                    Text {min-width:0px;text:root.draft-brief; font-size:root.ui-size*1.5; font-weight:600; wrap:word-wrap; vertical-stretch:0;}
                    if root.based-on-title != "": Text {min-width:0px;
                        text:root.based-on-title;
                        wrap:word-wrap;
                        font-size:root.ui-size*0.93;
                        vertical-stretch:0;
                    }
                    for row in root.components: VerticalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        Rectangle {
                            height:1px;
                            background:Palette.border;
                        }
                        Text {
                            text: row.heading;
                            font-weight: 700;
                            vertical-stretch: 0;
                        }
                        Text {min-width:0px;text:row.context; wrap:word-wrap; vertical-stretch:0;}
                        pattern := Disclosure {label:Terms.caption-pattern-explained-static-core-model;}
                        if pattern.expanded: VerticalBox {
                            vertical-stretch:0;
                            Text {min-width:0px;text:root.model-caption;wrap:word-wrap;vertical-stretch:0;}
                            VerticalBox {
                              padding:0px; spacing:0px; vertical-stretch:0;
                              for lane in root.model-lanes: VerticalBox {
                                padding:0px; spacing:0px; vertical-stretch:0;
                                if lane.component == row.id: VerticalBox {
                                  vertical-stretch:0;
                                  Text {min-width:0px;text:lane.label;wrap:word-wrap;vertical-stretch:0;}
                                  Rectangle {height:36px;background:Palette.control-background;
                                      accessible-role:image;accessible-label:lane.label+Terms.caption-static-model-origin-zero;
                                      Path {width:parent.width;height:parent.height;viewbox-width:1024;viewbox-height:100;fit:fill;commands:lane.trace;stroke:Palette.accent-background;stroke-width:2px;}
                                  }
                                }
                              }
                            }
                        }
                        component-options := Disclosure {label:Terms.caption-routing-modulation-and-component-options;}
                        // Labels beside choices sized to their content; the
                        // shared column keeps the three choices aligned.
                        if component-options.expanded: GridLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            Row {
                                if row.routing-editable: Text { text: Terms.caption-ears; vertical-alignment: center; }
                                if row.routing-editable: ComboBox { enabled: root.can-edit; model: root.ears-choices; current-index: row.ears; accessible-label: row.name + Terms.caption-ears-suffix; selected(value) => { root.set-ears(row.binding, self.current-index); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                if row.carrier >= 0: Text { text: Terms.caption-carrier; vertical-alignment: center; }
                                if row.carrier >= 0: ComboBox { enabled: root.can-edit; model: root.carrier-choices; current-index: row.carrier; accessible-label: row.name + Terms.caption-carrier-suffix; selected(value) => { root.set-carrier(row.binding, self.current-index); } }
                            }
                            Row {
                                if row.carrier >= 0: Text { text: Terms.caption-modulation; vertical-alignment: center; }
                                if row.carrier >= 0: ComboBox { enabled: root.can-edit; model: root.modulation-choices; current-index: row.modulation; accessible-label: row.name + Terms.caption-modulation-suffix; selected(value) => { root.set-modulation(row.binding, self.current-index); } }
                            }
                            Row { Button { col:1; text: Terms.action-remove; enabled: root.can-edit; accessible-label: Terms.action-remove-prefix + row.name; clicked => { root.remove-component(row.binding); } } }
                        }
                        for parameter in row.parameters: ParameterControl {
                            parameter: parameter;
                            owner: row.binding;
                            context: row.name;
                            compact: root.compact;
                            ui-size: root.ui-size;
                            edit-enabled: root.can-edit;
                            edits-suspended: root.edits-suspended;
                            stage(owner, key, value) => { root.stage-parameter(owner, key, value); }
                            commit(owner, key, value) => { root.commit-parameter(owner, key, value); }
                            restore(owner, key) => { root.restore-parameter(owner, key); }
                            slide(owner, key, value) => { root.slide(owner, key, value); }
                        }
                        if row.error != "": Text {min-width:0px;
                            text: row.error;
                            color: Palette.foreground;
                            accessible-live-region: polite;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                    }
                    Text {min-width:0px;
                        text:root.peak;
                        wrap:word-wrap;
                        vertical-stretch:0;
                    }
                    settings := Disclosure {label:Terms.caption-sound-settings-notes-and-saved-exported-audio;}
                    if settings.expanded: VerticalBox {
                        vertical-stretch:0;
                        Text {text:root.draft-location-details;min-width:0px;wrap:word-wrap;vertical-stretch:0;}

                        Button {text:Terms.action-export-portable-draft-recipe-dialog;enabled:root.can-save;clicked=>{root.export-recipe();}}

                        HorizontalLayout {
                            Button {
                                horizontal-stretch:0;
                                text:Terms.action-export-wav-dialog;
                                enabled:root.can-export;
                                accessible-description:root.export-reason;
                                clicked=> {
                                    root.export-wav();
                                }
                            }
                            Rectangle {}
                        }
                        if !root.can-export && root.export-reason != "": Text {min-width:0px;text:root.export-reason;wrap:word-wrap;vertical-stretch:0;}
                        Disclosure {label:Terms.caption-sound-notes;expanded <=> root.notes;}
                        if root.notes: VerticalBox {
                            vertical-stretch:0;
                            if root.based-on != "": Text {min-width:0px;
                                text:root.based-on;
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            if root.based-on != "": Button {
                                text:Terms.action-show-copied-from-snapshot-in-library;
                                clicked=> {
                                    root.based-on-source();
                                }
                            }
                            Text {
                                text:Terms.caption-your-notes-about-this-sound;
                                vertical-stretch:0;
                            }
                            NotesField {
                                key: MetadataKey.summary;
                                field: root.summary-field;
                                binding: root.document;
                                reset-key:root.document-reset;
                                enabled:root.can-edit;
                                edits-suspended:root.edits-suspended;
                                accessible-label:Terms.caption-custom-recipe-notes;
                                stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                                commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                                restore-field(owner, key) => { root.restore-metadata(owner, key); }
                            }
                        }
                        Disclosure {label:Terms.action-saved-audio-duration-fades-and-export-rate;expanded <=> root.saved-audio;}
                        if root.saved-audio: VerticalBox {
                            vertical-stretch:0;
                            Text {min-width:0px;
                                text:Terms.caption-saved-audio-help;
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            HorizontalBox {
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text:root.duration-field.label;
                                    vertical-alignment:center;
                                }
                                MetadataField {
                                    key: MetadataKey.duration;
                                    field: root.duration-field;
                                    binding: root.document;
                                    reset-key:root.document-reset;
                                    enabled:root.can-edit;
                                    edits-suspended:root.edits-suspended;
                                    accessible-label:Terms.action-saved-duration;
                                    horizontal-stretch:0;
                                    preferred-width:root.ui-size*10;
                                    stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                                    commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                                    restore-field(owner, key) => { root.restore-metadata(owner, key); }
                                }
                                Text {
                                    text:root.fade-field.label;
                                    vertical-alignment:center;
                                }
                                MetadataField {
                                    key: MetadataKey.fade;
                                    field: root.fade-field;
                                    binding: root.document;
                                    reset-key:root.document-reset;
                                    enabled:root.can-edit;
                                    edits-suspended:root.edits-suspended;
                                    accessible-label:Terms.action-saved-fade;
                                    horizontal-stretch:0;
                                    preferred-width:root.ui-size*10;
                                    stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                                    commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                                    restore-field(owner, key) => { root.restore-metadata(owner, key); }
                                }
                                Rectangle {}
                            }
                            if root.duration-field.diagnostic != "": Text {min-width:0px;text:root.duration-field.diagnostic;wrap:word-wrap;vertical-stretch:0;}
                            if root.fade-field.diagnostic != "": Text {min-width:0px;text:root.fade-field.diagnostic;wrap:word-wrap;vertical-stretch:0;}
                            ExportRate {
                                choices:root.export-rates;
                                selected <=> root.rate-index;
                                edit-enabled:true;
                                changed(i)=> {
                                    root.rate-changed(i);
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch:1;
                    }
                    }
                }
            }
        }
        Rectangle {
            visible:root.monitor-open && root.drawer-fits;
            clip:true;
            preferred-height:self.visible ? root.effective-drawer-height : 0px;
            min-height:self.visible ? root.effective-drawer-height : 0px;
            max-height:self.visible ? root.effective-drawer-height : 0px;
            vertical-stretch:0;
            background:Palette.control-background;
            border-width:1px;border-color:Palette.border;
            drawer-content := VerticalBox {padding:8px;spacing:3px;
                Rectangle {
                    height:6px;background:grip-touch.has-hover || grip-focus.has-focus ? Palette.accent-background : Palette.border;
                    accessible-role:slider;accessible-label:Terms.caption-output-monitor-height;
                    accessible-value:root.effective-drawer-height/1px;accessible-value-minimum:root.minimum-monitor-height/1px;accessible-value-maximum:max(root.minimum-monitor-height,root.maximum-monitor-height)/1px;accessible-value-step:16;
                    accessible-action-set-value(v)=>{if v.is-float(){root.resize-monitor(v.to-float());}}
                    accessible-action-increment=>{root.resize-monitor(root.effective-drawer-height/1px+16);}
                    accessible-action-decrement=>{root.resize-monitor(root.effective-drawer-height/1px-16);}
                    forward-focus:grip-focus;
                    grip-focus := FocusScope {key-pressed(e)=>{if e.text==Key.UpArrow{root.resize-monitor(root.effective-drawer-height/1px+16);return accept;}if e.text==Key.DownArrow{root.resize-monitor(root.effective-drawer-height/1px-16);return accept;}return reject;}}
                    grip-touch := TouchArea {mouse-cursor:row-resize;moved=>{if self.pressed{root.resize-monitor((root.effective-drawer-height + self.pressed-y - self.mouse-y)/1px);}}clicked=>{grip-focus.focus();}}
                }
                MonitorPanel {
                    data:root.monitor-data;ui-size:root.ui-size;
                    span-choices:root.span-choices;scale-choices:root.scale-choices;
                    span(i)=>{root.window-index=i;root.window-changed();}
                    scale(i)=>{root.scale-index=i;root.window-changed();}
                    hold=>{root.held=!root.held;root.hold-changed();}
                    follow=>{root.follow-motion();}
                    details=>{root.show-diagnostics();}
                    collapse=>{root.monitor-open=false;monitor-opener.focus-button();root.window-changed();}
                }
            }
        }
        transport := Rectangle {
            changed preferred-height=>{root.update-monitor-layout();}
            min-height:root.ui-size*5.5;max-height:root.ui-size*9;
            vertical-stretch:0;
            background:Palette.control-background;border-width:1px;border-color:Palette.border;
            VerticalBox {padding:8px;spacing:3px;
                HorizontalBox {vertical-stretch:0;padding:0px;
                    StableButton {text:root.transport-action;labels:root.transport-labels;primary:true;enabled:root.transport-enabled;accessible-name:root.transport-action+(root.playback-busy || root.play-target == "" ? "" : " · "+root.play-target);clicked=>{root.play-stop();}}
                    VerticalBox {padding:0px;spacing:2px;horizontal-stretch:1;
                        // One line each: the transport keeps its height; Details has the full text.
                        Text {min-width:0px;text:root.player-title+(root.playback-busy || root.play-target == "" ? "" : Terms.caption-next-play-prefix+root.play-target);wrap:no-wrap;overflow:elide;}
                        Text {min-width:0px;text:root.generated;wrap:no-wrap;overflow:elide;}
                    }
                    // Sized for the longest clock, so ticking never reflows the row.
                    Rectangle {
                        horizontal-stretch:0;
                        min-width:elapsed-template.preferred-width;
                        preferred-width:elapsed-template.preferred-width;
                        min-height:elapsed-text.preferred-height;
                        elapsed-template := Text {visible:false;text:"00:00:00 / 00:00:00";}
                        elapsed-text := Text {width:parent.width;height:parent.height;text:root.elapsed;horizontal-alignment:right;vertical-alignment:center;}
                    }
                    Button {text:Terms.caption-details-dialog;horizontal-stretch:0;accessible-label:Terms.caption-audio-details;clicked=>{root.show-diagnostics();}}
                }
                VerticalBox {
                    padding:0px; spacing:0px; min-height:root.ui-size*2.5; max-height:root.ui-size*2.5; vertical-stretch:0;
                    Text { min-width:0px; min-height:root.ui-size*1.25; max-height:root.ui-size*1.25;
                        text:root.auxiliary-error != "" ? root.auxiliary-error : root.operation-summary;
                        wrap:no-wrap; overflow:elide; accessible-label:self.text; accessible-live-region:polite; }
                    Text { min-width:0px; min-height:root.ui-size*1.25; max-height:root.ui-size*1.25;
                        text:root.operation-outcome; wrap:no-wrap; overflow:elide; accessible-label:self.text; accessible-live-region:polite; }
                }
                Text {min-width:0px;text:root.guidance;wrap:word-wrap;vertical-stretch:0;}
            }
        }
    }
}
