import {
    Palette, AboutSlint, Button, ComboBox, TextEdit, LineEdit, Slider, VerticalBox, HorizontalBox, CheckBox, StandardListView, ScrollView, TabWidget, ProgressIndicator
}
from "std-widgets.slint";
// Semantic quantities; the application maps each to exactly one domain field.
export enum ParameterKey {
    tone-frequency, click-rate, click-width, peak-level, amplitude-modulation-rate,
    modulation-depth, gate-rate, gate-width, duration, fade
}
export enum MetadataKey { title, summary, duration, fade }
export struct ParameterRow {
    key: ParameterKey,
    label: string,
    help: string,
    text: string,
    staged: bool,
    has-slider: bool,
    position: float,
    diagnostic: string,
}
// `binding` identifies the rendered component of one particular document.
export struct ComponentRow {
    binding: int,
    id: int,
    ears: int,
    carrier: int,
    modulation: int,
    heading: string,
    name: string,
    context: string,
    error: string,
    parameters: [ParameterRow],
}
export struct MetadataRow { label: string, text: string, staged: bool, diagnostic: string }
export struct ModelLane { component: int, label: string, trace: string }
// A compact disclosure: as wide as its label, aligned with the content it opens.
component Disclosure inherits Rectangle {
    in-out property <bool> expanded: false;
    in property <string> label;
    min-width: toggle.min-width;
    preferred-width: toggle.preferred-width;
    max-width: toggle.preferred-width;
    min-height: toggle.min-height;
    preferred-height: toggle.preferred-height;
    max-height: toggle.preferred-height;
    horizontal-stretch: 0;
    toggle := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: (root.expanded ? "▾ " : "▸ ") + root.label;
        accessible-label: root.label + (root.expanded ? " · expanded" : " · collapsed");
        accessible-expanded: root.expanded;
        clicked => {root.expanded = !root.expanded;}
    }
}
// Uncommitted text, caret and focus stay local. Model refreshes replace only
// unfocused text. An edit keeps the binding it started with, so a late commit
// can never address a field rendered for another document.
component NumericField inherits LineEdit {
    in property <string> display-text;
    in property <bool> edits-suspended:false;
    in property <bool> staged:false;
    in property <int> binding;
    in property <int> reset-key;
    private property <bool> dirty: false;
    private property <int> captured: -1;
    callback stage(int, string);
    callback commit(int, string);
    callback restore(int);
    function owner() -> int { return root.dirty ? root.captured : root.binding; }
    changed reset-key => {
        self.text = root.display-text;
        root.dirty = root.staged;
        root.captured = root.binding;
    }
    changed staged => {
        if root.staged && !root.dirty { root.captured = root.binding; }
        root.dirty = root.staged;
    }
    init => {self.text=root.display-text;root.dirty=root.staged;root.captured=root.binding;}
    changed display-text => {
        if !self.has-focus {
            self.text = root.display-text;
            root.dirty=root.staged;
        }
    }
    edited(value) => {
        if !root.dirty { root.captured = root.binding; }
        root.dirty = true;
        root.stage(root.captured, value);
    }
    key-pressed(event) => {
        if event.text == Key.Escape {
            root.restore(root.owner());
            self.text = root.display-text;
            root.dirty = false;
            return accept;
        }
        return reject;
    }
    accepted(value) => {
        let owner = root.owner();
        root.dirty = false;
        root.commit(owner, value);
    }
    changed has-focus => {
        if !self.has-focus && root.dirty && !root.edits-suspended {
            root.dirty = false;
            root.commit(root.captured, self.text);
        }
    }
}
component ParameterControl inherits HorizontalBox {
    in property <ParameterRow> parameter;
    in property <int> owner;
    in property <string> context;
    in property <bool> compact:false;
    in property <length> ui-size:13px;
    in property <bool> edits-suspended:false;
    in property <bool> edit-enabled: true;
    callback stage(int, ParameterKey, string);
    callback commit(int, ParameterKey, string);
    callback restore(int, ParameterKey);
    callback slide(int, ParameterKey, float);
    padding: 0px;
    vertical-stretch: 0;
    Text {
        text: root.parameter.label;
        vertical-alignment: center;
        min-width:root.ui-size*(root.compact ? 4 : 12.5);
        max-width:root.ui-size*(root.compact ? 7 : 16);
        wrap: word-wrap;
    }
    if !root.compact && root.parameter.has-slider: Slider {
        enabled: root.edit-enabled;
        minimum: 0;
        maximum: 1;
        step: 0.001;
        value: root.parameter.position;
        // Dragging replaces the value binding; keep following committed values.
        property <float> committed: root.parameter.position;
        changed committed => { self.value = self.committed; }
        accessible-label: root.context+": "+root.parameter.label + " slider";
        changed(value) => {
            root.slide(root.owner, root.parameter.key, value);
        }
    }
    NumericField {
        enabled: root.edit-enabled;
        binding: root.owner;
        display-text: root.parameter.text;
        edits-suspended:root.edits-suspended;
        staged:root.parameter.staged;
        preferred-width:root.ui-size*(root.compact ? 7 : 12);
        max-width:root.ui-size*(root.compact ? 7 : 12);
        horizontal-stretch: 0;
        accessible-label: root.context+": "+root.parameter.label;
        accessible-description: root.parameter.diagnostic != "" ? root.parameter.diagnostic : root.parameter.help;
        restore(owner) => { root.restore(owner, root.parameter.key); }
        stage(owner, value) => { root.stage(owner, root.parameter.key, value); }
        commit(owner, value) => { root.commit(owner, root.parameter.key, value); }
    }
}
component MetadataField inherits NumericField {
    in property <MetadataRow> field;
    in property <MetadataKey> key;
    callback stage-field(int, MetadataKey, string);
    callback commit-field(int, MetadataKey, string);
    callback restore-field(int, MetadataKey);
    display-text: root.field.text;
    staged: root.field.staged;
    accessible-description: root.field.diagnostic;
    stage(owner, value) => { root.stage-field(owner, root.key, value); }
    commit(owner, value) => { root.commit-field(owner, root.key, value); }
    restore(owner) => { root.restore-field(owner, root.key); }
}
// A button as wide as the widest of its possible labels, so a label change
// never resizes it or moves its neighbours. Hidden copies of the button
// measure the labels in the current font; they are neither drawn, focusable
// nor exposed to accessibility.
component StableButton inherits Rectangle {
    in property <string> text;
    in property <[string]> labels;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <string> accessible-name: root.text;
    in property <bool> expanded: false;
    callback clicked();
    forward-focus: button;
    property <length> stable-width: max(measure.preferred-width, button.preferred-width);
    min-width: root.stable-width;
    preferred-width: root.stable-width;
    max-width: root.stable-width;
    min-height: button.min-height;
    preferred-height: button.preferred-height;
    max-height: button.preferred-height;
    horizontal-stretch: 0;
    measure := VerticalLayout {
        visible: false;
        for label in root.labels: Button { text: label; primary: root.primary; }
    }
    button := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        primary: root.primary;
        enabled: root.enabled;
        accessible-label: root.accessible-name;
        accessible-expanded: root.expanded;
        clicked => { root.clicked(); }
    }
}
component ExportRate inherits HorizontalBox {
    padding: 0px;
    vertical-stretch: 0;
    in-out property <int> selected;
    in property <[string]> choices;
    in property <bool> edit-enabled;
    callback changed(int);
    Text {
        text:"Export sample rate";
        vertical-alignment:center;
    }
    ComboBox {
        horizontal-stretch:0;
        model:root.choices;
        current-index <=> root.selected;
        enabled:root.edit-enabled;
        selected(v)=> {
            root.changed(self.current-index);
        }
    }
}
export component AboutWindow inherits Window {
    title: "About Auditory Lab";
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 560px;
    preferred-height: 560px;
    min-width:360px;min-height:360px;
    in property <string> identity;
    callback open-source();
    callback dismiss();
    callback focus-close();
    focus-close => {close.focus();}
    forward-focus: about-focus;
    about-focus := FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape {root.dismiss();return accept;}return reject;}
        VerticalBox {
            ScrollView {min-height:0px;
                VerticalBox {
                    Text {text:"Auditory Lab";font-size:root.ui-size*1.85;vertical-stretch:0;}
                    TextEdit {text:root.identity;read-only:true;min-height:root.ui-size*12;preferred-height:root.ui-size*14;accessible-label:"Version and licenses";}
                    Button {text:"Source and issue tracker";vertical-stretch:0;clicked=>{root.open-source();}}
                    AboutSlint {min-height:root.ui-size*7;max-height:root.ui-size*10;}
                }
            }
            close := Button {text:"Close";vertical-stretch:0;clicked=>{root.dismiss();}}
        }
    }
}

component Lane inherits Rectangle {
    in property <string> label;
    in property <string> trace;
    in property <string> limit: "1";
    in property <length> ui-size:13px;
    in property <length> label-column-width;
    out property <length> label-width:title.preferred-width;
    property <length> axis-row-height: max(title.preferred-height, positive.preferred-height, zero.preferred-height, negative.preferred-height);
    property <length> tick-width: max(positive.preferred-width, zero.preferred-width, negative.preferred-width);
    property <length> tick-x: root.label-column-width + 12px;
    property <length> axis-width: root.tick-x + root.tick-width + 6px;
    background: #131d2b;
    preferred-height: root.axis-row-height*3;
    min-height: root.axis-row-height*3;
    // Keep at least a 2:1 plotting area beside the full labels.
    min-width: root.axis-width + root.axis-row-height*4 + 8px;
    accessible-role: image;
    accessible-label: root.label + " samples, common symmetric scale ±" + root.limit;
    title := Text {
        x: 6px;
        y: root.axis-row-height*1.5 - self.preferred-height/2;
        text: root.label;
        color: #e1eaf6;
        font-size: root.ui-size*0.93;
    }
    positive := Text {
        x: root.tick-x;
        y: root.axis-row-height*0.5 - self.preferred-height/2;
        text: "+"+root.limit;
        color: #c6d0df;
        font-size: root.ui-size;
    }
    zero := Text {
        x: root.tick-x;
        y:root.axis-row-height*1.5 - self.preferred-height/2;
        text: "0";
        color: #c6d0df;
        font-size: root.ui-size;
    }
    negative := Text {
        x: root.tick-x;
        y:root.axis-row-height*2.5 - self.preferred-height/2;
        text: "−"+root.limit;
        color: #c6d0df;
        font-size: root.ui-size;
    }
    Rectangle {
        x: root.axis-width;
        y: root.axis-row-height*0.5;
        width: max(1px, parent.width - root.axis-width - 8px);
        height:root.axis-row-height*2;
        clip: true;
        Rectangle {
            y: parent.height / 2;
            height: 1px;
            width: parent.width;
            background: #43536b;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1024;
            viewbox-height: 100;
            fit: fill;
            commands: root.trace;
            stroke: #77d4ef;
            stroke-width: 1px;
        }
    }
}
export struct MonitorData {
    state:string,age:string,caption:string,meters:string,warning:string,warninglive:bool,backendwarning:string,motion:string,
    left:string,right:string,limit:string,spanlabel:string,spanchoice:int,scalechoice:int,held:bool,overridden:bool
}
component MonitorPanel inherits VerticalBox {
    property <length> lane-label-width: max(left-lane.label-width, right-lane.label-width);
    in property <MonitorData> data;
    in property <[string]> span-choices;
    in property <[string]> scale-choices;
    in property <length> ui-size:13px;
    callback span(int);callback scale(int);callback hold();callback follow();callback details();callback collapse();
    spacing:4px;padding:0px;
    HorizontalBox {padding:0px;vertical-stretch:0;cross-axis-alignment:center;
        Text {min-width:0px;text:"Output monitor";font-weight:700;wrap:word-wrap;}
        Text {text:root.data.state;font-weight:600;wrap:no-wrap;horizontal-stretch:0;}
        Text {preferred-width:0px;horizontal-stretch:1;text:root.data.age;wrap:no-wrap;overflow:elide;accessible-label:root.data.age;}
        Button {text:"Details…";accessible-label:"Full audio diagnostics and capture source";clicked=>{root.details();}}
        Button {text:"Hide";accessible-label:"Hide output monitor";clicked=>{root.collapse();}}
    }
    HorizontalBox {padding:0px;spacing:12px;
        VerticalBox {padding:0px;spacing:3px;
            Text {min-width:0px;text:root.data.caption;max-height:root.ui-size*2.5;wrap:word-wrap;overflow:elide;}
            left-lane := Lane {label:"Left";trace:root.data.left;limit:root.data.limit;ui-size:root.ui-size;label-column-width:root.lane-label-width;}
            right-lane := Lane {label:"Right";trace:root.data.right;limit:root.data.limit;ui-size:root.ui-size;label-column-width:root.lane-label-width;}
            HorizontalBox {padding:0px;vertical-stretch:0;Text {text:"−"+root.data.spanlabel;}Rectangle {horizontal-stretch:1;}Text {text:"Captured end";}}
        }
        VerticalBox {padding:0px;spacing:4px;preferred-width:root.ui-size*21;max-width:root.ui-size*25;
            ComboBox {model:root.span-choices;current-index:root.data.spanchoice;enabled:!root.data.held;accessible-label:"Waveform time window";selected(v)=>{root.span(self.current-index);}}
            ComboBox {model:root.scale-choices;current-index:root.data.scalechoice;enabled:!root.data.held;accessible-label:"Waveform amplitude scale";selected(v)=>{root.scale(self.current-index);}}
            HorizontalBox {padding:0px;spacing:4px;
                Button {text:root.data.held ? "Return to live" : "Hold display";clicked=>{root.hold();}}
                if root.data.overridden: Button {text:"Follow system";accessible-label:"Follow system motion preference";clicked=>{root.follow();}}
            }
            Text {min-width:0px;text:root.data.meters;max-height:root.ui-size*4;wrap:word-wrap;overflow:elide;}
        }
    }
    Text {min-width:0px;text:root.data.motion;wrap:word-wrap;vertical-stretch:0;max-height:root.ui-size*2.5;overflow:elide;}
    // A reserved row keeps brief coverage changes from changing the responsive window choice.
    HorizontalBox {
        padding:0px;spacing:8px;vertical-stretch:0;
        min-height:root.ui-size*2.5;max-height:root.ui-size*2.5;
        Text {text:root.data.warning;visible:root.data.warning!="";wrap:word-wrap;min-width:0px;preferred-width:0px;horizontal-stretch:1;max-height:root.ui-size*2.5;overflow:elide;accessible-live-region:root.data.warninglive ? polite : off;}
        Text {text:root.data.backendwarning;visible:root.data.backendwarning!="";wrap:word-wrap;min-width:0px;preferred-width:0px;horizontal-stretch:1;max-height:root.ui-size*2.5;overflow:elide;accessible-live-region:polite;}
    }
}
export component MonitorWindow inherits Window {
    title:"Output monitor";
    in property <string> ui-family;in property <length> ui-size:13px;
    default-font-family:root.ui-family;default-font-size:root.ui-size;
    preferred-width:950px;preferred-height:420px;
    min-width:680px;min-height:400px;
    in property <MonitorData> data;
    in property <[string]> span-choices;
    in property <[string]> scale-choices;
    callback span(int);callback scale(int);callback hold();callback follow();callback details();callback dismiss();
    forward-focus:monitor-keys;
    monitor-keys := FocusScope {
        width:parent.width;height:parent.height;
        // These controls have fixed choices; selectable text lives in Details.
        capture-key-pressed(event)=>{
            if !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift {
                if !event.modifiers.control && event.text==Key.PageDown {
                    monitor-scroll.content-y=max(min(0px,monitor-scroll.visible-height - monitor-scroll.content-height),monitor-scroll.content-y - monitor-scroll.visible-height);
                    return accept;
                }
                if !event.modifiers.control && event.text==Key.PageUp {
                    monitor-scroll.content-y=min(0px,monitor-scroll.content-y+monitor-scroll.visible-height);
                    return accept;
                }
                if event.modifiers.control && event.text==Key.Home {
                    monitor-scroll.content-x=0px;monitor-scroll.content-y=0px;
                    return accept;
                }
                if event.modifiers.control && event.text==Key.End {
                    monitor-scroll.content-x=min(0px,monitor-scroll.visible-width - monitor-scroll.content-width);
                    monitor-scroll.content-y=min(0px,monitor-scroll.visible-height - monitor-scroll.content-height);
                    return accept;
                }
            }
            return reject;
        }
    monitor-scroll := ScrollView {
        VerticalBox {padding:16px;
            MonitorPanel {max-height:self.preferred-height;data:root.data;span-choices:root.span-choices;scale-choices:root.scale-choices;ui-size:root.ui-size;span(i)=>{root.span(i);}scale(i)=>{root.scale(i);}hold=>{root.hold();}follow=>{root.follow();}details=>{root.details();}collapse=>{root.dismiss();}}
        }
    }
    }
}
export component DetailsWindow inherits Window {
    in property <string> ui-family;in property <length> ui-size:13px;
    default-font-family:root.ui-family;default-font-size:root.ui-size;
    in property <string> heading;title:root.heading;
    in property <string> content;
    in property <bool> can-refresh;
    public function focus-close(){close.focus();}
    callback refresh-content();
    preferred-width:750px;preferred-height:600px;min-width:500px;min-height:350px;
    callback dismiss();
    FocusScope {
        key-pressed(e)=>{if e.text==Key.Escape{root.dismiss();return accept;}return reject;}
    VerticalBox {
        Text {text:root.heading;font-weight:700;vertical-stretch:0;}
        TextEdit {text:root.content;read-only:true;accessible-label:root.heading;}
        if root.can-refresh: Button {text:"Refresh diagnostics snapshot";clicked=>{root.refresh-content();}}
        close := Button {text:"Close";clicked=>{root.dismiss();}}
    }
}
}
export component AudioControlsWindow inherits Window {
    title:"Audio controls";
    in property <string> ui-family;in property <length> ui-size:13px;
    default-font-family:root.ui-family;default-font-size:root.ui-size;
    in property <string> source;in property <string> elapsed;in property <bool> active;
    min-width:max(320px,controls.min-width);
    min-height:controls.preferred-height;
    preferred-width:400px;preferred-height:max(150px,self.min-height);
    callback stop();
    controls := VerticalBox {
        padding:16px;spacing:8px;
        Text {min-width:0px;text:root.source;overflow:elide;accessible-label:root.source;}
        Text {text:root.elapsed;}
        Button {text:"Stop audio";enabled:root.active;clicked=>{root.stop();}}
    }
}

export component MainWindow inherits Window {
    title: "Auditory Lab";
    in-out property <bool> edits-suspended:false;
    in-out property <bool> monitor-open:true;
    in property <bool> native-mac: false;
    in property <string> draft-brief;
    // The open document's binding; field callbacks carry the binding they rendered with.
    in property <int> document;
    in property <int> document-reset;
    in property <MetadataRow> title-field;
    in property <MetadataRow> summary-field;
    in property <MetadataRow> duration-field;
    in property <MetadataRow> fade-field;
    in property <[ComponentRow]> components;
    in property <[ModelLane]> model-lanes;
    in property <[string]> ears-choices;
    in property <[string]> carrier-choices;
    in property <[string]> add-choices;
    in property <[string]> modulation-choices;
    in property <[string]> span-choices;
    in property <[string]> scale-choices;
    callback stage-parameter(int, ParameterKey, string);
    callback commit-parameter(int, ParameterKey, string);
    callback restore-parameter(int, ParameterKey);
    callback slide(int, ParameterKey, float);
    callback stage-metadata(int, MetadataKey, string);
    callback commit-metadata(int, MetadataKey, string);
    callback restore-metadata(int, MetadataKey);
    callback set-ears(int, int);
    callback set-carrier(int, int);
    callback set-modulation(int, int);
    callback remove-component(int);
    callback add-component(int, int);

    in property <string> output-state;
    in property <string> receipt-age;
    in property <string> capture-duration;
    in property <string> motion-reason;
    in property <bool> motion-overridden;
    in-out property <length> monitor-height:270px;
    // TabWidget does not expose its tab-strip metrics. Reserve three text rows,
    // the outer layout's padding and 280px of document space beside measured chrome.
    property <length> available-monitor-height:0px;
    property <length> minimum-monitor-height: max(240px, drawer-content.preferred-height);
    property <length> maximum-monitor-height: min(360px, root.available-monitor-height);
    out property <bool> drawer-fits: root.minimum-monitor-height <= root.maximum-monitor-height && drawer-content.min-width <= root.width - workspace-layout.padding-left - workspace-layout.padding-right;
    out property <length> effective-drawer-height: max(root.minimum-monitor-height, min(root.monitor-height, root.maximum-monitor-height));
    function update-monitor-layout(){
        // Snapshot viewport space on layout changes to avoid feeding the window's
        // inferred minimum height back into its own layout constraint binding.
        root.available-monitor-height=max(0px, root.height - toolbar.preferred-height - transport.preferred-height - root.ui-size*3 - 16px - 280px);
        root.window-changed();
    }
    changed drawer-fits=>{root.update-monitor-layout();}
    changed height=>{root.update-monitor-layout();}
    changed monitor-height=>{root.update-monitor-layout();}
    public function resize-monitor(pixels:float){root.monitor-height=max(240px,min(360px,pixels*1px));}
    public function focus-monitor-opener(){monitor-opener.focus();}
    out property <MonitorData> monitor-data:{state:root.output-state,age:root.receipt-age,caption:root.waveform-caption,meters:root.meters,warning:root.monitor-warning,warninglive:root.monitor-warning-live,backendwarning:root.backend-warning,motion:root.motion-reason,left:root.left-path,right:root.right-path,limit:root.scale-label,spanlabel:root.capture-duration,spanchoice:root.window-index,scalechoice:root.scale-index,held:root.held,overridden:root.motion-overridden};
    callback show-diagnostics();
    callback show-research();
    callback hold-changed();
    callback follow-motion();
    in property <string> waveform-caption;
    in property <string> scale-label: "1";
    in property <string> model-caption;
    in property <string> monitor-warning;
    in property <bool> monitor-warning-live;
    in property <string> backend-warning;
    in property <string> typography-origin;
    in-out property <int> scale-index: 1;
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 1100px;
    preferred-height: 900px;
    min-width: 680px;
    min-height: 700px;
    in property <[StandardListViewItem]> catalog;
    in-out property <int> selected: 0;
    in property <string> sound-title;
    in property <string> studied;
    in property <bool> can-open-study;
    callback open-study();
    in property <string> recipe-timing;
    in property <[string]> export-rates;
    in property <string> summary;
    in property <string> structure;
    in property <string> details;
    in property <string> guidance;
    in property <string> status;
    in property <string> file-activity;
    in property <bool> busy;
    in property <bool> exporting;
    callback cancel-file();
    in property <bool> playback-busy;
    in property <bool> transport-enabled;
    in property <string> transport-action;
    in property <[string]> transport-labels;
    in property <bool> can-edit;
    in property <bool> can-add-component;
    in property <string> add-reason;
    in property <bool> can-export;
    in property <bool> can-play;
    in property <bool> can-save;
    in property <bool> dirty;
    in property <string> based-on;
    in property <string> based-on-title;
    in property <string> retained-warning;
    in property <string> player-title;
    in property <string> play-target;
    in property <string> generated;
    in property <string> generated-details;
    in property <string> monitor-state;
    in property <string> meters;
    in property <string> device;

    in property <string> elapsed;
    in property <float> progress;
    in property <string> left-path;
    in property <string> right-path;
    in-out property <length> editor-scroll-y;
    in property <string> metadata-error;
    in property <string> save-reason;
    in property <string> export-reason;
    in property <string> play-reason;
    in property <string> peak;
    in-out property <int> tab-index: 0;
    in-out property <int> window-index: 2;
    in-out property <int> rate-index: 1;
    in-out property <bool> research: false;
    in-out property <bool> held: false;
    in-out property <bool> notes: false;
    in-out property <bool> saved-audio: false;
    in-out property <bool> library-detail: false;
    in-out property <bool> export-settings: false;
    in-out property <length> sidebar-width: 330px;
    public function resize-library-pane(pixels:float) {
        root.sidebar-width=max(230px,min(500px,pixels*1px));
    }
    in-out property <string> query;
    in property <bool> has-results;
    in-out property <bool> compact: false;
    changed ui-size => {root.compact = root.width < root.ui-size*70;root.update-monitor-layout();}
    changed width => {
        root.compact = self.width < root.ui-size*70;
        root.update-monitor-layout();
    }
    callback select(int);
    callback search(string);
    callback open-recipe();
    callback play-stop();
    callback stop-audio();
    callback play-recipe();
    callback preview-selected();
    callback export-wav();
    callback about();
    callback based-on-source();
    callback quit();
    callback rate-changed(int);
    callback window-changed();
    callback tab-changed(int);
    callback open-workbench();
    callback new-draft();
    callback save-recipe();
    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New Sound";
                activated => {
                    root.new-draft();
                }
            }
            MenuItem {
                title: "Open Recipe…";
                enabled: !root.busy;
                activated => {
                    root.open-recipe();
                }
            }
            MenuItem {
                title: "Save sound…";
                enabled: !root.busy && root.can-save && root.tab-index == 1;
                activated => {
                    root.save-recipe();
                }
            }
            MenuItem {
                title: "Export WAV…";
                enabled: !root.busy && root.can-export;
                activated => {
                    root.export-wav();
                }
            }
            MenuItem {title:"Stop audio";enabled:root.playback-busy;activated=>{root.stop-audio();}}
            MenuItem {
                title: "Quit";
                activated => {
                    root.quit();
                }
            }
        }
        if !root.native-mac: Menu {
            title: "Help";
            MenuItem {
                title: "About Auditory Lab";

                activated => {
                    root.about();
                }
            }
        }
    }
    workspace-layout := VerticalBox {
        spacing: 0px;
        toolbar := HorizontalBox {
            changed preferred-height=>{root.update-monitor-layout();}
            vertical-stretch:0;
            min-height:root.ui-size*3;
            padding:4px;
            Text {text:"Auditory Lab";font-weight:600;vertical-alignment:center;}
            Rectangle {horizontal-stretch:1;}
            // Left of the lasting controls, so a late press on Cancel export
            // lands in the space it leaves rather than on another control.
            if root.exporting: ProgressIndicator {progress:root.progress;accessible-label:"WAV export progress";max-width:120px;}
            if root.exporting: Button {text:"Cancel export";clicked=>{root.cancel-file();}}
            if root.status != "": Button {text:"Task details…";clicked=>{root.show-diagnostics();}}
            if root.tab-index==1: Button {text:"Save sound…";enabled:!root.busy && root.can-save;accessible-description:root.save-reason;clicked=>{root.save-recipe();}}
            monitor-opener := StableButton {
                text:root.monitor-open ? "Hide monitor" : "Show monitor";
                labels:["Hide monitor","Show monitor"];
                accessible-name:(root.monitor-open ? "Hide output monitor" : "Show output monitor");expanded:root.monitor-open;
                clicked=>{root.monitor-open=!root.monitor-open;root.window-changed();}
            }
        }
        TabWidget {
            min-height:0px;
            current-index <=> root.tab-index;
            changed current-index => {
                root.tab-changed(self.current-index);
            }
            Tab {
                title: "Library";
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 1;
                    if !root.compact || !root.library-detail: VerticalBox {
                        preferred-width: !root.compact ? root.sidebar-width : 600px;
                        max-width: !root.compact ? root.sidebar-width : 3000px;
                        Text {
                            text: "Find a recipe";
                            vertical-stretch: 0;
                        }
                        LineEdit {
                            text <=> root.query;
                            placeholder-text: "Title, ID, sound or study topic";
                            accessible-label: "Find a recipe";
                            edited(value) => {
                                root.search(value);
                            }
                        }
                        if !root.has-results: Text {
                            text: "No matching recipes";
                        }
                        if root.query != "": Button {
                            text: "Clear search";
                            clicked => {
                                root.query="";
                                root.search("");
                            }
                        }
                        catalog-scroll := ScrollView {
                            VerticalBox {
                                spacing: 4px;
                                for item[index] in root.catalog: catalog-row := Rectangle {
                                    property <bool> selected-row: root.selected==index;
                                    // A row created already selected, such as a new import,
                                    // reveals itself once it has been laid out.
                                    initial-reveal := Timer {
                                        interval: 1ms;
                                        running: catalog-row.selected-row;
                                        triggered => {
                                            self.running = false;
                                            catalog-row.reveal();
                                        }
                                    }
                                    function reveal() {
                                        if self.selected-row {
                                            if self.y + catalog-scroll.content-y < 0px {catalog-scroll.content-y=-self.y;}
                                            else if self.y+self.height+catalog-scroll.content-y > catalog-scroll.visible-height {catalog-scroll.content-y=catalog-scroll.visible-height - self.y - self.height;}
                                        }
                                    }
                                    changed selected-row => {self.reveal();}
                                    changed y => {self.reveal();}
                                    changed height => {self.reveal();}

                                    height: max(root.ui-size*4.5, label.preferred-height + 16px);
                                    background: root.selected == index ? Palette.selection-background : Palette.control-background;
                                    border-width: focus.has-focus ? 2px : 0px;
                                    border-color: root.selected == index ? Palette.accent-background : Palette.border;
                                    accessible-role: button;
                                    accessible-label: item.text;
                                    accessible-action-default => {
                                        touch.clicked();
                                    }
                                    label := Text {min-width:0px;
                                        x: 10px;
                                        y: 10px;
                                        width: parent.width - 20px;
                                        text: item.text;
                                        wrap: word-wrap;
                                        color: root.selected == index ? Palette.selection-foreground : Palette.control-foreground;
                                    }
                                    focus := FocusScope {
                                        key-pressed(event) => {
                                            if event.text == "\n" || event.text == " " {
                                                root.select(index);
                                                root.library-detail=true;
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                    // Above the focus scope, so a pointer press reaches it.
                                    touch := TouchArea {
                                        clicked => {
                                            focus.focus();
                                            root.select(index);
                                            root.library-detail=true;
                                        }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }
                            }
                        }
                        Button {
                            text: "Open Recipe…";
                            enabled: !root.busy;
                            clicked => {
                                root.open-recipe();
                            }
                        }
                    }
                    if !root.compact: Rectangle {
                        width: 6px;
                        background: resize-touch.has-hover || resize-focus.has-focus ? Palette.accent-background : Palette.border;
                        accessible-role: slider;
                        accessible-label: "Library pane width";
                        accessible-value: root.sidebar-width / 1px;
                        accessible-value-minimum: 230;
                        accessible-value-maximum: 500;
                        accessible-value-step: 16;
                        accessible-action-set-value(v) => {
                            if v.is-float() {
                                root.resize-library-pane(v.to-float());
                            }
                        }
                        accessible-action-increment => {
                            root.resize-library-pane(root.sidebar-width/1px + 16);
                        }
                        accessible-action-decrement => {
                            root.resize-library-pane(root.sidebar-width/1px - 16);
                        }
                        forward-focus: resize-focus;
                        resize-focus := FocusScope {
                            key-pressed(event)=> {
                                if event.text==Key.LeftArrow {
                                    root.resize-library-pane(root.sidebar-width/1px - 16);
                                    return accept;
                                }
                                if event.text==Key.RightArrow {
                                    root.resize-library-pane(root.sidebar-width/1px + 16);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        // Above the focus scope, so a pointer press reaches it.
                        resize-touch := TouchArea {
                            mouse-cursor:col-resize;
                            clicked=> {
                                resize-focus.focus();
                            }
                            moved=> {
                                if self.pressed {
                                    root.resize-library-pane((root.sidebar-width + self.mouse-x - self.pressed-x)/1px);
                                }
                            }
                        }
                    }
                    if !root.compact || root.library-detail: detail-scroll := ScrollView {
                        // Follow the visible width so long text wraps rather than widening the page.
                        VerticalBox {
                            width: detail-scroll.visible-width;
                            spacing: 10px;
                            if root.compact: Button {
                                text:"Back to recipes";
                                clicked => {
                                    root.library-detail=false;
                                }
                            }
                            if root.status != "": Text {min-width:0px;text:root.status;wrap:word-wrap;vertical-stretch:0;accessible-live-region:polite;}
                            if root.file-activity != "": Text {min-width:0px;text:root.file-activity;wrap:word-wrap;vertical-stretch:0;}
                            if !root.has-results: Text {min-width:0px;
                                text:"No recipe matches “" + root.query + "”. Clear the search to see every recipe.";
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            if root.has-results: VerticalBox {
                                vertical-stretch: 0;
                                Text {min-width:0px;
                                    text:root.sound-title;
                                    font-size:root.ui-size*1.85;
                                    font-weight:600;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }

                                Text {min-width:0px;
                                    text:root.structure;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                // A custom recipe has no study or summary to show.
                                if root.studied != "": Text {min-width:0px;text:root.studied;wrap:word-wrap;vertical-stretch:0;}
                                Text {min-width:0px;
                                    text:root.recipe-timing;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                if root.summary != "": Text {min-width:0px;
                                    text:root.summary;
                                    wrap:word-wrap;
                                    vertical-stretch:0;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    vertical-stretch: 0;
                                    StableButton {
                                        text:root.playback-busy ? "Stop current & play recipe" : "Listen";
                                        labels:["Listen","Stop current & play recipe"];
                                        enabled:root.can-play && (!root.busy || root.playback-busy);
                                        clicked=> {
                                            root.play-recipe();
                                        }
                                    }
                                    Button {text:"Preview waveform";enabled:!root.playback-busy;clicked=>{root.preview-selected();}}
                                    Button {
                                        text:"Edit a copy";
                                        enabled:!root.busy;
                                        clicked=> {
                                            root.open-workbench();
                                        }
                                    }
                                    Button {
                                        text:"Export WAV…";
                                        enabled:!root.busy && root.can-export;
                                        clicked=> {
                                            root.export-wav();
                                        }
                                    }
                                }
                                Disclosure {label:"Research, citation and sound adaptations";expanded <=> root.research;}
                                if root.research && root.can-open-study: Button {text:"Open study source";clicked=>{root.open-study();}}
                                if root.research: Button {text:"Read selectable research and recipe details…";clicked=>{root.show-research();}}
                                library-pattern := Disclosure {label:"Pattern explained · static core model";}
                                if library-pattern.expanded: VerticalBox {
                                    vertical-stretch:0;
                                    Text {min-width:0px;text:root.model-caption;wrap:word-wrap;vertical-stretch:0;}
                                    for lane in root.model-lanes: VerticalBox {
                                        vertical-stretch:0;
                                        Text {min-width:0px;text:lane.label;wrap:word-wrap;vertical-stretch:0;}
                                        Rectangle {height:30px;background:Palette.control-background;
                                            accessible-role:image;accessible-label:lane.label+" static model";
                                            Path {width:parent.width;height:parent.height;viewbox-width:1024;viewbox-height:100;fit:fill;commands:lane.trace;stroke:Palette.accent-background;stroke-width:2px;}
                                        }
                                    }
                                }
                                Disclosure {label:"Export settings";expanded <=> root.export-settings;}
                                if root.export-settings: ExportRate {
                                    choices:root.export-rates;
                                    selected <=> root.rate-index;
                                    edit-enabled:!root.busy;
                                    changed(i)=> {
                                        root.rate-changed(i);
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch:1;
                            }
                        }
                    }
                }
            }
            Tab {
                title:"Workbench";
                editor-scroll := ScrollView {
                    content-y <=> root.editor-scroll-y;
                    // Follow the visible width so long text wraps rather than widening the page.
                    VerticalBox {
                    width: editor-scroll.visible-width;
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        Text {
                            text:root.title-field.label;
                            vertical-alignment:center;
                        }
                        MetadataField {
                            key: MetadataKey.title;
                            field: root.title-field;
                            binding: root.document;
                            reset-key:root.document-reset;
                            enabled:root.can-edit;
                            edits-suspended:root.edits-suspended;
                            accessible-label:"Sound title";
                            stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                            commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                            restore-field(owner, key) => { root.restore-metadata(owner, key); }
                        }
                    }
                    HorizontalBox {vertical-stretch:0;
                        Text {min-width:0px;
                            text:root.dirty ? "Unsaved changes" : "Unmodified draft";
                            wrap:word-wrap;vertical-alignment:center;horizontal-stretch:1;
                        }
                        Button {
                            horizontal-stretch:0;
                            text:"New";
                            enabled:root.can-edit;
                            clicked=> {
                                root.new-draft();
                            }
                        }
                    }
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        for label[index] in root.add-choices: Button {
                            text:label;
                            enabled:root.can-add-component;
                            accessible-description:root.add-reason;
                            clicked=> {
                                root.add-component(root.document, index);
                            }
                        }
                    }
                    if root.add-reason != "": Text {min-width:0px;text:root.add-reason;wrap:word-wrap;vertical-stretch:0;}
                    if root.retained-warning != "": Text {min-width:0px;
                        text:root.retained-warning;
                        color:Palette.foreground;
                        font-weight:700;
                        wrap:word-wrap;
                        vertical-stretch:0;
                        accessible-label:root.retained-warning;
                        accessible-live-region:polite;
                    }
                    if root.status != "": Text {min-width:0px;text:root.status;wrap:word-wrap;vertical-stretch:0;accessible-live-region:polite;}
                    if root.file-activity != "": Text {min-width:0px;text:root.file-activity;wrap:word-wrap;vertical-stretch:0;}
                    if root.metadata-error != "": Text {min-width:0px;text:root.metadata-error;wrap:word-wrap;vertical-stretch:0;accessible-live-region:polite;}
                    if root.save-reason != "": Text {min-width:0px;text:root.save-reason;wrap:word-wrap;vertical-stretch:0;}
                    Text {min-width:0px;text:root.draft-brief; font-size:root.ui-size*1.5; font-weight:600; wrap:word-wrap; vertical-stretch:0;}
                    if root.based-on-title != "": Text {min-width:0px;
                        text:root.based-on-title;
                        wrap:word-wrap;
                        font-size:root.ui-size*0.93;
                        vertical-stretch:0;
                    }
                    for row in root.components: VerticalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        Rectangle {
                            height:1px;
                            background:Palette.border;
                        }
                        Text {
                            text: row.heading;
                            font-weight: 700;
                            vertical-stretch: 0;
                        }
                        Text {min-width:0px;text:row.context; wrap:word-wrap; vertical-stretch:0;}
                        pattern := Disclosure {label:"Pattern explained · static core model";}
                        if pattern.expanded: VerticalBox {
                            vertical-stretch:0;
                            Text {min-width:0px;text:root.model-caption;wrap:word-wrap;vertical-stretch:0;}
                            VerticalBox {
                              padding:0px; spacing:0px; vertical-stretch:0;
                              for lane in root.model-lanes: VerticalBox {
                                padding:0px; spacing:0px; vertical-stretch:0;
                                if lane.component == row.id: VerticalBox {
                                  vertical-stretch:0;
                                  Text {min-width:0px;text:lane.label;wrap:word-wrap;vertical-stretch:0;}
                                  Rectangle {height:36px;background:Palette.control-background;
                                      accessible-role:image;accessible-label:lane.label+" static model, origin zero";
                                      Path {width:parent.width;height:parent.height;viewbox-width:1024;viewbox-height:100;fit:fill;commands:lane.trace;stroke:Palette.accent-background;stroke-width:2px;}
                                  }
                                }
                              }
                            }
                        }
                        component-options := Disclosure {label:"Routing, modulation and layer options";}
                        if component-options.expanded: VerticalBox {
                            padding: 0px;
                            vertical-stretch: 0;
                            Text { text: "Ears"; }
                            ComboBox {
                                enabled: root.can-edit;
                                model: root.ears-choices;
                                current-index: row.ears;
                                accessible-label: row.name + ": ears";
                                selected(value) => { root.set-ears(row.binding, self.current-index); }
                            }
                            Text { text: "Carrier"; }
                            ComboBox {
                                enabled: root.can-edit;
                                model: root.carrier-choices;
                                current-index: row.carrier;
                                accessible-label: row.name + ": carrier";
                                selected(value) => { root.set-carrier(row.binding, self.current-index); }
                            }
                            Text { text: "Modulation"; }
                            ComboBox {
                                enabled: root.can-edit;
                                model: root.modulation-choices;
                                current-index: row.modulation;
                                accessible-label: row.name + ": modulation";
                                selected(value) => { root.set-modulation(row.binding, self.current-index); }
                            }
                            Button {
                                text: "Remove";
                                enabled: root.can-edit;
                                accessible-label: "Remove " + row.name;
                                clicked => { root.remove-component(row.binding); }
                            }
                        }
                        for parameter in row.parameters: ParameterControl {
                            parameter: parameter;
                            owner: row.binding;
                            context: row.name;
                            compact: root.compact;
                            ui-size: root.ui-size;
                            edit-enabled: root.can-edit;
                            edits-suspended: root.edits-suspended;
                            stage(owner, key, value) => { root.stage-parameter(owner, key, value); }
                            commit(owner, key, value) => { root.commit-parameter(owner, key, value); }
                            restore(owner, key) => { root.restore-parameter(owner, key); }
                            slide(owner, key, value) => { root.slide(owner, key, value); }
                        }
                        if row.error != "": Text {min-width:0px;
                            text: row.error;
                            color: Palette.foreground;
                            accessible-live-region: polite;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                    }
                    Text {min-width:0px;
                        text:root.peak;
                        wrap:word-wrap;
                        vertical-stretch:0;
                    }
                    settings := Disclosure {label:"Sound settings · notes and saved/exported audio";}
                    if settings.expanded: VerticalBox {
                        vertical-stretch:0;
                        HorizontalLayout {
                            Button {
                                horizontal-stretch:0;
                                text:"Export WAV…";
                                enabled:!root.busy && root.can-export;
                                accessible-description:root.export-reason;
                                clicked=> {
                                    root.export-wav();
                                }
                            }
                            Rectangle {}
                        }
                        if !root.can-export && root.export-reason != "": Text {min-width:0px;text:root.export-reason;wrap:word-wrap;vertical-stretch:0;}
                        Disclosure {label:"Sound notes";expanded <=> root.notes;}
                        if root.notes: VerticalBox {
                            vertical-stretch:0;
                            if root.based-on != "": Text {min-width:0px;
                                text:root.based-on;
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            if root.based-on != "": Button {
                                text:"Show source recipe in Library";
                                clicked=> {
                                    root.based-on-source();
                                }
                            }
                            Text {
                                text:"Your notes about this sound";
                                vertical-stretch:0;
                            }
                            MetadataField {
                                key: MetadataKey.summary;
                                field: root.summary-field;
                                binding: root.document;
                                reset-key:root.document-reset;
                                enabled:root.can-edit;
                                edits-suspended:root.edits-suspended;
                                accessible-label:"Custom recipe notes";
                                stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                                commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                                restore-field(owner, key) => { root.restore-metadata(owner, key); }
                            }
                        }
                        Disclosure {label:"Saved audio · duration, fades and export rate";expanded <=> root.saved-audio;}
                        if root.saved-audio: VerticalBox {
                            vertical-stretch:0;
                            Text {min-width:0px;
                                text:"Live playback continues until Stop. These settings affect saved recipes and WAV export.";
                                wrap:word-wrap;
                                vertical-stretch:0;
                            }
                            HorizontalBox {
                                padding: 0px;
                                vertical-stretch: 0;
                                Text {
                                    text:root.duration-field.label;
                                    vertical-alignment:center;
                                }
                                MetadataField {
                                    key: MetadataKey.duration;
                                    field: root.duration-field;
                                    binding: root.document;
                                    reset-key:root.document-reset;
                                    enabled:root.can-edit;
                                    edits-suspended:root.edits-suspended;
                                    accessible-label:"Saved duration";
                                    horizontal-stretch:0;
                                    preferred-width:root.ui-size*10;
                                    stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                                    commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                                    restore-field(owner, key) => { root.restore-metadata(owner, key); }
                                }
                                Text {
                                    text:root.fade-field.label;
                                    vertical-alignment:center;
                                }
                                MetadataField {
                                    key: MetadataKey.fade;
                                    field: root.fade-field;
                                    binding: root.document;
                                    reset-key:root.document-reset;
                                    enabled:root.can-edit;
                                    edits-suspended:root.edits-suspended;
                                    accessible-label:"Saved fade";
                                    horizontal-stretch:0;
                                    preferred-width:root.ui-size*10;
                                    stage-field(owner, key, value) => { root.stage-metadata(owner, key, value); }
                                    commit-field(owner, key, value) => { root.commit-metadata(owner, key, value); }
                                    restore-field(owner, key) => { root.restore-metadata(owner, key); }
                                }
                                Rectangle {}
                            }
                            if root.duration-field.diagnostic != "": Text {min-width:0px;text:root.duration-field.diagnostic;wrap:word-wrap;vertical-stretch:0;}
                            if root.fade-field.diagnostic != "": Text {min-width:0px;text:root.fade-field.diagnostic;wrap:word-wrap;vertical-stretch:0;}
                            ExportRate {
                                choices:root.export-rates;
                                selected <=> root.rate-index;
                                edit-enabled:!root.busy;
                                changed(i)=> {
                                    root.rate-changed(i);
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch:1;
                    }
                    }
                }
            }
        }
        Rectangle {
            visible:root.monitor-open && root.drawer-fits;
            clip:true;
            preferred-height:self.visible ? root.effective-drawer-height : 0px;
            min-height:self.visible ? root.effective-drawer-height : 0px;
            max-height:self.visible ? root.effective-drawer-height : 0px;
            vertical-stretch:0;
            background:Palette.control-background;
            border-width:1px;border-color:Palette.border;
            drawer-content := VerticalBox {padding:8px;spacing:3px;
                Rectangle {
                    height:6px;background:grip-touch.has-hover || grip-focus.has-focus ? Palette.accent-background : Palette.border;
                    accessible-role:slider;accessible-label:"Output monitor height";
                    accessible-value:root.effective-drawer-height/1px;accessible-value-minimum:root.minimum-monitor-height/1px;accessible-value-maximum:max(root.minimum-monitor-height,root.maximum-monitor-height)/1px;accessible-value-step:16;
                    accessible-action-set-value(v)=>{if v.is-float(){root.resize-monitor(v.to-float());}}
                    accessible-action-increment=>{root.resize-monitor(root.effective-drawer-height/1px+16);}
                    accessible-action-decrement=>{root.resize-monitor(root.effective-drawer-height/1px-16);}
                    forward-focus:grip-focus;
                    grip-focus := FocusScope {key-pressed(e)=>{if e.text==Key.UpArrow{root.resize-monitor(root.effective-drawer-height/1px+16);return accept;}if e.text==Key.DownArrow{root.resize-monitor(root.effective-drawer-height/1px-16);return accept;}return reject;}}
                    grip-touch := TouchArea {mouse-cursor:row-resize;moved=>{if self.pressed{root.resize-monitor((root.effective-drawer-height + self.pressed-y - self.mouse-y)/1px);}}clicked=>{grip-focus.focus();}}
                }
                MonitorPanel {
                    data:root.monitor-data;ui-size:root.ui-size;
                    span-choices:root.span-choices;scale-choices:root.scale-choices;
                    span(i)=>{root.window-index=i;root.window-changed();}
                    scale(i)=>{root.scale-index=i;root.window-changed();}
                    hold=>{root.held=!root.held;root.hold-changed();}
                    follow=>{root.follow-motion();}
                    details=>{root.show-diagnostics();}
                    collapse=>{root.monitor-open=false;monitor-opener.focus();root.window-changed();}
                }
            }
        }
        transport := Rectangle {
            changed preferred-height=>{root.update-monitor-layout();}
            min-height:root.ui-size*5.5;max-height:root.ui-size*9;
            vertical-stretch:0;
            background:Palette.control-background;border-width:1px;border-color:Palette.border;
            VerticalBox {padding:8px;spacing:3px;
                HorizontalBox {vertical-stretch:0;padding:0px;
                    StableButton {text:root.transport-action;labels:root.transport-labels;primary:true;enabled:root.transport-enabled;accessible-name:root.transport-action+(root.playback-busy || root.play-target == "" ? "" : " · "+root.play-target);clicked=>{root.play-stop();}}
                    VerticalBox {padding:0px;spacing:2px;horizontal-stretch:1;
                        // One line each: the transport keeps its height; Details has the full text.
                        Text {min-width:0px;text:root.player-title+(root.playback-busy || root.play-target == "" ? "" : " · Next Play: "+root.play-target);wrap:no-wrap;overflow:elide;}
                        Text {min-width:0px;text:root.generated;wrap:no-wrap;overflow:elide;}
                    }
                    // Sized for the longest clock, so ticking never reflows the row.
                    Rectangle {
                        horizontal-stretch:0;
                        min-width:elapsed-template.preferred-width;
                        preferred-width:elapsed-template.preferred-width;
                        min-height:elapsed-text.preferred-height;
                        elapsed-template := Text {visible:false;text:"00:00:00 / 00:00:00";}
                        elapsed-text := Text {width:parent.width;height:parent.height;text:root.elapsed;horizontal-alignment:right;vertical-alignment:center;}
                    }
                    Button {text:"Details…";horizontal-stretch:0;accessible-label:"Audio details";clicked=>{root.show-diagnostics();}}
                }
                Text {min-width:0px;text:root.guidance;wrap:word-wrap;vertical-stretch:0;}
            }
        }
    }
}
