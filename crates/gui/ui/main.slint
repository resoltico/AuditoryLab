import { Dialogs } from "dialogs.slint";
import { LibraryPane } from "library-pane.slint";
import { WorkbenchPane } from "workbench-pane.slint";
import { TransportBar } from "transport.slint";
import { Button } from "button.slint";


import { WorkspaceNavigation } from "workspace-navigation.slint";
export { Terms } from "vocabulary.slint";
import { Terms } from "vocabulary.slint";
import { Palette, VerticalBox, HorizontalBox, ProgressIndicator } from "std-widgets.slint";
export { EntryAddress, LibraryMutationAction, CatalogRow, LibraryFacet, ParameterKey, MetadataKey, ParameterRow, ComponentRow, MetadataRow, ModelLane } from "models.slint";
import { EntryAddress, LibraryMutationAction, CatalogRow, LibraryFacet, ParameterKey, MetadataKey, ParameterRow, ComponentRow, MetadataRow, ModelLane } from "models.slint";
import { StableButton } from "editor.slint";
export { AboutWindow, LicenseWindow } from "about.slint";

export { MonitorWindow, DetailsWindow, AudioControlsWindow, MonitorData } from "monitor.slint";
import { MonitorPanel, MonitorData } from "monitor.slint";

export component MainWindow inherits Window {
    icon: @image-url("../../../artwork/auditorylab-icon/assets/runtime/window-icon.png");
    title: Terms.caption-product-name;
    in-out property <bool> edits-suspended:false;
    in-out property <bool> monitor-open:false;
    in property <bool> native-mac: false;
    in property <string> draft-brief;
    in property <string> draft-location;
    in property <string> draft-location-details;
    // The open document's binding; field callbacks carry the binding they rendered with.
    in property <string> document;
    in property <int> document-reset;
    in property <MetadataRow> title-field;
    in property <MetadataRow> summary-field;
    in property <MetadataRow> duration-field;
    in property <MetadataRow> fade-field;
    in property <[ComponentRow]> components;
    in property <[ModelLane]> model-lanes;
    in property <[string]> ears-choices;
    in property <[string]> carrier-choices;
    in property <[string]> add-choices;
    in property <string> add-binaural-label;
    in property <string> add-monaural-label;
    in property <[string]> modulation-choices;
    in property <[string]> span-choices;
    in property <[string]> scale-choices;
    callback stage-parameter(string, ParameterKey, string);
    callback commit-parameter(string, ParameterKey, string);
    callback restore-parameter(string, ParameterKey);
    callback slide(string, ParameterKey, float);
    callback stage-metadata(string, MetadataKey, string);
    callback commit-metadata(string, MetadataKey, string);
    callback restore-metadata(string, MetadataKey);
    callback set-ears(string, int);
    callback set-carrier(string, int);
    callback set-modulation(string, int);
    callback remove-component(string);
    callback restore-component(string);
    callback add-component(string, int);
    function open-component-menu(){dialogs.open-component-menu();}

    in property <string> output-state;
    in property <string> receipt-age;
    in property <string> capture-duration;
    in property <string> motion-reason;
    in property <bool> motion-overridden;
    in-out property <length> monitor-height:270px;
    // The native tabs share the toolbar. Reserve padding and 280px of
    // document space beside the measured header and transport.
    property <length> available-monitor-height:0px;
    property <length> minimum-monitor-height: max(240px, drawer-content.preferred-height);
    property <length> maximum-monitor-height: min(360px, root.available-monitor-height);
    out property <bool> drawer-fits: root.minimum-monitor-height <= root.maximum-monitor-height && drawer-content.min-width <= root.width - workspace-layout.padding-left - workspace-layout.padding-right;
    out property <length> effective-drawer-height: max(root.minimum-monitor-height, min(root.monitor-height, root.maximum-monitor-height));
    function update-monitor-layout(){
        // Snapshot viewport space on layout changes to avoid feeding the window's
        // inferred minimum height back into its own layout constraint binding.
        root.available-monitor-height=max(0px, root.height - toolbar.preferred-height - transport.preferred-height - 16px - 280px);
        root.window-changed();
    }
    changed drawer-fits=>{root.update-monitor-layout();}
    changed height=>{root.update-monitor-layout();}
    changed monitor-height=>{root.update-monitor-layout();}
    public function resize-monitor(pixels:float){root.monitor-height=max(240px,min(360px,pixels*1px));}
    public function focus-monitor-opener(){monitor-opener.focus-button();}
    out property <MonitorData> monitor-data:{state:root.output-state,age:root.receipt-age,caption:root.waveform-caption,meters:root.meters,warning:root.monitor-warning,warninglive:root.monitor-warning-live,backendwarning:root.backend-warning,motion:root.motion-reason,left:root.left-path,right:root.right-path,limit:root.scale-label,spanlabel:root.capture-duration,spanchoice:root.window-index,scalechoice:root.scale-index,held:root.held,overridden:root.motion-overridden};
    callback show-diagnostics();
    callback show-research();
    callback hold-changed();
    callback follow-motion();
    in property <string> waveform-caption;
    in property <string> scale-label: "1";
    in property <string> model-caption;
    in property <string> monitor-warning;
    in property <bool> monitor-warning-live;
    in property <string> backend-warning;
    in property <string> typography-origin;
    in-out property <int> scale-index;
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 1280px;
    preferred-height: 900px;
    min-width: 680px;
    min-height: 600px;
    in property <[CatalogRow]> catalog;
    in property <[LibraryFacet]> band-navigation;
    in property <string> library-classification;
    in property <string> library-ownership;
    in property <string> library-overview;
    in property <string> library-empty-message;
    in property <bool> library-filters-active;
    in-out property <bool> library-wide: false;
    out property <bool> library-tools-open: dialogs.library-tools-open;
    out property <bool> library-query-open: dialogs.library-query-open;
    public function open-query-details(){dialogs.open-query-details();}
    public function close-query-details(){dialogs.close-query-details();}
    public function open-library-filters(){dialogs.open-library-filters();}
    public function close-library-filters(){dialogs.close-library-filters();}
    in-out property <int> selected: 0;
    in property <string> sound-title;
    in property <string> studied;
    in property <bool> can-open-study;
    callback open-study();
    in property <string> recipe-timing;
    in property <[string]> export-rates;
    in property <string> summary;
    in property <string> structure;
    in property <string> details;
    in property <string> guidance;
    in property <string> status;
    in property <string> operation-summary;
    in property <string> operation-outcome;
    in property <string> auxiliary-error;
    in property <string> copy-reason;
    in property <string> file-activity;
    in property <bool> exporting;
    callback cancel-file();
    in property <bool> playback-busy;
    in property <bool> transport-enabled;
    in property <string> transport-action;
    in property <[string]> transport-labels;
    in property <bool> can-edit;
    in property <bool> can-add-component;
    in property <bool> can-add-pair;
    in property <string> pair-add-reason;
    in property <string> add-reason;
    in property <string> removed-component;
    in property <bool> can-restore-component;
    in property <bool> can-export;
    in property <bool> can-play;
    in property <string> library-play-action;
    in property <bool> can-import;
    in property <bool> can-manage-library;
    in property <bool> can-add-to-library;
    in property <bool> can-request-trash;
    in property <bool> can-new;
    in property <bool> can-copy;
    in property <bool> can-preview;
    in property <bool> can-save;
    in property <bool> can-save-copy;
    in property <bool> can-export-recipe;
    in property <bool> dirty;
    in property <string> based-on;
    in property <string> based-on-title;
    in property <string> retained-warning;
    in property <string> player-title;
    in property <string> play-target;
    in property <string> generated;
    in property <string> generated-details;
    in property <string> monitor-state;
    in property <string> meters;
    in property <string> device;

    in property <string> elapsed;
    in property <float> progress;
    in property <string> left-path;
    in property <string> right-path;
    in-out property <length> editor-scroll-y;
    in property <string> metadata-error;
    in property <string> save-reason;
    in property <string> export-reason;
    in property <string> play-reason;
    in property <string> peak;
    in-out property <int> tab-index: 0;
    in-out property <int> window-index;
    in-out property <int> rate-index: 1;
    in-out property <bool> research: false;
    in-out property <bool> held: false;
    in-out property <bool> notes: false;
    in-out property <bool> saved-audio: false;
    in-out property <bool> library-detail: false;
    in-out property <length> library-scroll-y: 0px;
    in-out property <bool> export-settings: false;
    in-out property <length> sidebar-width: 330px;
    public function resize-library-pane(pixels:float) {
        root.sidebar-width=max(230px,min(500px,pixels*1px));
    }
    in-out property <string> query;
    in property <bool> has-results;
    in-out property <bool> compact: false;
    changed ui-size => {root.compact = root.width < root.ui-size*70;root.library-wide = root.width >= root.ui-size*90;root.update-monitor-layout();}
    changed width => {
        root.compact = self.width < root.ui-size*70;
        root.library-wide = self.width >= root.ui-size*90;
        root.update-monitor-layout();
    }
    callback select(EntryAddress);
    callback navigate-library(int);
    in-out property <string> focused-library-key;
    in property <EntryAddress> library-entry;
    in property <string> library-key;
    in property <string> library-token;
    in property <bool> library-trashed;
    in property <string> library-status;
    in property <string> library-alert;
    in-out property <bool> storage-open:false;
    callback collection-filter(int, int);
    in property <string> library-count;
    in property <string> calendar-context;
    in property <[string]> band-labels;
    in property <[string]> method-labels;
    callback more-filters(string, int, int, int, int, int, string, string, string, string, string, string);
    callback clear-library-filters();
    callback reset-library-sort();
    function clear-applied-filters(){dialogs.clear-applied-filters();}
    in-out property <string> study-query;
    in-out property <int> population-choice:0;
    in-out property <int> role-choice:0;
    in-out property <int> analysis-choice:0;
    in-out property <int> direction-choice:0;
    in-out property <int> group-choice:0;
    in-out property <string> created-from;
    in-out property <string> created-through;
    in-out property <string> modified-from;
    in-out property <string> modified-through;
    in-out property <string> added-from;
    in-out property <string> added-through;


    in property <[string]> collection-labels;
    in property <[string]> sort-labels;
    in property <[string]> population-labels;
    in property <[string]> role-labels;
    in property <[string]> analysis-labels;
    in property <[string]> direction-labels;
    in property <[string]> group-labels;

    in-out property <int> collection-choice: 0;
    in-out property <int> sort-choice: 0;
    callback worker-ready();
    callback refresh-library();
    callback initialize-library();
    callback edit-saved(EntryAddress);
    callback save-copy();
    in property <string> library-dates;
    in property <string> library-dates-utc;
    callback add-to-library(EntryAddress);
    callback show-saved();
    callback library-action(EntryAddress, LibraryMutationAction, string);
    callback search(string);
    callback rhythm-filter(int, int);
    in-out property <int> band-choice: 0;
    in-out property <int> method-choice: 0;
    callback open-recipe();
    callback play-stop();
    callback stop-audio();
    callback play-recipe();
    callback preview-selected();
    callback export-wav();
    callback export-recipe();
    callback close-open-file(EntryAddress);
    callback about();
    callback based-on-source();
    callback quit();
    callback rate-changed(int);
    callback window-changed();
    callback tab-changed(int);
    callback open-workbench();
    callback new-draft();
    callback save-recipe();
    dialogs := Dialogs {
        window-width:root.width;window-height:root.height;toolbar-height:toolbar.height;
        add-choices: root.add-choices;
        add-binaural-label:root.add-binaural-label;
        add-monaural-label:root.add-monaural-label;
        add-component(arg0, arg1) => {root.add-component(arg0, arg1);}
        add-reason: root.add-reason;
        added-from <=> root.added-from;
        added-through <=> root.added-through;
        analysis-choice <=> root.analysis-choice;
        analysis-labels: root.analysis-labels;
        band-choice <=> root.band-choice;
        calendar-context: root.calendar-context;
        can-add-component: root.can-add-component;
        can-add-pair: root.can-add-pair;
        can-import: root.can-import;
        can-manage-library: root.can-manage-library;
        clear-library-filters() => {root.clear-library-filters();}
        collection-choice <=> root.collection-choice;
        collection-filter(arg0, arg1) => {root.collection-filter(arg0, arg1);}
        compact <=> root.compact;
        created-from <=> root.created-from;
        created-through <=> root.created-through;
        direction-choice <=> root.direction-choice;
        direction-labels: root.direction-labels;
        document: root.document;
        group-choice <=> root.group-choice;
        group-labels: root.group-labels;
        initialize-library() => {root.initialize-library();}
        library-alert: root.library-alert;
        library-count: root.library-count;
        library-status: root.library-status;
        method-choice <=> root.method-choice;
        method-labels: root.method-labels;
        modified-from <=> root.modified-from;
        modified-through <=> root.modified-through;
        more-filters(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9, arg10, arg11) => {root.more-filters(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9, arg10, arg11);}
        open-recipe() => {root.open-recipe();}
        pair-add-reason: root.pair-add-reason;
        population-choice <=> root.population-choice;
        population-labels: root.population-labels;
        query <=> root.query;
        refresh-library() => {root.refresh-library();}
        reset-library-sort() => {root.reset-library-sort();}
        rhythm-filter(arg0, arg1) => {root.rhythm-filter(arg0, arg1);}
        role-choice <=> root.role-choice;
        role-labels: root.role-labels;
        show-saved() => {root.show-saved();}
        sort-choice <=> root.sort-choice;
        sort-labels: root.sort-labels;
        storage-open <=> root.storage-open;
        study-query <=> root.study-query;
        ui-size: root.ui-size;
    }
    MenuBar {
        Menu {
            title: Terms.caption-file;
            MenuItem {
                title: Terms.operation-new-sound;
                enabled: root.can-new;
                activated => {
                    root.new-draft();
                }
            }
            MenuItem {
                title: (Terms.operation-open-recipe + "…");
                enabled: root.can-import;
                activated => {
                    root.open-recipe();
                }
            }
            MenuItem {
                title: Terms.operation-save;
                enabled: root.can-save && root.tab-index == 1;
                activated => {
                    root.save-recipe();
                }
            }
            MenuItem {title:Terms.operation-save-copy;enabled:root.can-save-copy && root.tab-index==1;activated=>{root.save-copy();}}
            MenuItem {title:(Terms.operation-export-recipe + "…");enabled:root.can-export-recipe;activated=>{root.export-recipe();}}
            MenuItem {
                title: (Terms.operation-export + "…");
                enabled: root.can-export;
                activated => {
                    root.export-wav();
                }
            }
            MenuItem {title:root.library-play-action;enabled:root.tab-index==0 && root.can-play;activated=>{root.play-recipe();}}
            MenuItem {title:Terms.operation-stop;enabled:root.playback-busy;activated=>{root.stop-audio();}}
            MenuItem {
                title: Terms.action-quit;
                activated => {
                    root.quit();
                }
            }
        }
        if !root.native-mac: Menu {
            title: Terms.caption-help;
            MenuItem {
                title: Terms.caption-about-product;

                activated => {
                    root.about();
                }
            }
        }
    }

    workspace-layout := VerticalBox {
        spacing: 0px;
        toolbar := HorizontalBox {
            changed preferred-height=>{root.update-monitor-layout();}
            vertical-stretch:0;
            min-height:root.ui-size*3;
            padding:4px;
            WorkspaceNavigation {
                current <=> root.tab-index;
                text-size:root.ui-size;
                selected(index)=>{root.tab-changed(index);}
            }
            Rectangle {horizontal-stretch:1;}
            if root.tab-index==0: Button {text:Terms.caption-library-options;triggered =>{dialogs.open-library-options();}}
            // Left of the lasting controls, so a late press on Cancel export
            // lands in the space it leaves rather than on another control.
            if root.exporting: ProgressIndicator {progress:root.progress;accessible-label:Terms.caption-wav-export-progress;max-width:120px;}
            if root.exporting: Button {text:Terms.operation-cancel-export;triggered =>{root.cancel-file();}}
            if root.status != "" || root.auxiliary-error != "": Button {text:Terms.caption-task-details-dialog;triggered =>{root.show-diagnostics();}}
            if root.tab-index==1: Button {text:Terms.operation-save;enabled:root.can-save;accessible-description:root.save-reason;triggered =>{root.save-recipe();}}
            monitor-opener := StableButton {
                text:root.monitor-open ? Terms.action-hide-monitor : Terms.action-show-monitor;
                labels:[Terms.action-hide-monitor,Terms.action-show-monitor];
                accessible-name:(root.monitor-open ? Terms.action-hide-output-monitor : Terms.action-show-output-monitor);expanded:root.monitor-open;
                clicked=>{root.monitor-open=!root.monitor-open;root.window-changed();}
            }
        }
        Rectangle {
            min-height:0px;
            library-page := LibraryPane {
                width:parent.width;height:parent.height;
                add-to-library(arg0) => { root.add-to-library(arg0); }
                band-choice <=> root.band-choice;
                band-labels: root.band-labels;
                band-navigation: root.band-navigation;
                can-add-to-library: root.can-add-to-library;
                can-copy: root.can-copy;
                can-export: root.can-export;
                can-export-recipe: root.can-export-recipe;
                can-import: root.can-import;
                can-manage-library: root.can-manage-library;
                can-new: root.can-new;
                can-open-study: root.can-open-study;
                can-preview: root.can-preview;
                can-request-trash: root.can-request-trash;
                catalog: root.catalog;
                clear-applied-filters() => { root.clear-applied-filters(); }
                close-open-file(arg0) => { root.close-open-file(arg0); }
                collection-choice <=> root.collection-choice;
                collection-filter(arg0, arg1) => { root.collection-filter(arg0, arg1); }
                collection-labels: root.collection-labels;
                compact <=> root.compact;
                copy-reason: root.copy-reason;
                edit-saved(arg0) => { root.edit-saved(arg0); }
                export-rates: root.export-rates;
                export-recipe() => { root.export-recipe(); }
                export-settings <=> root.export-settings;
                export-wav() => { root.export-wav(); }
                file-activity: root.file-activity;
                focused-library-key <=> root.focused-library-key;
                has-results: root.has-results;
                library-action(arg0, arg1, arg2) => { root.library-action(arg0, arg1, arg2); }
                library-alert: root.library-alert;
                library-classification: root.library-classification;
                library-dates: root.library-dates;
                library-dates-utc: root.library-dates-utc;
                library-detail <=> root.library-detail;
                library-empty-message: root.library-empty-message;
                library-filters-active: root.library-filters-active;
                library-entry:root.library-entry;
                library-key: root.library-key;
                library-overview: root.library-overview;
                library-ownership: root.library-ownership;
                library-query-open: root.library-query-open;
                library-scroll-y <=> root.library-scroll-y;
                library-token: root.library-token;
                library-trashed: root.library-trashed;
                library-wide <=> root.library-wide;
                method-choice <=> root.method-choice;
                method-labels: root.method-labels;
                model-caption: root.model-caption;
                model-lanes: root.model-lanes;
                navigate-library(arg0) => { root.navigate-library(arg0); }
                new-draft() => { root.new-draft(); }
                open-library-filters() => { root.open-library-filters(); }
                open-query-details() => { root.open-query-details(); }
                open-recipe() => { root.open-recipe(); }
                open-study() => { root.open-study(); }
                open-workbench() => { root.open-workbench(); }
                preview-selected() => { root.preview-selected(); }
                query <=> root.query;
                rate-changed(arg0) => { root.rate-changed(arg0); }
                rate-index <=> root.rate-index;
                recipe-timing: root.recipe-timing;
                research <=> root.research;
                resize-library-pane(arg0) => { root.resize-library-pane(arg0); }
                rhythm-filter(arg0, arg1) => { root.rhythm-filter(arg0, arg1); }
                search(arg0) => { root.search(arg0); }
                select(arg0) => { root.select(arg0); }
                selected <=> root.selected;
                show-research() => { root.show-research(); }
                sidebar-width <=> root.sidebar-width;
                sort-choice <=> root.sort-choice;
                sort-labels: root.sort-labels;
                sound-title: root.sound-title;
                structure: root.structure;
                studied: root.studied;
                summary: root.summary;
                tab-index <=> root.tab-index;
                ui-size: root.ui-size;
            }
            WorkbenchPane {
                width:parent.width;height:parent.height;
                add-reason: root.add-reason;
                based-on: root.based-on;
                based-on-source() => { root.based-on-source(); }
                based-on-title: root.based-on-title;
                can-edit: root.can-edit;
                can-export: root.can-export;
                can-export-recipe: root.can-export-recipe;
                can-new: root.can-new;
                can-restore-component: root.can-restore-component;
                carrier-choices: root.carrier-choices;
                commit-metadata(arg0, arg1, arg2) => { root.commit-metadata(arg0, arg1, arg2); }
                commit-parameter(arg0, arg1, arg2) => { root.commit-parameter(arg0, arg1, arg2); }
                compact <=> root.compact;
                components: root.components;
                dirty: root.dirty;
                document: root.document;
                document-reset: root.document-reset;
                draft-brief: root.draft-brief;
                draft-location: root.draft-location;
                draft-location-details: root.draft-location-details;
                duration-field: root.duration-field;
                ears-choices: root.ears-choices;
                editor-scroll-y <=> root.editor-scroll-y;
                edits-suspended <=> root.edits-suspended;
                export-rates: root.export-rates;
                export-reason: root.export-reason;
                export-recipe() => { root.export-recipe(); }
                export-wav() => { root.export-wav(); }
                fade-field: root.fade-field;
                file-activity: root.file-activity;
                metadata-error: root.metadata-error;
                model-caption: root.model-caption;
                model-lanes: root.model-lanes;
                modulation-choices: root.modulation-choices;
                new-draft() => { root.new-draft(); }
                notes <=> root.notes;
                open-component-menu() => { root.open-component-menu(); }
                pair-add-reason: root.pair-add-reason;
                peak: root.peak;
                rate-changed(arg0) => { root.rate-changed(arg0); }
                rate-index <=> root.rate-index;
                remove-component(arg0) => { root.remove-component(arg0); }
                removed-component: root.removed-component;
                restore-component(arg0) => { root.restore-component(arg0); }
                restore-metadata(arg0, arg1) => { root.restore-metadata(arg0, arg1); }
                restore-parameter(arg0, arg1) => { root.restore-parameter(arg0, arg1); }
                retained-warning: root.retained-warning;
                save-reason: root.save-reason;
                saved-audio <=> root.saved-audio;
                set-carrier(arg0, arg1) => { root.set-carrier(arg0, arg1); }
                set-ears(arg0, arg1) => { root.set-ears(arg0, arg1); }
                set-modulation(arg0, arg1) => { root.set-modulation(arg0, arg1); }
                slide(arg0, arg1, arg2) => { root.slide(arg0, arg1, arg2); }
                stage-metadata(arg0, arg1, arg2) => { root.stage-metadata(arg0, arg1, arg2); }
                stage-parameter(arg0, arg1, arg2) => { root.stage-parameter(arg0, arg1, arg2); }
                summary-field: root.summary-field;
                tab-index <=> root.tab-index;
                title-field: root.title-field;
                ui-size: root.ui-size;
            }
        }
        Rectangle {
            visible:root.monitor-open && root.drawer-fits;
            clip:true;
            preferred-height:self.visible ? root.effective-drawer-height : 0px;
            min-height:self.visible ? root.effective-drawer-height : 0px;
            max-height:self.visible ? root.effective-drawer-height : 0px;
            vertical-stretch:0;
            background:Palette.control-background;
            border-width:1px;border-color:Palette.border;
            drawer-content := VerticalBox {padding:8px;spacing:3px;
                Rectangle {
                    height:6px;background:grip-touch.has-hover || grip-focus.has-focus ? Palette.accent-background : Palette.border;
                    accessible-role:slider;accessible-label:Terms.caption-output-monitor-height;
                    accessible-value:root.effective-drawer-height/1px;accessible-value-minimum:root.minimum-monitor-height/1px;accessible-value-maximum:max(root.minimum-monitor-height,root.maximum-monitor-height)/1px;accessible-value-step:16;
                    accessible-action-set-value(v)=>{if v.is-float(){root.resize-monitor(v.to-float());}}
                    accessible-action-increment=>{root.resize-monitor(root.effective-drawer-height/1px+16);}
                    accessible-action-decrement=>{root.resize-monitor(root.effective-drawer-height/1px-16);}
                    forward-focus:grip-focus;
                    grip-focus := FocusScope {key-pressed(e)=>{if e.text==Key.UpArrow{root.resize-monitor(root.effective-drawer-height/1px+16);return accept;}if e.text==Key.DownArrow{root.resize-monitor(root.effective-drawer-height/1px-16);return accept;}return reject;}}
                    grip-touch := TouchArea {mouse-cursor:row-resize;moved=>{if self.pressed{root.resize-monitor((root.effective-drawer-height + self.pressed-y - self.mouse-y)/1px);}}clicked=>{grip-focus.focus();}}
                }
                MonitorPanel {
                    data:root.monitor-data;ui-size:root.ui-size;
                    span-choices:root.span-choices;scale-choices:root.scale-choices;
                    span(i)=>{root.window-index=i;root.window-changed();}
                    scale(i)=>{root.scale-index=i;root.window-changed();}
                    hold=>{root.held=!root.held;root.hold-changed();}
                    follow=>{root.follow-motion();}
                    details=>{root.show-diagnostics();}
                    collapse=>{root.monitor-open=false;monitor-opener.focus-button();root.window-changed();}
                }
            }
        }
        transport := TransportBar {
                auxiliary-error: root.auxiliary-error;
                elapsed: root.elapsed;
                generated: root.generated;
                guidance: root.guidance;
                operation-outcome: root.operation-outcome;
                operation-summary: root.operation-summary;
                play-stop() => { root.play-stop(); }
                play-target: root.play-target;
                playback-busy: root.playback-busy;
                player-title: root.player-title;
                show-diagnostics() => { root.show-diagnostics(); }
                transport-action: root.transport-action;
                transport-enabled: root.transport-enabled;
                transport-labels: root.transport-labels;
                ui-size: root.ui-size;
                update-monitor-layout() => { root.update-monitor-layout(); }
            }
    }
}
