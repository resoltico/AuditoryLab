import { AboutSlint, Button, ComboBox, LineEdit, TextEdit, VerticalBox, HorizontalBox, GroupBox, CheckBox, ScrollView } from "std-widgets.slint";

export component AboutWindow inherits Window {
    title: "About Auditory Lab";
    preferred-width: 560px;
    preferred-height: 440px;
    in property <string> identity;
    VerticalBox {
        Text { text: "Auditory Lab — MPL-2.0"; }
        TextEdit { read-only: true; text: root.identity; accessible-label: "Product and build identity"; }
        AboutSlint {}
    }
}
component SignalLane inherits Rectangle {
    in property <string> label;
    in property <string> trace;
    in property <string> start-label;
    in property <string> end-label;
    background: #131d2b;
    border-radius: 4px;
    height: 120px;
    Text { x: 8px; y: 6px; width: parent.width - 16px; height: 16px; text: root.label; color: white; font-size: 12px; }
    // Path fit subtracts one stroke width and offsets by half a stroke. All
    // reference centers use those same bounds, including the source endpoints.
    plot := Rectangle {
        x: 54px; y: 30px; width: parent.width - self.x - 10px; height: 48px;
        clip: true;
        Rectangle { x: 0.5px; y: parent.height / 2 - 0.5px; width: parent.width - 1px; height: 1px; background: #43536b; }
        Path { width: parent.width; height: parent.height; viewbox-width: 1024; viewbox-height: 100; fit: fill; commands: root.trace; stroke: #77d4ef; stroke-width: 1px; }
    }
    Text { x: 8px; y: plot.y + 0.5px - self.height / 2; width: 36px; height: 14px; text: "+1"; color: #aebdce; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
    Text { x: 8px; y: plot.y + plot.height / 2 - self.height / 2; width: 36px; height: 14px; text: "0"; color: #aebdce; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
    Text { x: 8px; y: plot.y + plot.height - 0.5px - self.height / 2; width: 36px; height: 14px; text: "−1"; color: #aebdce; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
    Rectangle { x: plot.x - 6px; y: plot.y; width: 6px; height: 1px; background: #43536b; }
    Rectangle { x: plot.x - 6px; y: plot.y + plot.height / 2 - 0.5px; width: 6px; height: 1px; background: #43536b; }
    Rectangle { x: plot.x - 6px; y: plot.y + plot.height - 1px; width: 6px; height: 1px; background: #43536b; }
    Text { x: plot.x + 0.5px; y: 86px; width: (plot.width - 1px) / 2; height: 28px; text: root.start-label; color: #aebdce; font-size: 10px; overflow: elide; }
    Text { x: plot.x + plot.width / 2; y: 86px; width: (plot.width - 1px) / 2; height: 28px; text: root.end-label; color: #aebdce; font-size: 10px; overflow: elide; horizontal-alignment: right; }
}
export component MainWindow inherits Window {
    title: "Auditory Lab";
    preferred-width: 900px;
    preferred-height: 800px;
    min-width: 600px;
    min-height: 640px;
    in property <[string]> catalog;
    in-out property <int> selected: 0;
    in property <string> source-title;
    in property <string> description;
    in property <string> activity;
    in property <string> status;
    in property <bool> busy;
    in property <bool> selection-locked;
    in property <bool> stoppable;
    in-out property <string> input-path;
    in property <bool> input-editing;
    in-out property <string> folder-path;
    in property <bool> folder-editing;
    in-out property <string> filename: "sound.wav";
    in-out property <string> rate;
    in property <bool> monitoring;
    in property <bool> frozen;
    in property <string> signal-through: "No observed samples";
    in property <string> signal-context: "No live trace. Play starts a new operation at frame zero.";
    in property <string> peak-context;
    in property <string> detail-context;
    in property <string> peak-start;
    in property <string> peak-end;
    in property <string> detail-start;
    in property <string> detail-end;
    in property <string> peak-left;
    in property <string> peak-right;
    in property <string> detail-left;
    in property <string> detail-right;
    in-out property <bool> reduced-motion;
    in-out property <bool> detail-visible: false;
    in-out property <int> detail-index: 2;
    private property <bool> show-research: false;
    private property <bool> show-files: false;
    callback select(int);
    callback browse-input(); callback edit-input(); callback input-changed(string); callback cancel-input-edit(); callback import-recipe();
    callback browse-folder(); callback edit-folder(); callback folder-changed(string); callback cancel-folder-edit();
    callback inspect(); callback play(); callback stop(); callback export-wav(); callback about();
    callback freeze-display(); callback refresh-display(); callback motion-changed(bool); callback detail-window(int);
    callback detail-visibility-changed();
    MenuBar {
        Menu { title: "Help"; MenuItem { title: "About Auditory Lab"; activated => { root.about(); } } }
    }
    VerticalBox {
        HorizontalBox { vertical-stretch: 0;
            Text { text: "Selected sound"; }
            ComboBox { model: root.catalog; current-index <=> root.selected; enabled: !root.selection-locked; selected(value) => { root.select(root.selected); } accessible-label: "Built-in sound, identifier and duration"; }
        }
        Text { text: root.source-title; font-size: 20px; wrap: no-wrap; overflow: elide; vertical-stretch: 0; }
        HorizontalBox { vertical-stretch: 0;
            Text { text: root.status; wrap: word-wrap; accessible-label: "Operation state"; accessible-value: root.status; }
            Button { text: "Play"; enabled: !root.busy; clicked => { root.play(); } }
            Button { text: "Stop"; enabled: root.stoppable; clicked => { root.stop(); } }
        }
        HorizontalBox { vertical-stretch: 0;
            Text { text: "Signal through"; }
            Text { text: root.signal-through; wrap: word-wrap; accessible-label: "Last observed signal coverage, not an audible playhead"; accessible-value: root.signal-through; }
        }
        ScrollView {
            content-width: self.visible-width;
            VerticalBox {
                padding: 0px;
                Text { text: "Generated signal · recent peak range · fixed digital amplitude ±1"; wrap: word-wrap; }
                Text { text: root.peak-context; wrap: word-wrap; }
                SignalLane { label: "Left"; trace: root.peak-left; start-label: root.peak-start; end-label: root.peak-end; }
                SignalLane { label: "Right"; trace: root.peak-right; start-label: root.peak-start; end-label: root.peak-end; }
                Text { text: root.signal-context; wrap: word-wrap; accessible-label: "Generated signal source, rate, observation state and gaps"; accessible-value: root.signal-context; }
                HorizontalBox {
                    Button { text: root.frozen ? "Resume display" : "Freeze display"; enabled: root.monitoring; clicked => { root.freeze-display(); } }
                    Button { text: "Refresh display"; enabled: root.monitoring && (root.frozen || root.reduced-motion); clicked => { root.refresh-display(); } }
                    CheckBox { text: "Reduced motion"; checked <=> root.reduced-motion; toggled => { root.motion-changed(self.checked); } }
                }
                Text { text: "Before device conversion; generated samples may be silenced before submission. Not microphone input, sound pressure or an audible playhead. Freeze display leaves sound running."; wrap: word-wrap; }
                Button { text: root.detail-visible ? "Hide waveform detail" : "Show waveform detail"; clicked => { root.detail-visible = !root.detail-visible; root.detail-visibility-changed(); } }
                if root.detail-visible: VerticalBox {
                    HorizontalBox {
                        Text { text: "Waveform detail"; }
                        ComboBox { model: ["2 ms", "10 ms", "40 ms", "100 ms"]; current-index <=> root.detail-index; selected(value) => { root.detail-window(root.detail-index); } accessible-label: "Requested waveform detail window"; }
                    }
                    Text { text: root.detail-context; wrap: word-wrap; }
                    Text { text: "Window requests apply to new live observations; stopped views retain their captured extent."; wrap: word-wrap; }
                    if root.frozen || root.reduced-motion: Text { text: "Window changes take effect with the next refreshed observation."; wrap: word-wrap; }
                    SignalLane { label: "Left"; trace: root.detail-left; start-label: root.detail-start; end-label: root.detail-end; }
                    SignalLane { label: "Right"; trace: root.detail-right; start-label: root.detail-start; end-label: root.detail-end; }
                }
                Button { text: root.show-research ? "Hide research context and recipe" : "Research context and recipe"; clicked => { root.show-research = !root.show-research; } }
                if root.show-research: TextEdit { text: root.description; read-only: true; min-height: 220px; accessible-label: "Selected sound and full research context"; }
                Button { text: root.show-files ? "Hide recipe and WAV controls" : "Open recipe, validate or export WAV"; clicked => { root.show-files = !root.show-files; } }
                if root.show-files: VerticalBox {
                    GroupBox { title: "Open immutable recipe snapshot"; VerticalBox {
                        LineEdit { text <=> root.input-path; read-only: !root.input-editing; enabled: !root.busy; edited(text) => { root.input-changed(text); } accessible-label: "Recipe path"; }
                        HorizontalBox {
                            Button { text: "Browse…"; enabled: !root.busy; clicked => { root.browse-input(); } }
                            Button { text: "Edit path"; enabled: !root.busy && !root.input-editing; clicked => { root.edit-input(); } }
                            Button { text: "Cancel edit"; enabled: !root.busy && root.input-editing; clicked => { root.cancel-input-edit(); } }
                            Button { text: "Open Recipe"; enabled: !root.busy; clicked => { root.import-recipe(); } }
                        }
                    } }
                    HorizontalBox {
                        Text { text: "Validation/export rate (Hz):"; }
                        LineEdit { text <=> root.rate; enabled: !root.busy; accessible-label: "Validation and export sample rate in whole hertz"; }
                        Button { text: "Validate"; enabled: !root.busy; clicked => { root.inspect(); } }
                    }
                    GroupBox { title: "Export WAV — new files only, never replace"; VerticalBox {
                        LineEdit { text <=> root.folder-path; read-only: !root.folder-editing; enabled: !root.busy; edited(text) => { root.folder-changed(text); } accessible-label: "Existing export folder"; }
                        HorizontalBox {
                            Button { text: "Browse folder…"; enabled: !root.busy; clicked => { root.browse-folder(); } }
                            Button { text: "Edit folder"; enabled: !root.busy && !root.folder-editing; clicked => { root.edit-folder(); } }
                            Button { text: "Cancel edit"; enabled: !root.busy && root.folder-editing; clicked => { root.cancel-folder-edit(); } }
                        }
                        HorizontalBox {
                            Text { text: "New filename:"; }
                            LineEdit { text <=> root.filename; enabled: !root.busy; accessible-label: "New WAV filename, one path component"; }
                            Button { text: "Export WAV"; enabled: !root.busy; clicked => { root.export-wav(); } }
                        }
                    } }
                }
                TextEdit { text: root.activity; read-only: true; min-height: 180px; accessible-label: "Preparation, result and selectable technical diagnostics"; }
            }
        }
        Text { text: "Keep output volume low; digital levels do not limit sound pressure."; wrap: word-wrap; vertical-stretch: 0; }
    }
}
