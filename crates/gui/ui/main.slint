export { DateInput } from "models.slint";
import { DateInput } from "models.slint";
import { ControlOption } from "models.slint";
export { ViewCaptions } from "view-captions.slint";
import { ViewCaptions } from "view-captions.slint";
export { Actions, Action } from "actions.slint";
import { Actions } from "actions.slint";
import { Dialogs } from "dialogs.slint";
import { LibraryPane } from "library-pane.slint";
import { WorkbenchPane } from "workbench-pane.slint";
import { TransportBar } from "transport.slint";
import { RunningTaskActions } from "running-task-actions.slint";
import { Button } from "button.slint";


import { LearningPane } from "learning-pane.slint";
import { WorkspaceNavigation } from "workspace-navigation.slint";
export { Terms } from "vocabulary.slint";
import { Terms } from "vocabulary.slint";
import {
    Palette,
    VerticalBox,
    HorizontalBox,
    ProgressIndicator,
    TextEdit,
} from "std-widgets.slint";
export {
    EntryAddress,
    LibraryMutationAction,
    CatalogRow,
    LibraryFacet,
    ParameterRow,
    ComponentRow,
    MetadataRow,
    ModelLane,
    LearningBand,
    LearningTrace,
    LearningSource,
} from "models.slint";
import {
    EntryAddress,
    LibraryMutationAction,
    CatalogRow,
    LibraryFacet,
    ParameterRow,
    ComponentRow,
    MetadataRow,
    ModelLane,
    LearningBand,
    LearningTrace,
    LearningSource,
} from "models.slint";
import { StableButton } from "editor.slint";
export { AboutWindow, LicenseWindow } from "about.slint";

export {
    MonitorWindow,
    DetailsWindow,
    AudioControlsWindow,
    MonitorData,
} from "monitor.slint";
import { MonitorPanel, MonitorData } from "monitor.slint";

export component MainWindow inherits Window {
    icon: @image-url("../../../artwork/auditorylab-icon/assets/runtime/window-icon.png");
    title: Terms.caption-product-name;
    in-out property <bool> edits-suspended:false;
    in-out property <bool> monitor-open:false;
    in property <bool> native-mac: false;
    in property <string> draft-brief;
    in property <string> draft-location;
    in property <string> draft-location-details;
    // The open document's binding; field callbacks carry the binding they rendered with.
    in property <string> document;
    in property <int> document-reset;
    in property <MetadataRow> title-field;
    in property <MetadataRow> summary-field;
    in property <MetadataRow> duration-field;
    in property <MetadataRow> fade-field;
    in property <[ComponentRow]> components;
    in property <[ModelLane]> model-lanes;
    in property <[string]> routing-choices;
    in property <[string]> pulse-width-choices;
    in property <[string]> pulse-shape-choices;
    in property <[string]> carrier-choices;
    in property <[ControlOption]> add-choices;
    in property <[string]> modulation-choices;
    in property <[string]> span-choices;
    in property <[string]> scale-choices;
    callback stage-parameter(string, string);
    callback commit-parameter(string, string);
    callback restore-parameter(string);
    callback slide(string, float);
    callback stage-metadata(string, string);
    callback commit-metadata(string, string);
    callback restore-metadata(string);
    callback set-routing(string, int);
    callback set-pulse-option(string, int, int);
    callback set-carrier(string, int);
    callback set-modulation(string, int);
    callback remove-component(string);
    callback restore-component(string);
    callback add-component(string, int);

    in property <string> output-state;
    in property <string> receipt-age;
    in property <string> capture-duration;
    in property <string> motion-reason;
    in property <bool> motion-overridden;
    in-out property <length> monitor-height:270px;
    // The native tabs share the toolbar. Reserve padding and 280px of
    // document space beside the measured header and transport.
    property <length> available-monitor-height:0px;
    property <length> minimum-monitor-height: max(240px, drawer-content.preferred-height);
    property <length> maximum-monitor-height: min(360px, root.available-monitor-height);
    out property <bool> drawer-fits: root.minimum-monitor-height <= root.maximum-monitor-height &&
        drawer-content.min-width <= root.width - workspace-layout.padding-left -
        workspace-layout.padding-right;
    out property <length> effective-drawer-height: max(root.minimum-monitor-height,
        min(root.monitor-height, root.maximum-monitor-height));
    out property <bool> learning-compact: false;
    property <length> learning-navigation-height: learning-page.wide-navigation-height;
    function update-guide-layout() {
        // Use viewport snapshots, not a minimum-layout binding back to window size.
        root.learning-compact = root.compact ||
            root.height - toolbar.preferred-height - transport.preferred-height -
            (root.monitor-open && root.drawer-fits ? root.effective-drawer-height : 0px) -
            56px < root.learning-navigation-height;
    }
    changed learning-navigation-height => { root.update-guide-layout(); }
    changed learning-visible => { root.update-guide-layout(); }
    changed monitor-open => { root.update-guide-layout(); }
    function update-monitor-layout() {
        // Snapshot viewport space on layout changes to avoid feeding the window's
        // inferred minimum height back into its own layout constraint binding.
        root.available-monitor-height = max(0px,
            root.height - toolbar.preferred-height - transport.preferred-height - 16px - 280px);
        root.update-guide-layout();
        root.window-changed();
    }
    changed drawer-fits => { root.update-monitor-layout(); }
    changed height => { root.update-monitor-layout(); }
    changed monitor-height => { root.update-monitor-layout(); }
    public function resize-monitor(pixels: float) {
        root.monitor-height = max(240px,min(360px,
        pixels * 1px));
    }
    public function focus-monitor-opener() {
        if root.learning-visible && !root.monitor-open {
            root.focus-learning();
        } else {
            transport.focus-monitor();
        }
    }
    in property <bool> can-change-waveform;
    out property <MonitorData> monitor-data:{
        state:root.output-state,
        age:root.receipt-age,
        caption:root.waveform-caption,
        meters:root.meters,
        warning:root.monitor-warning,
        warninglive:root.monitor-warning-live,
        backendwarning:root.backend-warning,
        motion:root.motion-reason,
        left:root.left-path,
        right:root.right-path,
        limit:root.scale-label,
        spanlabel:root.capture-duration,
        spanchoice:root.window-index,
        scalechoice:root.scale-index,
        held:root.held,
        settingsenabled:root.can-change-waveform,
        overridden:root.motion-overridden
    };
    callback show-diagnostics();
    callback show-research();
    callback hold-changed();
    callback follow-motion();
    in property <string> waveform-caption;
    in property <string> scale-label: "1";
    in property <string> model-caption;
    in property <string> monitor-warning;
    in property <bool> monitor-warning-live;
    in property <string> backend-warning;
    in property <string> typography-origin;
    in-out property <int> scale-index;
    in property <string> ui-family;
    in property <length> ui-size: 13px;
    default-font-family: root.ui-family;
    default-font-size: root.ui-size;
    preferred-width: 1280px;
    preferred-height: 900px;
    min-width: 680px;
    min-height: 600px;
    in property <[CatalogRow]> catalog;
    in property <string> library-heading;
    in property <bool> rhythm-filtered;
    in property <bool> show-built-in-dates;
    in property <bool> open-files-scope;
    callback clear-rhythm-filters();
    in property <[LibraryFacet]> band-navigation;
    in property <string> library-classification;
    in property <string> library-ownership;
    in property <string> library-overview;
    in property <string> library-empty-message;
    in property <bool> library-filters-active;
    in-out property <bool> library-wide: false;
    out property <bool> library-tools-open: dialogs.library-tools-open;
    out property <bool> library-query-open: dialogs.library-query-open;
    public function open-query-details() { dialogs.open-query-details(); }
    public function close-query-details() { dialogs.close-query-details(); }
    public function open-library-filters() { dialogs.open-library-filters(); }
    public function close-library-filters() { dialogs.close-library-filters(); }
    in-out property <int> selected: 0;
    in property <string> sound-title;
    in property <string> studied;
    in property <bool> can-open-study;
    callback open-study();
    in property <string> recipe-timing;
    in property <[string]> export-rates;
    in property <string> summary;
    in property <string> structure;
    in property <string> details;
    in property <string> guidance;
    in property <string> status;
    in property <string> operation-summary;
    in property <string> operation-outcome;
    in property <string> auxiliary-error;
    in property <string> copy-reason;
    in property <string> file-activity;
    in property <bool> exporting;
    callback cancel-file();
    in property <bool> playback-busy;
    in property <bool> transport-enabled;
    in property <string> transport-action;
    in property <[string]> transport-labels;
    in property <bool> can-edit;
    in property <bool> can-add-component;
    in property <bool> can-add-pair;
    in property <string> pair-add-reason;
    in property <string> add-reason;
    in property <string> removed-component;
    in property <bool> can-restore-component;
    in property <bool> can-export;
    in property <bool> can-play;
    in property <string> library-play-action;
    in property <bool> can-import;
    in property <bool> can-manage-library;
    in property <bool> can-add-to-library;
    in property <bool> can-request-trash;
    in property <bool> can-new;
    in property <bool> can-copy;
    in property <bool> can-preview;
    in property <bool> can-save;
    in property <bool> can-save-copy;
    in property <bool> can-export-recipe;
    in property <bool> dirty;
    in property <string> based-on;
    in property <string> based-on-title;
    in property <string> retained-warning;
    in property <string> player-title;
    in property <string> play-target;
    in property <string> generated;
    in property <string> generated-details;
    in property <string> monitor-state;
    in property <string> meters;
    in property <string> device;

    in property <string> elapsed;
    in property <float> progress;
    in property <string> left-path;
    in property <string> right-path;
    in-out property <length> editor-scroll-y;
    in property <string> metadata-error;
    in property <string> save-reason;
    in property <string> export-reason;
    in property <string> play-reason;
    in property <string> peak;
    in-out property <string> onboarding-notice;
    in property <bool> learning-visible;
    in property <int> learning-topic;
    in property <string> learning-topic-key;
    in property <int> learning-band;
    in property <int> learning-construction;
    in property <[string]> learning-constructions;
    in property <string> learning-construction-description;
    in property <string> learning-example-summary;
    in property <[LearningTrace]> learning-traces;
    callback select-learning-construction(int);
    in property <string> learning-heading;
    in property <string> learning-body;
    in property <string> learning-details;
    in property <string> learning-example-action;
    in property <[LearningBand]> learning-band-items;
    in property <[LearningSource]> learning-sources;
    callback open-learning-source(int);
    in-out property <length> learning-scroll-y <=> learning-page.scroll-y;
    in property <string> learning-band-description;
    in property <[string]> learning-topics;
    callback open-learning(int);
    callback resume-learning();
    callback select-learning-band(int);
    callback browse-learning-library();
    callback create-learning-example();
    public function focus-learning() { learning-page.focus-start(); }
    public function focus-workbench() { workbench-page.focus-title(); }
    public function show-onboarding-notice() {
        if root.onboarding-notice != "" { preference-popup.show(); }
    }
    out property <bool> onboarding-notice-open: preference-popup.is-open;
    changed onboarding-notice => {
        if root.onboarding-notice == "" && preference-popup.is-open {
            // Slint restores the popup's original trigger on close. Preserve a
            // navigation target the user deliberately focused in the meantime.
            let navigation-focused = workspace-navigation.has-focus;
            preference-popup.close();
            if navigation-focused { workspace-navigation.focus(); }
        }
    }
    function restore-notice-focus() {
        if root.onboarding-notice == "" {
            if root.learning-visible { root.focus-learning(); }
            else { root.focus-workspace-navigation(); }
        } else if root.learning-visible {
            learning-page.focus-preference-notice();
        } else {
            notice-details.focus();
        }
    }
    function close-preference-notice() {
        if preference-popup.is-open {
            preference-popup.close();
            root.restore-notice-focus();
        }
    }
    public function focus-workspace-navigation() { workspace-navigation.focus(); }
    in property <int> tab-index: 0;
    in-out property <int> window-index;
    in-out property <int> rate-index: 1;
    in-out property <bool> held: false;
    in-out property <bool> library-detail: false;
    in-out property <length> library-scroll-y: 0px;
    in-out property <length> sidebar-width: 330px;
    public function resize-library-pane(pixels: float) {
        root.sidebar-width = max(230px,min(500px,pixels * 1px));
    }
    in-out property <string> query;
    in property <bool> has-results;
    in-out property <bool> compact: false;
    changed ui-size => {
        root.compact = root.width < root.ui-size * 70;
        root.library-wide = root.width >= root.ui-size * 90;
        root.update-monitor-layout();
    }
    changed width => {
        root.compact = self.width < root.ui-size * 70;
        root.library-wide = self.width >= root.ui-size * 90;
        root.update-monitor-layout();
    }
    callback select(EntryAddress);
    callback navigate-library(int);
    in-out property <string> focused-library-key;
    in property <EntryAddress> library-entry;
    in property <string> library-key;
    in property <string> library-token;
    in property <bool> library-trashed;
    in property <string> library-status;
    in property <string> library-alert;
    callback collection-filter(int, int);
    in property <string> library-count;
    // Committed restrictions, shown beside the results instead of in a popup.
    in property <string> library-restrictions;
    in property <string> calendar-context;
    in property <[string]> band-labels;
    in property <[string]> method-labels;
    callback more-filters(string, int, int, int, int, int, DateInput, DateInput, DateInput);
    callback clear-library-filters();
    callback reset-library-sort();
    function clear-applied-filters() { dialogs.clear-applied-filters(); }
    in-out property <string> study-query;
    in-out property <int> population-choice:0;
    in-out property <int> role-choice:0;
    in-out property <int> analysis-choice:0;
    in-out property <int> direction-choice:0;
    in-out property <int> group-choice:0;
    in-out property <string> created-from;
    in-out property <string> created-through;
    in-out property <string> modified-from;
    in-out property <string> modified-through;
    in-out property <string> added-from;
    in-out property <string> added-through;

    in property <[string]> collection-labels;
    in property <[string]> sort-labels;
    in property <[string]> population-labels;
    in property <[string]> role-labels;
    in property <[string]> analysis-labels;
    in property <[string]> direction-labels;
    in property <[string]> group-labels;

    in-out property <int> collection-choice: 0;
    in-out property <int> sort-choice: 0;
    callback worker-ready();
    callback refresh-library();
    callback initialize-library();
    callback edit-saved(EntryAddress);
    callback save-copy();
    in property <string> library-dates;
    in property <string> library-dates-utc;
    callback add-to-library(EntryAddress);
    callback show-saved();
    callback library-action(EntryAddress, LibraryMutationAction, string);
    callback search(string);
    callback rhythm-filter(int, int);
    in-out property <int> band-choice: 0;
    in-out property <int> method-choice: 0;
    callback open-recipe();
    callback play-stop();
    callback stop-audio();
    callback play-recipe();
    callback preview-selected();
    callback export-wav();
    callback export-recipe();
    callback close-open-file(EntryAddress);
    callback edit-shortcut(string);
    callback open-guide();
    callback about();
    callback based-on-source();
    callback quit();
    callback rate-changed(int);
    callback window-changed();
    callback tab-changed(int);
    callback open-workbench();
    callback new-draft();
    callback save-recipe();
    dialogs := Dialogs {
        window-width: root.width;
        window-height: root.height;
        toolbar-height: toolbar.height;
        added-from <=> root.added-from;
        added-through <=> root.added-through;
        analysis-choice <=> root.analysis-choice;
        analysis-labels: root.analysis-labels;
        band-choice <=> root.band-choice;
        calendar-context: root.calendar-context;
        can-import: root.can-import;
        can-manage-library: root.can-manage-library;
        clear-library-filters() => { root.clear-library-filters(); }
        collection-choice <=> root.collection-choice;
        collection-filter(arg0, arg1) => { root.collection-filter(arg0, arg1); }
        compact <=> root.compact;
        created-from <=> root.created-from;
        created-through <=> root.created-through;
        direction-choice <=> root.direction-choice;
        direction-labels: root.direction-labels;
        group-choice <=> root.group-choice;
        group-labels: root.group-labels;
        library-alert: root.library-alert;
        library-count: root.library-count;
        method-choice <=> root.method-choice;
        method-labels: root.method-labels;
        modified-from <=> root.modified-from;
        modified-through <=> root.modified-through;
        more-filters(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8) => {
            root.more-filters(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8);
        }
        population-choice <=> root.population-choice;
        population-labels: root.population-labels;
        query <=> root.query;
        rhythm-filter(arg0, arg1) => { root.rhythm-filter(arg0, arg1); }
        role-choice <=> root.role-choice;
        role-labels: root.role-labels;
        study-query <=> root.study-query;
        ui-size: root.ui-size;
    }

    MenuBar {
        Menu {
            title: Terms.caption-file;
            MenuItem {
                title: Actions.new-sound.label;
                enabled: Actions.new-sound.enabled;
                activated => {
                    root.new-draft();
                }
            }

            MenuItem {
                title: (Actions.open-recipe.label + "…");
                enabled: Actions.open-recipe.enabled;
                activated => {
                    root.open-recipe();
                }
            }

            MenuItem {
                title: Actions.save.label;
                enabled: Actions.save.enabled;
                activated => {
                    root.save-recipe();
                }
            }

            MenuItem {
                title: Actions.save-copy.label;
                enabled: Actions.save-copy.enabled;
                activated => { root.save-copy(); }
            }

            MenuItem {
                title: (Actions.export-recipe.label + "…");
                enabled: Actions.export-recipe.enabled;
                activated => { root.export-recipe(); }
            }

            MenuItem {
                title: (Actions.export.label + "…");
                enabled: Actions.export.enabled;
                activated => {
                    root.export-wav();
                }
            }

            MenuItem {
                title: root.library-play-action;
                enabled: Actions.play-selected-sound.enabled;
                activated => { root.play-recipe(); }
            }

            MenuItem {
                title: Actions.stop.label;
                enabled: Actions.stop.enabled;
                activated => { root.stop-audio(); }
            }

            // macOS puts Quit in the application menu.
            if !root.native-mac: MenuItem {
                title: Terms.action-quit;
                activated => {
                    root.quit();
                }
            }
        }

        // Edit items forward the standard keystroke to the focused field. They carry
        // no shortcuts: menu shortcuts are matched before widgets, which would take
        // the keystroke away from the field it is meant for.
        Menu {
            title: Terms.action-edit;
            MenuItem {
                title: Terms.action-undo;
                activated => { root.edit-shortcut("z"); }
            }

            MenuItem {
                title: Terms.action-cut;
                activated => { root.edit-shortcut("x"); }
            }

            MenuItem {
                title: Terms.action-copy;
                activated => { root.edit-shortcut("c"); }
            }

            MenuItem {
                title: Terms.action-paste;
                activated => { root.edit-shortcut("v"); }
            }

            MenuItem {
                title: Terms.action-select-all;
                activated => { root.edit-shortcut("a"); }
            }
        }

        Menu {
            title: Terms.caption-help;
            MenuItem {
                title: "Start here";
                activated => { root.resume-learning(); }
            }

            MenuItem {
                title: Terms.action-desktop-guide;
                activated => { root.open-guide(); }
            }

            if !root.native-mac: MenuItem {
                title: Terms.caption-about-product;
                activated => {
                    root.about();
                }
            }
        }
    }

    // Centred and sized for a short explanation; the text scrolls if it is longer.
    preference-popup := PopupWindow {
        width: min(root.ui-size * 40, root.width - 32px);
        height: min(root.ui-size * 20, max(240px, root.height - 32px));
        x: (root.width - self.width) / 2;
        y: max(16px, (root.height - self.height) / 3);
        close-policy: close-on-click-outside;
        forward-focus: preference-focus;
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
        }

        preference-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-preference-notice();
                    return accept;
                }
                return reject;
            }
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Couldn't save the Start here preference";
                    color: Palette.foreground;
                    font-weight: 600;
                    wrap: word-wrap;
                    min-width: 0px;
                    vertical-stretch: 0;
                }

                TextEdit {
                    text: root.onboarding-notice;
                    read-only: true;
                    wrap: word-wrap;
                    min-width: 0px;
                    accessible-label: "Full preference notice · Path, cause and recovery";
                }

                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    RunningTaskActions {
                        audio-busy: root.playback-busy;
                        exporting: root.exporting;
                        progress: root.progress;
                        stop-audio() => { root.stop-audio(); }
                        cancel-export() => { root.cancel-file(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Close";
                        max-width: self.preferred-width;
                        triggered => { root.close-preference-notice(); }
                    }
                }
            }
        }
    }

    workspace-layout := VerticalBox {
        spacing: 0px;
        notice-banner := Rectangle {
            visible: root.onboarding-notice != "" && !root.learning-visible;
            preferred-height: self.visible ? notice-content.preferred-height : 0px;
            min-height: self.preferred-height;
            max-height: self.preferred-height;
            vertical-stretch: 0;
            clip: true;
            notice-content := HorizontalBox {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding: 4px;
                Text {
                    text: "Couldn't save that you've seen Start here; it may open again " +
                        "next time. Everything else works.";
                    color: Palette.foreground;
                    wrap: no-wrap;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    accessible-live-region: polite;
                }

                notice-details := Button {
                    text: "Details";
                    triggered => { root.show-onboarding-notice(); }
                }
            }
        }

        toolbar := HorizontalBox {
            changed preferred-height => { root.update-monitor-layout(); }
            vertical-stretch: 0;
            padding: 8px;
            workspace-navigation := WorkspaceNavigation {
                current: root.learning-visible ? 2 : root.tab-index;
                text-size: root.ui-size;
                selected(index) => {
                    if index == 2 { root.resume-learning(); }
                    else { root.tab-changed(index); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if !root.learning-visible && root.tab-index == 0: Button {
                text: Actions.open-recipe.label + "…";
                enabled: Actions.open-recipe.enabled;
                triggered => { root.open-recipe(); }
            }
            // Left of the lasting controls, so a late press on Cancel export
            // lands in the space it leaves rather than on another control.
            if root.exporting && !root.learning-visible: ProgressIndicator {
                progress: root.progress;
                accessible-label: ViewCaptions.wav-export-progress;
                min-width: 0px;
                preferred-width: root.learning-visible ? 24px : 120px;
                max-width: self.preferred-width;
            }
            if root.exporting && !root.learning-visible: Button {
                enabled: Actions.cancel-export.enabled;
                text: Actions.cancel-export.label;
                triggered => { root.cancel-file(); }
            }
            if !root.learning-visible &&
                (root.status != "" || root.auxiliary-error != ""): Button {
                text: Terms.caption-task-details-dialog;
                triggered => { root.show-diagnostics(); }
            }
        }

        Rectangle {
            min-height: 0px;
            library-page := LibraryPane {
                visible: !root.learning-visible && root.tab-index == 0;
                width: parent.width;
                height: parent.height;
                add-to-library(arg0) => { root.add-to-library(arg0); }
                band-choice <=> root.band-choice;
                band-labels: root.band-labels;
                band-navigation: root.band-navigation;
                library-heading: root.library-heading;
                rhythm-filtered: root.rhythm-filtered;
                show-built-in-dates: root.show-built-in-dates;
                open-files-scope: root.open-files-scope;
                clear-rhythm-filters() => { root.clear-rhythm-filters(); }
                can-add-to-library: root.can-add-to-library;
                can-copy: root.can-copy;
                can-export: root.can-export;
                can-export-recipe: root.can-export-recipe;
                can-import: root.can-import;
                can-manage-library: root.can-manage-library;
                can-new: root.can-new;
                can-open-study: root.can-open-study;
                can-preview: root.can-preview;
                can-request-trash: root.can-request-trash;
                catalog: root.catalog;
                clear-applied-filters() => { root.clear-applied-filters(); }
                close-open-file(arg0) => { root.close-open-file(arg0); }
                collection-choice <=> root.collection-choice;
                collection-filter(arg0, arg1) => { root.collection-filter(arg0, arg1); }
                collection-labels: root.collection-labels;
                compact <=> root.compact;
                copy-reason: root.copy-reason;
                edit-saved(arg0) => { root.edit-saved(arg0); }
                export-rates: root.export-rates;
                export-recipe() => { root.export-recipe(); }
                export-wav() => { root.export-wav(); }
                file-activity: root.file-activity;
                focused-library-key <=> root.focused-library-key;
                has-results: root.has-results;
                library-action(arg0, arg1, arg2) => { root.library-action(arg0, arg1, arg2); }
                library-alert: root.library-alert;
                library-classification: root.library-classification;
                library-dates: root.library-dates;
                library-dates-utc: root.library-dates-utc;
                library-detail <=> root.library-detail;
                library-empty-message: root.library-empty-message;
                library-filters-active: root.library-filters-active;
                library-entry: root.library-entry;
                library-key: root.library-key;
                library-overview: root.library-overview;
                library-ownership: root.library-ownership;
                library-query-open: root.library-query-open;
                library-restrictions: root.library-restrictions;
                library-status: root.library-status;
                refresh-library() => { root.refresh-library(); }
                reset-library-sort() => { root.reset-library-sort(); }
                show-saved() => { root.show-saved(); }
                initialize-library() => { root.initialize-library(); }
                library-scroll-y <=> root.library-scroll-y;
                library-token: root.library-token;
                library-trashed: root.library-trashed;
                library-wide <=> root.library-wide;
                method-choice <=> root.method-choice;
                method-labels: root.method-labels;
                model-caption: root.model-caption;
                model-lanes: root.model-lanes;
                navigate-library(arg0) => { root.navigate-library(arg0); }
                new-draft() => { root.new-draft(); }
                open-library-filters() => { root.open-library-filters(); }
                open-query-details() => { root.open-query-details(); }
                open-recipe() => { root.open-recipe(); }
                open-study() => { root.open-study(); }
                open-workbench() => { root.open-workbench(); }
                preview-selected() => { root.preview-selected(); }
                query <=> root.query;
                rate-changed(arg0) => { root.rate-changed(arg0); }
                rate-index <=> root.rate-index;
                recipe-timing: root.recipe-timing;
                resize-library-pane(arg0) => { root.resize-library-pane(arg0); }
                rhythm-filter(arg0, arg1) => { root.rhythm-filter(arg0, arg1); }
                search(arg0) => { root.search(arg0); }
                select(arg0) => { root.select(arg0); }
                selected <=> root.selected;
                show-research() => { root.show-research(); }
                sidebar-width <=> root.sidebar-width;
                sort-choice <=> root.sort-choice;
                sort-labels: root.sort-labels;
                sound-title: root.sound-title;
                structure: root.structure;
                studied: root.studied;
                summary: root.summary;
                tab-index: root.tab-index;
                ui-size: root.ui-size;
            }

            workbench-page := WorkbenchPane {
                visible: !root.learning-visible && root.tab-index == 1;
                width: parent.width;
                height: parent.height;
                add-reason: root.add-reason;
                based-on: root.based-on;
                based-on-source() => { root.based-on-source(); }
                based-on-title: root.based-on-title;
                can-edit: root.can-edit;
                can-export: root.can-export;
                can-export-recipe: root.can-export-recipe;
                can-new: root.can-new;
                can-restore-component: root.can-restore-component;
                carrier-choices: root.carrier-choices;
                commit-metadata(arg0, arg1) => { root.commit-metadata(arg0, arg1); }
                commit-parameter(arg0, arg1) => { root.commit-parameter(arg0, arg1); }
                compact <=> root.compact;
                components: root.components;
                dirty: root.dirty;
                document: root.document;
                document-reset: root.document-reset;
                draft-brief: root.draft-brief;
                draft-location-details: root.draft-location-details;
                duration-field: root.duration-field;
                routing-choices: root.routing-choices;
                pulse-width-choices: root.pulse-width-choices;
                pulse-shape-choices: root.pulse-shape-choices;
                editor-scroll-y <=> root.editor-scroll-y;
                edits-suspended <=> root.edits-suspended;
                export-rates: root.export-rates;
                export-reason: root.export-reason;
                export-recipe() => { root.export-recipe(); }
                export-wav() => { root.export-wav(); }
                fade-field: root.fade-field;
                file-activity: root.file-activity;
                metadata-error: root.metadata-error;
                model-caption: root.model-caption;
                model-lanes: root.model-lanes;
                modulation-choices: root.modulation-choices;
                new-draft() => { root.new-draft(); }
                pair-add-reason: root.pair-add-reason;
                peak: root.peak;
                rate-changed(arg0) => { root.rate-changed(arg0); }
                rate-index <=> root.rate-index;
                remove-component(arg0) => { root.remove-component(arg0); }
                removed-component: root.removed-component;
                restore-component(arg0) => { root.restore-component(arg0); }
                restore-metadata(arg0) => { root.restore-metadata(arg0); }
                restore-parameter(arg0) => { root.restore-parameter(arg0); }
                retained-warning: root.retained-warning;
                save-reason: root.save-reason;
                save-recipe() => { root.save-recipe(); }
                add-choices: root.add-choices;
                add-component(arg0, arg1) => { root.add-component(arg0, arg1); }
                set-carrier(arg0, arg1) => { root.set-carrier(arg0, arg1); }
                set-pulse-option(arg0, arg1, arg2) => { root.set-pulse-option(arg0, arg1, arg2); }
                set-routing(arg0, arg1) => { root.set-routing(arg0, arg1); }
                set-modulation(arg0, arg1) => { root.set-modulation(arg0, arg1); }
                slide(arg0, arg1) => { root.slide(arg0, arg1); }
                stage-metadata(arg0, arg1) => { root.stage-metadata(arg0, arg1); }
                stage-parameter(arg0, arg1) => { root.stage-parameter(arg0, arg1); }
                summary-field: root.summary-field;
                tab-index: root.tab-index;
                title-field: root.title-field;
                ui-size: root.ui-size;
            }

            learning-page := LearningPane {
                width: parent.width;
                height: parent.height;
                active: root.learning-visible;
                compact: root.learning-compact;
                topic: root.learning-topic;
                topic-key: root.learning-topic-key;
                band: root.learning-band;
                construction: root.learning-construction;
                constructions: root.learning-constructions;
                construction-description: root.learning-construction-description;
                example-summary: root.learning-example-summary;
                traces: root.learning-traces;
                select-construction(index) => { root.select-learning-construction(index); }
                heading: root.learning-heading;
                body: root.learning-body;
                details: root.learning-details;
                example-action: root.learning-example-action;
                band-items: root.learning-band-items;
                sources: root.learning-sources;
                preference-notice: root.onboarding-notice != "";
                open-preference-notice() => { root.show-onboarding-notice(); }
                open-source(index) => { root.open-learning-source(index); }
                band-description: root.learning-band-description;
                topics: root.learning-topics;
                ui-size: root.ui-size;
                open-topic(index) => { root.open-learning(index); }
                select-band(index) => { root.select-learning-band(index); }
                browse-library() => { root.browse-learning-library(); }
                create-example() => { root.create-learning-example(); }
                open-guide() => { root.open-guide(); }
            }
        }

        Rectangle {
            visible: root.monitor-open && root.drawer-fits;
            clip: true;
            preferred-height: self.visible ? root.effective-drawer-height : 0px;
            min-height: self.visible ? root.effective-drawer-height : 0px;
            max-height: self.visible ? root.effective-drawer-height : 0px;
            vertical-stretch: 0;
            background: Palette.control-background;
            border-width: 1px;
            border-color: Palette.border;
            drawer-content := VerticalBox {
                padding: 8px;
                spacing: 3px;
                Rectangle {
                    height: 6px;
                    background: grip-touch.has-hover || grip-focus.has-focus ?
                        Palette.accent-background : Palette.border;
                    accessible-role: slider;
                    accessible-label: Terms.caption-output-monitor-height;
                    accessible-value: root.effective-drawer-height / 1px;
                    accessible-value-minimum: root.minimum-monitor-height / 1px;
                    accessible-value-maximum: max(root.minimum-monitor-height,
                        root.maximum-monitor-height) / 1px;
                    accessible-value-step: 16;
                    accessible-action-set-value(v) => {
                        if v.is-float() {
                            root.resize-monitor(v.to-float());
                        }
                    }
                    accessible-action-increment => {
                        root.resize-monitor(root.effective-drawer-height / 1px + 16);
                    }
                    accessible-action-decrement => {
                        root.resize-monitor(root.effective-drawer-height / 1px - 16);
                    }
                    forward-focus: grip-focus;
                    grip-focus := FocusScope {
                        key-pressed(e) => {
                            if e.text == Key.UpArrow {
                                root.resize-monitor(root.effective-drawer-height / 1px + 16);
                                return accept;
                            }
                            if e.text == Key.DownArrow {
                                root.resize-monitor(root.effective-drawer-height / 1px - 16);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    grip-touch := TouchArea {
                        mouse-cursor: row-resize;
                        moved => {
                            if self.pressed {
                                root.resize-monitor((root.effective-drawer-height + self.pressed-y -
                                    self.mouse-y) / 1px);
                            }
                        }
                        clicked => { grip-focus.focus(); }
                    }
                }

                MonitorPanel {
                    embedded: true;
                    data: root.monitor-data;
                    ui-size: root.ui-size;
                    span-choices: root.span-choices;
                    scale-choices: root.scale-choices;
                    span(i) => { root.window-index = i; root.window-changed(); }
                    scale(i) => { root.scale-index = i; root.window-changed(); }
                    hold => { root.held = !root.held; root.hold-changed(); }
                    follow => { root.follow-motion(); }
                    details => { root.show-diagnostics(); }
                    collapse => {
                        root.monitor-open = false;
                        root.focus-monitor-opener();
                        root.window-changed();
                    }
                }
            }
        }

        transport := TransportBar {
            learning: root.learning-visible;
            compact: root.compact;
            monitor-open <=> root.monitor-open;
            monitor-toggled => { root.window-changed(); }
            exporting: root.exporting;
            export-progress: root.progress;
            cancel-export() => { root.cancel-file(); }
            auxiliary-error: root.auxiliary-error;
            elapsed: root.elapsed;
            generated: root.generated;
            guidance: root.guidance;
            operation-outcome: root.operation-outcome;
            operation-summary: root.operation-summary;
            play-stop() => { root.play-stop(); }
            stop-audio() => { root.stop-audio(); }
            play-target: root.play-target;
            play-reason: root.play-reason;
            playback-busy: root.playback-busy;
            player-title: root.player-title;
            show-diagnostics() => { root.show-diagnostics(); }
            transport-action: root.transport-action;
            transport-enabled: root.transport-enabled;
            replace-visible: root.playback-busy && root.tab-index == 0 &&
                Actions.play-selected-sound.enabled;
            replace-label: root.library-play-action;
            play-recipe() => { root.play-recipe(); }
            transport-labels: root.transport-labels;
            ui-size: root.ui-size;
            update-monitor-layout() => { root.update-monitor-layout(); }
        }
    }
}
