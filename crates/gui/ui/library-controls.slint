import { EntryAddress, LibraryMutationAction } from "library-actions.slint";
import { Button } from "button.slint";
import { LineEdit } from "std-widgets.slint";
// A held activation retains both its table and row, even after a model rebind.
export component BoundButton inherits Button {
    in property <EntryAddress> entry;
    private property <EntryAddress> captured-entry;
    in property <LibraryMutationAction> action;
    private property <LibraryMutationAction> captured-action;
    private property <bool> armed:false;
    callback activated(EntryAddress);
    callback dispatch(EntryAddress,LibraryMutationAction);
    changed pressed => {if self.pressed {root.captured-entry=root.entry;root.captured-action=root.action;root.armed=true;}}
    triggered => {root.activated(root.armed ? root.captured-entry : root.entry);root.dispatch(root.armed ? root.captured-entry : root.entry,root.armed ? root.captured-action : root.action);root.armed=false;}
}
// Rename retains the handle on which text entry began.
export component BoundTitleEdit inherits LineEdit {
    in property <EntryAddress> entry;
    private property <EntryAddress> captured-entry;
    private property <bool> dirty:false;
    callback rename(EntryAddress,string);
    edited(value)=>{if !root.dirty {root.captured-entry=root.entry;root.dirty=true;}}
    accepted(value)=>{root.rename(root.dirty ? root.captured-entry : root.entry,value);root.dirty=false;}
}
