import { LibraryMutationAction } from "models.slint";
import { Button } from "button.slint";
import { LineEdit } from "std-widgets.slint";
// refresh while a pointer or keyboard press is held cannot retarget the action.
export component BoundButton inherits Button {
    in property <LibraryMutationAction> action;
    private property <LibraryMutationAction> captured-action;
    callback dispatch(string,string,LibraryMutationAction);
    in property <string> key;
    in property <string> token;
    private property <string> captured-key;
    private property <string> captured-token;
    private property <bool> armed:false;
    callback activated(string, string);
    changed pressed => { if self.pressed { root.captured-key=root.key;root.captured-token=root.token;root.captured-action=root.action;root.armed=true; } }
    triggered => { root.activated(root.armed ? root.captured-key : root.key, root.armed ? root.captured-token : root.token);root.dispatch(root.armed ? root.captured-key : root.key,root.armed ? root.captured-token : root.token,root.armed ? root.captured-action : root.action);root.armed=false; }
}
// A rename retains the entry/version on which text entry started.
export component BoundTitleEdit inherits LineEdit {
    in property <string> key;
    in property <string> token;
    private property <string> captured-key;
    private property <string> captured-token;
    private property <bool> dirty:false;
    callback rename(string,string,string);
    edited(value)=> { if !root.dirty {root.captured-key=root.key;root.captured-token=root.token;root.dirty=true;} }
    accepted(value)=> {root.rename(root.dirty ? root.captured-key : root.key,root.dirty ? root.captured-token : root.token,value);root.dirty=false;}
}
