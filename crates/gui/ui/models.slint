export { EntryAddress, LibraryMutationAction } from "library-actions.slint";
export struct ParameterRow {
    key: string,
    label: string,
    help: string,
    text: string,
    staged: bool,
    has-slider: bool,
    position: float,
    diagnostic: string,
    show-diagnostic: bool,
}
// The application key identifies one rendered component lifetime.
export struct ComponentRow {
    key: string,
    id: string,
    route: int,
    routing-editable: bool,
    carrier: int,
    modulation: int,
    source-width: int,
    source-shape: int,
    modulation-width: int,
    modulation-shape: int,
    heading: string,
    name: string,
    context: string,
    error: string,
    parameters: [ParameterRow],
}
export struct MetadataRow {
    key: string,
    label: string,
    text: string,
    staged: bool,
    diagnostic: string,
}
export struct ModelLane { component: string, label: string, trace: string }

// A process-local immutable snapshot binding, independent of row position.
import { EntryAddress } from "library-actions.slint";
export struct CatalogRow {
    entry: EntryAddress,
    built-in: bool,
    text: string,
    binding: string,
    title: string,
    collection: string,
    summary: string,
    bands: string,
    studied-for: string,
    duration: string,
    dates: string
}
export struct LibraryFacet {
    choice-index: int,
    selected: bool,
    label: string,
    detail: string,
    count: string,
    text: string
}

export struct ControlOption { label: string, enabled: bool }

export struct DateInput { from-text: string, through-text: string }

// Readable application-owned rhythm facts and normalized schematic geometry.
export struct LearningBand {
    name: string,
    range: string,
    rate: string,
    context: string,
    // One-second schematic in the common native plot coordinates.
    trace: string
}

// Learning axes distinguish fitted signed audio from nonnegative source/modulation gain.
export struct LearningTrace {
    label: string,
    trace: string,
    // Gain plots use zero at the bottom; signed traces use a central zero.
    unipolar: bool
}

// User-facing source label; application-owned commands retain the destination URL.
export struct LearningSource {label: string}
