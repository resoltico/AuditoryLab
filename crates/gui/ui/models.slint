// Semantic quantities; the application maps each to exactly one domain field.
export enum ParameterKey {
    tone-frequency, click-rate, click-width, peak-level, amplitude-modulation-rate,
    modulation-depth, gate-rate, gate-width, duration, fade, pair-first-frequency, pair-offset, pair-first-level, pair-second-level
}
export enum MetadataKey { title, summary, duration, fade }
export struct ParameterRow {
    key: ParameterKey,
    label: string,
    help: string,
    text: string,
    staged: bool,
    has-slider: bool,
    position: float,
    diagnostic: string,
}
// `binding` identifies the rendered component of one particular document.
export struct ComponentRow {
    binding: int,
    id: string,
    ears: int,
    routing-editable: bool,
    carrier: int,
    modulation: int,
    heading: string,
    name: string,
    context: string,
    error: string,
    parameters: [ParameterRow],
}
export struct MetadataRow { label: string, text: string, staged: bool, diagnostic: string }
export struct ModelLane { component: string, label: string, trace: string }

// A process-local immutable snapshot binding, independent of row position.
export struct CatalogRow { text: string, binding: string }
