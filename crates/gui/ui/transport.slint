import { ViewCaptions } from "view-captions.slint";
import { Button } from "button.slint";
import { RunningTaskActions } from "running-task-actions.slint";
import { Terms } from "vocabulary.slint";
import {
    Palette,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { StableButton } from "editor.slint";

// The player: what plays, its state and time, listening advice, the output
// monitor and audio details. One row at ordinary widths.
export component TransportBar inherits Rectangle {
    in property <bool> learning;
    in property <bool> exporting;
    in property <float> export-progress;
    in property <bool> compact;
    in-out property <bool> monitor-open;
    callback monitor-toggled();
    callback cancel-export();
    private property <bool> quiet-guide: root.learning && !root.playback-busy && !root.exporting &&
        !root.monitor-open && root.auxiliary-error == "" && root.operation-summary == "" &&
        root.operation-outcome == "";
    in property <string> auxiliary-error;
    in property <string> elapsed;
    in property <string> generated;
    in property <string> guidance;
    in property <string> operation-outcome;
    in property <string> operation-summary;
    callback play-stop();
    callback stop-audio();
    in property <string> play-target;
    // Why Play is unavailable; shown in place of the generated line meanwhile.
    in property <string> play-reason;
    in property <bool> playback-busy;
    in property <string> player-title;
    callback show-diagnostics();
    in property <string> transport-action;
    in property <bool> transport-enabled;
    in property <[string]> transport-labels;
    in property <length> ui-size;
    callback update-monitor-layout();
    public function focus-monitor() { monitor.focus(); }
    accessible-role: groupbox;
    accessible-label: ViewCaptions.playback-transport;
    changed preferred-height => { root.update-monitor-layout(); }
    visible: !root.quiet-guide;
    clip: true;
    preferred-height: root.quiet-guide ? 0px : content.preferred-height;
    min-height: self.preferred-height;
    max-height: self.preferred-height;
    vertical-stretch: 0;
    background: Palette.background;
    Rectangle {
        y: 0px;
        height: 1px;
        background: Palette.border;
    }

    content := VerticalBox {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 4px;
        HorizontalBox {
            vertical-stretch: 0;
            padding: 0px;
            spacing: 12px;
            alignment: stretch;
            if !root.learning: StableButton {
                text: root.transport-action;
                labels: root.transport-labels;
                primary: true;
                enabled: root.transport-enabled;
                description: root.transport-enabled ? "" : root.play-reason;
                accessible-name: root.transport-action + (root.playback-busy || root.play-target ==
                    "" ? "" : " · " + root.play-target);
                clicked => { root.play-stop(); }
            }
            if root.learning: RunningTaskActions {
                audio-busy: root.playback-busy;
                exporting: root.exporting;
                progress: root.export-progress;
                stop-audio() => { root.stop-audio(); }
                cancel-export() => { root.cancel-export(); }
            }
            // One line each; Audio details has the full text. Task outcomes join
            // the same column, so they never add a row under the controls.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    min-width: 0px;
                    text: root.player-title + (root.playback-busy || root.play-target == "" ? "" :
                        Terms.caption-next-play-prefix + root.play-target);
                    font-weight: 600;
                    wrap: no-wrap;
                    overflow: elide;
                }

                if !root.learning: Text {
                    min-width: 0px;
                    text: !root.transport-enabled && root.play-reason != "" ? root.play-reason :
                        root.generated;
                    color: Palette.foreground.with-alpha(0.72);
                    wrap: no-wrap;
                    overflow: elide;
                }
                if !root.learning && root.compact: Text {
                    min-width: 0px;
                    text: root.elapsed;
                    color: Palette.foreground.with-alpha(0.72);
                    wrap: no-wrap;
                    overflow: elide;
                }
                if root.auxiliary-error != "" || root.operation-summary != "": Text {
                    min-width: 0px;
                    text: root.auxiliary-error != "" ? root.auxiliary-error :
                        root.operation-summary;
                    wrap: no-wrap;
                    overflow: elide;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
                if root.operation-outcome != "": Text {
                    min-width: 0px;
                    text: root.operation-outcome;
                    wrap: no-wrap;
                    overflow: elide;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
            }

            // Sized for the longest clock, so ticking never reflows the row.
            if !root.learning && !root.compact: Rectangle {
                horizontal-stretch: 0;
                min-width: elapsed-template.preferred-width;
                preferred-width: elapsed-template.preferred-width;
                elapsed-template := Text {
                    visible: false;
                    text: "00:00:00 / 00:00:00";
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.elapsed;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            if !root.learning && !root.compact: Text {
                text: root.guidance;
                min-width: 0px;
                max-width: root.ui-size * 26;
                horizontal-stretch: 1;
                wrap: word-wrap;
                vertical-alignment: center;
                font-size: root.ui-size * 0.92;
                color: Palette.foreground.with-alpha(0.72);
            }
            monitor := Button {
                text: Terms.action-monitor;
                checked: root.monitor-open;
                horizontal-stretch: 0;
                accessible-label: root.monitor-open ? Terms.action-hide-output-monitor :
                    Terms.action-show-output-monitor;
                accessible-expanded: root.monitor-open;
                triggered => {
                    root.monitor-open = !root.monitor-open;
                    root.monitor-toggled();
                }
            }

            Button {
                text: Terms.caption-audio-details-dialog;
                horizontal-stretch: 0;
                accessible-label: ViewCaptions.audio-details;
                triggered => { root.show-diagnostics(); }
            }
        }

        if !root.learning && root.compact: Text {
            min-width: 0px;
            text: root.guidance;
            font-size: root.ui-size * 0.92;
            color: Palette.foreground.with-alpha(0.72);
            wrap: word-wrap;
            vertical-stretch: 0;
        }
    }
}
