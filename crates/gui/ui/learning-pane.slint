import {
    Palette,
    ComboBox,
    ScrollView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { Button } from "button.slint";
import { Section } from "editor.slint";
import { LearningTrace, LearningBand, LearningSource } from "models.slint";

component LearningChoice inherits ComboBox {
    in property <int> selection;
    public function sync-selection() {
        root.current-index = root.selection;
        root.current-value = root.model[root.selection];
    }
    changed selection => { root.sync-selection(); }
    changed model => { root.sync-selection(); }
    init => { root.sync-selection(); }
}

// A visible contents item. Text wraps and follows the native application font.
component LessonTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> focused;
    in property <length> ui-size;
    callback activated();
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.selected ? Palette.accent-background.with-alpha(0.12) : Palette.background;
        border-radius: 6px;
        border-width: root.focused ? 2px : 0px;
        border-color: Palette.accent-background;
        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.label;
            font-size: root.ui-size;
            font-weight: root.selected ? 600 : 400;
            color: Palette.foreground;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.activated(); }
        }
    }
}

component LessonPlot inherits Rectangle {
    in property <string> trace;
    in property <color> ink: Palette.accent-background;
    in property <bool> unipolar;
    in property <string> label;
    in property <length> ui-size;
    preferred-height: root.ui-size * 8;
    min-height: self.preferred-height;
    max-height: self.preferred-height;
    background: Palette.control-background;
    border-radius: 6px;
    accessible-role: image;
    accessible-label: root.label;
    Text {
        x: 4px;
        y: 4px;
        width: root.ui-size * 2;
        text: root.unipolar ? "1" : "+1";
        font-size: root.ui-size;
        color: Palette.foreground;
    }

    if !root.unipolar: Text {
        x: 4px;
        y: parent.height / 2 - self.preferred-height / 2;
        text: "0";
        font-size: root.ui-size;
        color: Palette.foreground;
    }
    Text {
        x: 4px;
        y: parent.height - self.preferred-height - 4px;
        width: root.ui-size * 2;
        text: root.unipolar ? "0" : "−1";
        font-size: root.ui-size;
        color: Palette.foreground;
    }

    Rectangle {
        x: root.ui-size * 2.5;
        y: root.unipolar ? parent.height - 8px : parent.height / 2;
        width: parent.width - self.x - 8px;
        height: 1px;
        background: Palette.border;
    }

    Path {
        x: root.ui-size * 2.5;
        y: 8px;
        width: parent.width - self.x - 8px;
        height: parent.height - 16px;
        viewbox-width: 1024;
        viewbox-height: 100;
        fit: fill;
        commands: root.trace;
        stroke: root.ink;
        stroke-width: 2px;
    }
}

export component LearningPane inherits Rectangle {
    in property <bool> active;
    in property <int> topic;
    in property <string> topic-key;
    in property <int> band;
    in property <int> construction;
    in property <[string]> constructions;
    in property <string> construction-description;
    in property <string> example-summary;
    in property <[LearningTrace]> traces;
    in property <string> heading;
    in property <string> body;
    in property <string> details;
    in property <string> example-action;
    in property <string> band-description;
    in property <[string]> topics;
    in property <[LearningBand]> band-items;
    in property <[LearningSource]> sources;
    in property <bool> preference-notice;
    in property <length> ui-size;
    callback select-construction(int);
    callback open-topic(int);
    callback select-band(int);
    callback browse-library();
    callback create-example();
    callback open-guide();
    callback open-source(int);
    callback open-preference-notice();
    in-out property <length> scroll-y <=> reader.content-y;
    in property <bool> compact;
    // Required rail height is independent of the responsive mode it selects.
    out property <length> wide-navigation-height:
        root.topics.length * (root.ui-size * 3.6 + 8px) +
        (root.preference-notice ? root.ui-size * 2.5 : 0px);
    private property <[color]> band-colors: Palette.color-scheme == ColorScheme.dark ?
        [#8ebcff, #71dbc2, #d0df84, #ffc08a, #ddb1ff] :
        [#245b91, #096658, #5c6816, #914610, #70339c];
    visible: root.active;
    background: Palette.background;
    changed topic-key => { reader.content-y = 0px; }
    public function focus-start() { navigation.focus(); }
    public function focus-preference-notice() { preference-notice-button.focus(); }

    VerticalBox {
        padding: root.compact ? 12px : 20px;
        spacing: root.compact ? 0px : 16px;
        content := Rectangle {
            min-height: 0px;
            preference-notice-button := Button {
                visible: root.preference-notice;
                x: root.compact ? (navigation.width + 8px) * 2 / 3 : 0px;
                y: root.compact ? root.ui-size * 2.5 + 8px :
                    root.topics.length * (root.ui-size * 3.6 + 8px);
                width: root.compact ? (navigation.width - 16px) / 3 : navigation.width;
                height: root.ui-size * 2.5;
                text: "Preference notice";
                accessible-label: "Start here preference notice · Details";
                accessible-live-region: polite;
                triggered => { root.open-preference-notice(); }
            }

            navigation := FocusScope {
                x: 0px;
                y: 0px;
                key-pressed(event) => {
                    if event.text == Key.Home { root.open-topic(0); return accept; }
                    if event.text == Key.End {
                        root.open-topic(root.topics.length - 1);
                        return accept;
                    }
                    if root.compact {
                        if event.text == Key.UpArrow {
                            if root.topic >= 3 { root.open-topic(root.topic - 3); }
                            return accept;
                        }
                        if event.text == Key.DownArrow {
                            if root.topic + 3 < root.topics.length {
                                root.open-topic(root.topic + 3);
                            }
                            return accept;
                        }
                        if event.text == Key.LeftArrow {
                            if mod(root.topic,3) > 0 { root.open-topic(root.topic - 1); }
                            return accept;
                        }
                        if event.text == Key.RightArrow {
                            if mod(root.topic,3) < 2 && root.topic + 1 < root.topics.length {
                                root.open-topic(root.topic + 1);
                            }
                            return accept;
                        }
                    } else {
                        if event.text == Key.UpArrow || event.text == Key.LeftArrow {
                            if root.topic > 0 { root.open-topic(root.topic - 1); }
                            return accept;
                        }
                        if event.text == Key.DownArrow || event.text == Key.RightArrow {
                            if root.topic + 1 < root.topics.length {
                                root.open-topic(root.topic + 1);
                            }
                            return accept;
                        }
                    }
                    return reject;
                }
                width: root.compact ? parent.width : min(root.ui-size * 17,230px);
                height: root.compact ? (root.ui-size * 2.5 + 8px) * 2 : parent.height;
                accessible-role: tab-list;
                accessible-label: "Learning topics";
                for title[index] in root.topics: LessonTab {
                    x: root.compact ? mod(index,3) * (navigation.width + 8px) / 3 : 0px;
                    y: root.compact ? floor(index / 3) * (root.ui-size * 2.5 + 8px) :
                        index * (root.ui-size * 3.6 + 8px);
                    width: root.compact ? (navigation.width - 16px) / 3 : navigation.width;
                    height: root.compact ? root.ui-size * 2.5 : root.ui-size * 3.6;
                    label: title;
                    accessible-item-index: index;
                    selected: root.topic == index;
                    focused: navigation.has-focus && root.topic == index;
                    ui-size: root.ui-size;
                    activated => {
                        navigation.focus();
                        if index != root.topic { root.open-topic(index); }
                    }
                }
            }

            reader := ScrollView {
                accessible-role: tab-panel;
                accessible-label: "Lesson content · " + root.heading;
                x: root.compact ? 0px : navigation.width + 24px;
                y: root.compact ? navigation.height + 12px : 0px;
                width: parent.width - self.x;
                height: parent.height - self.y;
                content-width: self.visible-width;
                content-height: reading-column.preferred-height;
                reading-column := VerticalBox {
                    x: 0px;
                    y: 0px;
                    width: min(reader.visible-width,1000px);
                    height: self.preferred-height;
                    padding: 4px;
                    spacing: 20px;
                    Text {
                        text: root.heading;
                        font-size: root.ui-size * 1.8;
                        font-weight: 600;
                        color: Palette.foreground;
                        wrap: word-wrap;
                        min-width: 0px;
                        vertical-stretch: 0;
                        accessible-role: text;
                    }

                    if root.topic-key == "sound-types": LearningChoice {
                        preferred-height: root.ui-size * 2.6;
                        max-height: self.preferred-height;
                        model: root.constructions;
                        selection: root.construction;
                        max-width: root.ui-size * 30;
                        accessible-label: "Sound construction";
                        selected(_) => { root.select-construction(self.current-index); }
                    }

                    Text {
                        text: root.body;
                        font-size: root.ui-size * 1.08;
                        color: Palette.foreground;
                        wrap: word-wrap;
                        min-width: 0px;
                        vertical-stretch: 0;
                        accessible-role: text;
                    }

                    if root.topic-key == "overview": VerticalBox {
                        padding: 0px;
                        spacing: 14px;
                        vertical-stretch: 0;
                        Text {
                            text: "Explore the Library";
                            font-size: root.ui-size * 1.2;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: "Inspect a ready-made sound and the research behind it.";
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        Button {
                            text: "Browse Library";
                            max-width: self.preferred-width;
                            triggered => { root.browse-library(); }
                        }

                        Text {
                            text: "Build a sound";
                            font-size: root.ui-size * 1.2;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: "Start with a pulsed tone, then change it in Workbench. " +
                                "Nothing plays automatically.";
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        Button {
                            text: root.example-action;
                            max-width: self.preferred-width;
                            triggered => { root.create-example(); }
                        }
                    }
                    if root.topic-key == "library": Button {
                        text: "Browse Library";
                        max-width: self.preferred-width;
                        triggered => { root.browse-library(); }
                    }
                    if root.topic-key == "pitch-and-rhythm" ||
                        root.topic-key == "sound-types": VerticalBox {
                        vertical-stretch: 0;
                        padding: 0px;
                        spacing: 16px;

                        Text {
                            text: root.construction-description;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                            accessible-role: text;
                        }

                        Text {
                            text: root.example-summary;
                            font-weight: 600;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                            accessible-role: text;
                        }

                        for lane in root.traces: VerticalBox {
                            padding: 0px;
                            spacing: 6px;
                            Text {
                                text: lane.label;
                                font-size: root.ui-size;
                                font-weight: 600;
                                wrap: word-wrap;
                                min-width: 0px;
                                vertical-stretch: 0;
                                color: Palette.foreground;
                                accessible-role: text;
                            }

                            LessonPlot {
                                trace: lane.trace;
                                unipolar: lane.unipolar;
                                label: lane.label;
                                ui-size: root.ui-size;
                            }
                        }
                        Button {
                            text: root.example-action;
                            max-width: self.preferred-width;
                            triggered => { root.create-example(); }
                        }
                    }

                    if root.topic-key == "rhythm-bands": VerticalBox {
                        vertical-stretch: 0;
                        padding: 0px;
                        spacing: 14px;
                        HorizontalBox {
                            padding: 0px;
                            spacing: 0px;
                            for item[index] in root.band-items: VerticalBox {
                                padding: 3px;
                                spacing: 6px;
                                min-width: 0px;
                                horizontal-stretch: 1;
                                Text {
                                    text: item.name;
                                    font-size: root.ui-size * 1.12;
                                    font-weight: 600;
                                    color: root.band-colors[index];
                                    wrap: word-wrap;
                                    min-width: 0px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: item.range;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        spectrum := Rectangle {
                            preferred-height: root.ui-size * 10;
                            min-height: self.preferred-height;
                            max-height: self.preferred-height;
                            background: Palette.control-background;
                            border-radius: 6px;
                            accessible-role: image;
                            accessible-label: "Five normalized illustrative sine waves, " +
                                "one second per section, Delta through Gamma.";
                            Rectangle {
                                y: parent.height / 2;
                                width: parent.width;
                                height: 1px;
                                background: Palette.border;
                            }

                            for item[index] in root.band-items: Path {
                                x: parent.width * index / 5;
                                width: parent.width / 5;
                                y: 10px;
                                height: parent.height - 20px;
                                viewbox-width: 1024;
                                viewbox-height: 100;
                                fit: fill;
                                commands: item.trace;
                                stroke: root.band-colors[index];
                                stroke-width: 2.5px;
                            }
                        }

                        Text {
                            text: "Observed EEG/MEG contexts";
                            font-weight: 600;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                        }

                        if !root.compact: HorizontalBox {
                            padding: 0px;
                            spacing: 0px;
                            for item in root.band-items: VerticalBox {
                                padding: 4px;
                                spacing: 6px;
                                min-width: 0px;
                                horizontal-stretch: 1;
                                Text {
                                    text: item.rate;
                                    color: Palette.foreground;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: item.name + ": " + item.context;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                    min-width: 0px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        if root.compact: VerticalBox {
                            padding: 0px;
                            spacing: 10px;
                            for item in root.band-items: Text {
                                text: item.name + " · " + item.rate + " — " + item.context;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                min-width: 0px;
                                vertical-stretch: 0;
                                accessible-role: text;
                            }
                        }
                        Text {
                            text: "Slower rhythms → faster rhythms · One second per section";
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            for item[index] in root.band-items: Button {
                                text: item.name;
                                checked: root.band == index;
                                min-width: 0px;
                                horizontal-stretch: 1;
                                triggered => { root.select-band(index); }
                            }
                        }

                        Text {
                            text: root.band-description;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                            accessible-role: text;
                        }

                        LessonPlot {
                            trace: root.band-items[root.band].trace;
                            ink: root.band-colors[root.band];
                            label: root.band-description;
                            ui-size: root.ui-size;
                        }

                        Text {
                            text: "One second · Normalized amplitude −1 to 1";
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                        }
                    }

                    if root.details != "": Section {
                        title: "Details and sources";
                        ui-size: root.ui-size;
                        Text {
                            text: root.details;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            min-width: 0px;
                            vertical-stretch: 0;
                            accessible-role: text;
                        }

                        if root.topic-key == "rhythm-bands": VerticalBox {
                            padding: 0px;
                            spacing: 8px;
                            for source[index] in root.sources: Button {
                                text: source.label;
                                max-width: self.preferred-width;
                                triggered => { root.open-source(index); }
                            }
                        }
                        Button {
                            text: "Desktop guide";
                            max-width: self.preferred-width;
                            triggered => { root.open-guide(); }
                        }
                    }
                    Rectangle {
                        min-height: 20px;
                    }
                }
            }
        }
    }
}
