import { ViewCaptions as Views } from "view-captions.slint";
import { Palette } from "std-widgets.slint";
import { Terms } from "vocabulary.slint";

// One keyboard stop for the working destinations and Start here.
export component WorkspaceNavigation inherits FocusScope {
    in property <int> current;
    in property <length> text-size:13px;
    private property <string> start-label: "Start here";
    private property <[string]> destinations: [
        Views.library,
        Views.workbench,
        Views.device-check,
        Views.recordings,
        root.start-label,
    ];
    private property <int> last: root.destinations.length - 1;
    callback selected(int);
    function choose(index: int) {
        if index != root.current { root.selected(index); }
    }
    accessible-role: tab-list;
    accessible-label: Terms.caption-workspace-navigation;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    max-width: row.preferred-width;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    max-height: row.preferred-height;
    horizontal-stretch: 1;
    key-pressed(event) => {
        if event.text == Key.Home {
            root.choose(0);
            return accept;
        }
        if event.text == Key.End {
            root.choose(root.last);
            return accept;
        }
        if event.text == Key.LeftArrow { root.choose(max(0,root.current - 1)); return accept; }
        if event.text == Key.RightArrow {
            root.choose(min(root.last, root.current + 1));
            return accept;
        }
        return reject;
    }
    row := HorizontalLayout {
        spacing: 4px;
        // Every tab stays visible in one row; a narrow toolbar wraps labels
        // onto a second line inside the same tab height.
        for label[index] in root.destinations: Rectangle {
            min-width: caption.min-width + 12px;
            preferred-width: caption.preferred-width + 24px;
            // The Button height, so tabs and toolbar actions share one row line.
            min-height: max(32px, 2.5rem);
            max-height: self.min-height;
            border-radius: 5px;
            background: root.current == index ? Palette.accent-background.with-alpha(0.12) :
                Palette.background;
            border-width: root.has-focus && root.current == index ? 2px : 0px;
            border-color: Palette.accent-background;
            accessible-role: tab;
            accessible-label: label;
            accessible-item-index: index;
            accessible-item-selectable: true;
            accessible-item-selected: root.current == index;
            accessible-action-default => { root.focus(); root.choose(index); }
            caption := Text {
                width: parent.width;
                height: parent.height;
                text: label;
                font-weight: root.current == index ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                color: Palette.foreground;
            }

            TouchArea {
                clicked => { root.focus(); root.choose(index); }
            }
        }
    }
}
