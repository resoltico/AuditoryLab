import { ViewCaptions as Views } from "view-captions.slint";
import { Palette } from "std-widgets.slint";
import { Terms } from "vocabulary.slint";

// One keyboard stop for the working destinations and Start here.
export component WorkspaceNavigation inherits FocusScope {
    in property <int> current;
    in property <length> text-size:13px;
    private property <string> start-label: "Start here";
    private property <[string]> destinations: [Views.library, Views.workbench, root.start-label];
    callback selected(int);
    function choose(index: int) {
        root.selected(index);
    }
    accessible-role: tab-list;
    accessible-label: Terms.caption-workspace-navigation;
    min-width: tabs.min-width;
    preferred-width: tabs.preferred-width;
    max-width: tabs.preferred-width;
    min-height: tabs.min-height;
    preferred-height: tabs.preferred-height;
    max-height: tabs.preferred-height;
    horizontal-stretch: 0;
    key-pressed(event) => {
        if event.text == Key.Home {
            root.choose(0);
            return accept;
        }
        if event.text == Key.End {
            root.choose(2);
            return accept;
        }
        if event.text == Key.LeftArrow { root.choose(max(0,root.current - 1)); return accept; }
        if event.text == Key.RightArrow { root.choose(min(2,root.current + 1)); return accept; }
        return reject;
    }
    tabs := HorizontalLayout {
        spacing: 4px;
        for label[index] in root.destinations: Rectangle {
            min-width: caption.preferred-width + 24px;
            min-height: max(root.text-size * 2.5,caption.preferred-height + 12px);
            border-radius: 5px;
            background: root.current == index ? Palette.accent-background.with-alpha(0.12) :
                Palette.background;
            border-width: root.has-focus && root.current == index ? 2px : 0px;
            border-color: Palette.accent-background;
            accessible-role: tab;
            accessible-label: label;
            accessible-item-index: index;
            accessible-item-selectable: true;
            accessible-item-selected: root.current == index;
            accessible-action-default => { root.choose(index); root.focus(); }
            caption := Text {
                width: parent.width;
                height: parent.height;
                text: label;
                font-weight: root.current == index ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            TouchArea {
                clicked => { root.choose(index); root.focus(); }
            }
        }
    }
}
