import { ViewCaptions } from "view-captions.slint";
import { Actions } from "actions.slint";
import { Button } from "button.slint";


import { Terms } from "vocabulary.slint";
import {
    Palette,
    ComboBox,
    VerticalBox,
    HorizontalBox,
    ScrollView,
} from "std-widgets.slint";
import { ComponentRow, ControlOption, MetadataRow, ModelLane } from "models.slint";
import {
    Section,
    ParameterControl,
    MetadataField,
    NotesField,
    ExportRate,
} from "editor.slint";


export component WorkbenchPane inherits Rectangle {
    in property <string> add-reason;
    in property <string> based-on;
    callback based-on-source();
    in property <string> based-on-title;
    in property <bool> can-edit;
    in property <bool> can-export;
    in property <bool> can-export-recipe;
    in property <bool> can-new;
    in property <bool> can-restore-component;
    in property <[string]> carrier-choices;
    callback commit-metadata(string, string);
    callback commit-parameter(string, string);
    in-out property <bool> compact;
    in property <[ComponentRow]> components;
    in property <bool> dirty;
    in property <string> document;
    in property <int> document-reset;
    in property <string> draft-brief;
    in property <string> draft-location-details;
    in property <MetadataRow> duration-field;
    in property <[string]> routing-choices;
    in property <[string]> pulse-width-choices;
    in property <[string]> pulse-shape-choices;
    in-out property <length> editor-scroll-y;
    in-out property <bool> edits-suspended;
    in property <[string]> export-rates;
    in property <string> export-reason;
    callback export-recipe();
    callback export-wav();
    in property <MetadataRow> fade-field;
    in property <string> file-activity;
    in property <string> metadata-error;
    in property <string> model-caption;
    in property <[ModelLane]> model-lanes;
    in property <[string]> modulation-choices;
    callback new-draft();
    in property <string> pair-add-reason;
    in property <string> peak;
    callback rate-changed(int);
    in-out property <int> rate-index;
    callback remove-component(string);
    in property <string> removed-component;
    callback restore-component(string);
    callback restore-metadata(string);
    callback restore-parameter(string);
    in property <string> retained-warning;
    in property <string> save-reason;
    callback save-recipe();
    in property <[ControlOption]> add-choices;
    callback add-component(string, int);
    callback set-carrier(string, int);
    function has-pulse(row: ComponentRow) -> bool {
        return row.source-width >= 0 || row.modulation-width >= 0;
    }
    callback set-routing(string, int);
    callback set-pulse-option(string, int, int);
    callback set-modulation(string, int);
    callback slide(string, float);
    callback stage-metadata(string, string);
    callback stage-parameter(string, string);
    in property <MetadataRow> summary-field;
    in property <int> tab-index;
    in property <MetadataRow> title-field;
    in property <length> ui-size;

    accessible-role: tab-panel;
    accessible-label: ViewCaptions.workbench;
    visible: root.tab-index == 1;

    // Successful document replacement begins at its title, independently of
    // the previous document's scroll position or the control that opened it.
    public function focus-title() {
        editor-scroll.content-y = 0px;
        title-input.focus();
    }

    editor-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        content-y <=> root.editor-scroll-y;
                    // Follow the visible width so long text wraps rather than widening the page.
                    VerticalBox {
            width: editor-scroll.visible-width;
            padding: 16px;
            spacing: 14px;
            // The document's title is the page heading; its state and the
            // document actions sit beside it.
            HorizontalBox {
                padding: 0px;
                vertical-stretch: 0;
                title-input := MetadataField {
                    field: root.title-field;
                    font-size: root.ui-size * 1.4;
                    min-height: max(32px, root.ui-size * 3);
                    horizontal-stretch: 1;
                    reset-key: root.document-reset;
                    enabled: root.can-edit;
                    edits-suspended: root.edits-suspended;
                    accessible-label: ViewCaptions.sound-title;
                    stage-field(owner, value) => { root.stage-metadata(owner, value); }
                    commit-field(owner, value) => { root.commit-metadata(owner, value); }
                    restore-field(owner) => { root.restore-metadata(owner); }
                }

                if root.components.length > 0 || root.dirty: Text {
                    text: ViewCaptions.editor-status;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                Button {
                    text: Actions.save.label;
                    enabled: Actions.save.enabled;
                    primary: true;
                    horizontal-stretch: 0;
                    accessible-description: root.save-reason;
                    triggered => { root.save-recipe(); }
                }

                Button {
                    horizontal-stretch: 0;
                    text: Actions.new-sound.label;
                    enabled: Actions.new-sound.enabled;
                    triggered => {
                        root.new-draft();
                    }
                }
            }

            if root.components.length == 0: VerticalBox {
                padding: 0px;
                padding-top: 12px;
                spacing: 10px;
                vertical-stretch: 0;
                Text {
                    text: "Build a sound";
                    font-size: root.ui-size * 1.3;
                    font-weight: 600;
                    wrap: word-wrap;
                    min-width: 0px;
                }

                Text {
                    text: "Pick a starting component. You can add more and change every " +
                        "setting afterwards. Nothing plays until you press Play.";
                    wrap: word-wrap;
                    min-width: 0px;
                }
            }

            if root.pair-add-reason != "" && root.add-reason == "": Text {
                min-width: 0px;
                text: root.pair-add-reason;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
            if root.add-reason != "": Text {
                min-width: 0px;
                text: root.add-reason;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
            if root.removed-component != "": HorizontalBox {
                padding: 0px;
                vertical-stretch: 0;
                Button {
                    text: Actions.undo-remove.label;
                    horizontal-stretch: 0;
                    enabled: Actions.undo-remove.enabled;
                    accessible-description: root.removed-component + " " + root.add-reason;
                    triggered => { root.restore-component(root.document); }
                }

                Text {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    text: root.removed-component;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            if root.retained-warning != "": Text {
                min-width: 0px;
                text: root.retained-warning;
                color: Palette.foreground;
                font-weight: 700;
                wrap: word-wrap;
                vertical-stretch: 0;
                accessible-label: root.retained-warning;
                accessible-live-region: polite;
            }
            if root.file-activity != "": Text {
                min-width: 0px;
                text: root.file-activity;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
            if root.metadata-error != "": Text {
                min-width: 0px;
                text: root.metadata-error;
                wrap: word-wrap;
                vertical-stretch: 0;
                accessible-live-region: polite;
            }
            if root.save-reason != "": Text {
                min-width: 0px;
                text: root.save-reason;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
            if root.components.length > 0: Text {
                min-width: 0px;
                text: root.draft-brief;
                color: Palette.foreground.with-alpha(0.72);
                wrap: word-wrap;
                vertical-stretch: 0;
            }

            if root.based-on-title != "": Text {
                min-width: 0px;
                text: root.based-on-title;
                wrap: word-wrap;
                font-size: root.ui-size * 0.93;
                vertical-stretch: 0;
            }
            for row in root.components: Rectangle {
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 8px;
                background: Palette.control-background;
                min-height: card.preferred-height;
                vertical-stretch: 0;
                card := VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: row.heading;
                                font-weight: 700;
                                font-size: root.ui-size * 1.08;
                                min-width: 0px;
                                wrap: word-wrap;
                            }

                            Text {
                                min-width: 0px;
                                text: row.context;
                                color: Palette.foreground.with-alpha(0.72);
                                wrap: word-wrap;
                            }
                        }

                        Button {
                            text: Actions.remove-component.label;
                            enabled: Actions.remove-component.enabled;
                            horizontal-stretch: 0;
                            accessible-label: (Actions.remove-component.label + " ") + row.name;
                            triggered => { root.remove-component(row.key); }
                        }
                    }

                    for lane in root.model-lanes: VerticalBox {
                        padding: 0px;
                        spacing: 2px;
                        vertical-stretch: 0;
                        if lane.component == row.id: Text {
                            min-width: 0px;
                            text: lane.label;
                            font-size: root.ui-size * 0.92;
                            color: Palette.foreground.with-alpha(0.72);
                            wrap: word-wrap;
                        }
                        if lane.component == row.id: Rectangle {
                            height: root.ui-size * 3.5;
                            border-radius: 4px;
                            background: Palette.background;
                            accessible-role: image;
                            accessible-label: lane.label + Terms.caption-calculated-pattern;
                            Path {
                                x: 4px;
                                width: parent.width - 8px;
                                height: parent.height;
                                viewbox-width: 1024;
                                viewbox-height: 100;
                                fit: fill;
                                commands: lane.trace;
                                stroke: Palette.accent-background;
                                stroke-width: 2px;
                            }
                        }
                    }

                    for parameter in row.parameters: ParameterControl {
                        parameter: parameter;
                        owner: row.key;
                        context: row.name;
                        compact: root.compact;
                        ui-size: root.ui-size;
                        edit-enabled: root.can-edit;
                        edits-suspended: root.edits-suspended;
                        stage(owner, value) => { root.stage-parameter(owner, value); }
                        commit(owner, value) => { root.commit-parameter(owner, value); }
                        restore(owner) => { root.restore-parameter(owner); }
                        slide(owner, value) => { root.slide(owner, value); }
                    }
                    if row.error != "": Text {
                        min-width: 0px;
                        text: row.error;
                        color: Palette.foreground;
                        accessible-live-region: polite;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }

                    // Labels beside choices sized to their content; the shared
                    // column keeps the choices aligned.
                        GridLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Row {
                            if row.routing-editable: Text {
                                text: ViewCaptions.channel-routing;
                                vertical-alignment: center;
                            }
                            if row.routing-editable: ComboBox {
                                enabled: root.can-edit;
                                model: root.routing-choices;
                                current-index: row.route;
                                accessible-label: row.name + Terms.caption-channel-routing-suffix;
                                selected(value) => { root.set-routing(row.key, self.current-index); }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        Row {
                            if row.carrier >= 0: Text {
                                text: ViewCaptions.carrier;
                                vertical-alignment: center;
                            }
                            if row.carrier >= 0: ComboBox {
                                enabled: root.can-edit;
                                model: root.carrier-choices;
                                current-index: row.carrier;
                                accessible-label: row.name + Terms.caption-carrier-suffix;
                                selected(value) => { root.set-carrier(row.key, self.current-index); }
                            }
                        }

                        Row {
                            if row.modulation >= 0: Text {
                                text: ViewCaptions.modulation;
                                vertical-alignment: center;
                            }
                            if row.modulation >= 0: ComboBox {
                                enabled: root.can-edit;
                                model: root.modulation-choices;
                                current-index: row.modulation;
                                accessible-label: row.name + Terms.caption-modulation-suffix;
                                selected(value) => { root.set-modulation(row.key, self.current-index); }
                            }
                        }

                        Row {
                            if row.source-width >= 0: Text {
                                text: Terms.caption-source-pulse-width;
                                vertical-alignment: center;
                            }
                            if row.source-width >= 0: ComboBox {
                                enabled: root.can-edit;
                                model: root.pulse-width-choices;
                                current-index: row.source-width;
                                accessible-label: row.name + ": " + Terms.caption-source-pulse-width;
                                selected(value) => {
                                    root.set-pulse-option(row.key, 0, self.current-index);
                                }
                            }
                        }

                        Row {
                            if row.source-shape >= 0: Text {
                                text: Terms.caption-source-pulse-shape;
                                vertical-alignment: center;
                            }
                            if row.source-shape >= 0: ComboBox {
                                enabled: root.can-edit;
                                model: root.pulse-shape-choices;
                                current-index: row.source-shape;
                                accessible-label: row.name + ": " + Terms.caption-source-pulse-shape;
                                selected(value) => {
                                    root.set-pulse-option(row.key, 1, self.current-index);
                                }
                            }
                        }

                        Row {
                            if row.modulation-width >= 0: Text {
                                text: Terms.caption-mod-width;
                                vertical-alignment: center;
                            }
                            if row.modulation-width >= 0: ComboBox {
                                enabled: root.can-edit;
                                model: root.pulse-width-choices;
                                current-index: row.modulation-width;
                                accessible-label: row.name + ": " + Terms.caption-mod-width;
                                selected(value) => {
                                    root.set-pulse-option(row.key, 2, self.current-index);
                                }
                            }
                        }

                        Row {
                            if row.modulation-shape >= 0: Text {
                                text: Terms.caption-mod-shape;
                                vertical-alignment: center;
                            }
                            if row.modulation-shape >= 0: ComboBox {
                                enabled: root.can-edit;
                                model: root.pulse-shape-choices;
                                current-index: row.modulation-shape;
                                accessible-label: row.name + ": " + Terms.caption-mod-shape;
                                selected(value) => {
                                    root.set-pulse-option(row.key, 3, self.current-index);
                                }
                            }
                        }

                    }
                }
            }

            if root.components.length > 0: Text {
                min-width: 0px;
                text: root.peak;
                wrap: word-wrap;
                vertical-stretch: 0;
            }

            Section {
                title: root.components.length == 0 ? Terms.caption-choose-component :
                    Terms.caption-add-component;
                ui-size: root.ui-size;
                // Every component kind is offered at once, in a grid of equal buttons.
                add-grid := Rectangle {
                    property <int> columns: root.compact ? 2 : 3;
                    property <length> gap: 8px;
                    property <length> cell-width: (self.width - (self.columns - 1) * self.gap) /
                        self.columns;
                    property <length> cell-height: max(32px, 2.5rem);
                    height: ceil(root.add-choices.length / self.columns) *
                        (self.cell-height + self.gap) - self.gap;
                    for choice[index] in root.add-choices: Button {
                        x: mod(index, add-grid.columns) * (add-grid.cell-width + add-grid.gap);
                        y: floor(index / add-grid.columns) * (add-grid.cell-height + add-grid.gap);
                        width: add-grid.cell-width;
                        text: choice.label;
                        enabled: choice.enabled && Actions.add-component.enabled;
                        accessible-description: root.add-reason;
                        triggered => { root.add-component(root.document, index); }
                    }
                }
            }

            Section {
                title: Terms.action-saved-audio-duration-fades-and-export-rate;
                ui-size: root.ui-size;
                Text {
                    min-width: 0px;
                    text: Terms.caption-saved-audio-help;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }

                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Text {
                        text: root.duration-field.label;
                        vertical-alignment: center;
                    }

                    MetadataField {
                        field: root.duration-field;

                        reset-key: root.document-reset;
                        enabled: root.can-edit;
                        edits-suspended: root.edits-suspended;
                        accessible-label: Terms.action-saved-duration;
                        horizontal-stretch: 0;
                        preferred-width: root.ui-size * 10;
                        stage-field(owner, value) => { root.stage-metadata(owner, value); }
                        commit-field(owner, value) => { root.commit-metadata(owner, value); }
                        restore-field(owner) => { root.restore-metadata(owner); }
                    }

                    Text {
                        text: root.fade-field.label;
                        vertical-alignment: center;
                    }

                    MetadataField {
                        field: root.fade-field;

                        reset-key: root.document-reset;
                        enabled: root.can-edit;
                        edits-suspended: root.edits-suspended;
                        accessible-label: Terms.action-saved-fade;
                        horizontal-stretch: 0;
                        preferred-width: root.ui-size * 10;
                        stage-field(owner, value) => { root.stage-metadata(owner, value); }
                        commit-field(owner, value) => { root.commit-metadata(owner, value); }
                        restore-field(owner) => { root.restore-metadata(owner); }
                    }

                    Rectangle { }
                }

                if root.duration-field.diagnostic != "": Text {
                    min-width: 0px;
                    text: root.duration-field.diagnostic;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
                if root.fade-field.diagnostic != "": Text {
                    min-width: 0px;
                    text: root.fade-field.diagnostic;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    ExportRate {
                        horizontal-stretch: 0;
                        choices: root.export-rates;
                        selected <=> root.rate-index;
                        edit-enabled: true;
                        changed(i) => {
                            root.rate-changed(i);
                        }
                    }

                    Rectangle { }
                }

                HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Button {
                        horizontal-stretch: 0;
                        text: (Actions.export.label + "…");
                        enabled: Actions.export.enabled;
                        accessible-description: root.export-reason;
                        triggered => {
                            root.export-wav();
                        }
                    }

                    Button {
                        horizontal-stretch: 0;
                        text: (Actions.export-recipe.label + "…");
                        enabled: Actions.export-recipe.enabled;
                        triggered => { root.export-recipe(); }
                    }

                    Rectangle { }
                }

                if !root.can-export && root.export-reason != "": Text {
                    min-width: 0px;
                    text: root.export-reason;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
            }

            Section {
                title: ViewCaptions.sound-notes;
                ui-size: root.ui-size;
                if root.based-on != "": Text {
                    min-width: 0px;
                    text: root.based-on;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
                if root.based-on != "": HorizontalBox {
                    padding: 0px;
                    vertical-stretch: 0;
                    Button {
                        horizontal-stretch: 0;
                        text: Terms.action-show-copied-from-snapshot-in-library;
                        triggered => {
                            root.based-on-source();
                        }
                    }

                    Rectangle { }
                }

                NotesField {
                    field: root.summary-field;

                    reset-key: root.document-reset;
                    enabled: root.can-edit;
                    edits-suspended: root.edits-suspended;
                    accessible-label: Terms.caption-custom-recipe-notes;
                    stage-field(owner, value) => { root.stage-metadata(owner, value); }
                    commit-field(owner, value) => { root.commit-metadata(owner, value); }
                    restore-field(owner) => { root.restore-metadata(owner); }
                }
            }

            Section {
                title: Terms.caption-document-location;
                ui-size: root.ui-size;
                Text {
                    text: root.draft-location-details;
                    min-width: 0px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}
