-pub(crate) fn safe_array_from_com_slice(slice: &[IUnknown]) -> *mut SAFEARRAY {
+// UIA typed SAFEARRAY contracts require the supplied provider interface pointer,
+// not its canonical IUnknown identity (which can have a different vtable).
+pub(crate) fn safe_array_from_com_slice<T: Interface>(slice: &[T]) -> *mut SAFEARRAY {
     let sa = unsafe { SafeArrayCreateVector(VT_UNKNOWN, 0, slice.len().try_into().unwrap()) };
     if sa.is_null() {
         panic!("SAFEARRAY allocation failed");
     }
     for (i, item) in slice.iter().enumerate() {
         let i: i32 = i.try_into().unwrap();
-        unsafe { SafeArrayPutElement(&*sa, &i, std::mem::transmute_copy(item)) }.unwrap();
+        // SAFETY: Interface::as_raw supplies this live COM interface pointer.
+        // VT_UNKNOWN stores it directly and AddRefs it; the array owns that
+        // reference independently of the borrowed slice. All COM interfaces
+        // provide the IUnknown prefix used by SAFEARRAY destruction.
+        unsafe { SafeArrayPutElement(&*sa, &i, item.as_raw()) }.unwrap();
     }
     sa
 }
