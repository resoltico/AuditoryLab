<path data-wave="alpha" data-example-hz="${EXAMPLE_HZ}" d="${WAVE_ALPHA}" stroke="${COLOR_ALPHA}" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
<g data-lettering="1" aria-label="1" transform="translate(18.000 79) scale(1.80000)" fill="none" stroke="${SUB}" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round">
<use xlink:href="#g49" x="0"/>
