<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="1400" height="720" viewBox="0 0 1400 720" role="img" aria-labelledby="title desc">
<title id="title">Spectral ribbon: five rhythm bands, ${APPEARANCE} appearance</title>
<desc id="desc">Original vector illustration. Delta, Theta, Alpha, Beta and Gamma with the app frequency intervals and selected overlapping EEG associations. Normalized sine waves are schematic, not EEG recordings or predicted effects of listening. All lettering is original geometric paths; no external images, icons or fonts.</desc>
<defs>
${GLYPH_DEFINITIONS}














































<radialGradient id="field"><stop offset="0" stop-color="${FIELD}"/><stop offset="1" stop-color="${BACKGROUND}"/></radialGradient>
<linearGradient id="spectrum" x1="0" x2="1" y1="0" y2="0">
<stop offset="0.0" stop-color="${COLOR_DELTA}"/>
<stop offset="0.25" stop-color="${COLOR_THETA}"/>
<stop offset="0.5" stop-color="${COLOR_ALPHA}"/>
<stop offset="0.75" stop-color="${COLOR_BETA}"/>
<stop offset="1.0" stop-color="${COLOR_GAMMA}"/>
</linearGradient>
<radialGradient id="halo0"><stop offset="0" stop-color="${COLOR_DELTA}" stop-opacity="${HALO_OPACITY}"/><stop offset="1" stop-color="${COLOR_DELTA}" stop-opacity="0"/></radialGradient>
<radialGradient id="halo1"><stop offset="0" stop-color="${COLOR_THETA}" stop-opacity="${HALO_OPACITY}"/><stop offset="1" stop-color="${COLOR_THETA}" stop-opacity="0"/></radialGradient>
<radialGradient id="halo2"><stop offset="0" stop-color="${COLOR_ALPHA}" stop-opacity="${HALO_OPACITY}"/><stop offset="1" stop-color="${COLOR_ALPHA}" stop-opacity="0"/></radialGradient>
<radialGradient id="halo3"><stop offset="0" stop-color="${COLOR_BETA}" stop-opacity="${HALO_OPACITY}"/><stop offset="1" stop-color="${COLOR_BETA}" stop-opacity="0"/></radialGradient>
<radialGradient id="halo4"><stop offset="0" stop-color="${COLOR_GAMMA}" stop-opacity="${HALO_OPACITY}"/><stop offset="1" stop-color="${COLOR_GAMMA}" stop-opacity="0"/></radialGradient>
<filter id="glow" x="-25%" y="-100%" width="150%" height="300%"><feGaussianBlur stdDeviation="5"/></filter></defs>
<rect x="0" y="0" width="1400" height="720" rx="0" fill="url(#field)" stroke="none"/>
